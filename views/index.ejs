	function setupCloneMenuHandlersMultiClone(safeCloneId, fullCloneId, currentGroupId, cloneEle, originalId) {
		let isOrgClone = fullCloneId.startsWith('orgclone');
		
		// Create Another Clone handler
		let createAnotherItem = document.querySelector(`.svg-menu-item-createanother-${safeCloneId}`);
