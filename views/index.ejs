						.style('fill', 'white')
						.style('font-size', '14px')
						.style('font-weight', 'bold')
						.style('pointer-events', 'none')
						.text('✓');
				}
			});
		});
	}

	function checkConnectionBetweenIds(cloneId1, numericId1, cloneId2, numericId2) {
		if (typeof mapcondata === 'undefined') return false;

		let isMap1 = cloneId1.startsWith('mapclone');
		let isOrg1 = cloneId1.startsWith('orgclone');
		let isPer1 = cloneId1.startsWith('perclone');
		let isMap2 = cloneId2.startsWith('mapclone');
		let isOrg2 = cloneId2.startsWith('orgclone');
		let isPer2 = cloneId2.startsWith('perclone');

		// map ↔ org
		if (isMap1 && isOrg2) {
			if (mapcondata[numericId1] && (mapcondata[numericId1]['mo'] || '').split(',').includes(numericId2)) return true;
			if (mapcondata[numericId2] && (mapcondata[numericId2]['om'] || '').split(',').includes(numericId1)) return true;
		}
		if (isOrg1 && isMap2) {
			if (mapcondata[numericId1] && (mapcondata[numericId1]['om'] || '').split(',').includes(numericId2)) return true;
			if (mapcondata[numericId2] && (mapcondata[numericId2]['mo'] || '').split(',').includes(numericId1)) return true;
		}
		// person ↔ map
		if (isPer1 && isMap2) {
			if (mapcondata[numericId1] && (mapcondata[numericId1]['gm'] || '').split(',').includes(numericId2)) return true;
			if (mapcondata[numericId2] && (mapcondata[numericId2]['mg'] || '').split(',').includes(numericId1)) return true;
		}
		if (isMap1 && isPer2) {
			if (mapcondata[numericId2] && (mapcondata[numericId2]['gm'] || '').split(',').includes(numericId1)) return true;
			if (mapcondata[numericId1] && (mapcondata[numericId1]['mg'] || '').split(',').includes(numericId2)) return true;
		}
		// person ↔ org
		if (isPer1 && isOrg2) {
			if (mapcondata[numericId1] && (mapcondata[numericId1]['go'] || '').split(',').includes(numericId2)) return true;
			if (mapcondata[numericId2] && (mapcondata[numericId2]['og'] || '').split(',').includes(numericId1)) return true;
		}
		if (isOrg1 && isPer2) {
			if (mapcondata[numericId2] && (mapcondata[numericId2]['go'] || '').split(',').includes(numericId1)) return true;
			if (mapcondata[numericId1] && (mapcondata[numericId1]['og'] || '').split(',').includes(numericId2)) return true;
		}

		return false;
	}

	function cycleMatrixViewOrder(groupId) {
	if (!mapDragState.matrixViewOrder) {
		mapDragState.matrixViewOrder = new Map();
	}

	let layerState = mapDragState.matrixLayerState?.get(groupId);
	if (!layerState) return;

	let currentOrder = mapDragState.matrixViewOrder.get(groupId) || [...layerState.viewTypes];

	// Rotate: [A, B, C] → [B, C, A]
	let newOrder = [currentOrder[1], currentOrder[2], currentOrder[0]];
	mapDragState.matrixViewOrder.set(groupId, newOrder);

	let currentMode = mapDragState.matrixDisplayMode?.get(groupId) || 'tabbed';

	let canvas = d3.select('#line-canvas');
	canvas.selectAll(`.matrix-cell-${groupId}`).remove();
	canvas.selectAll(`.matrix-label-${groupId}`).remove();
	canvas.selectAll(`.matrix-grid-${groupId}`).remove();
	canvas.selectAll(`.matrix-layer-${groupId}`).remove();
	canvas.selectAll(`.matrix-toggle-${groupId}`).remove();
	canvas.selectAll(`.matrix-connector-${groupId}`).remove();
	canvas.selectAll(`.matrix-anchor-${groupId}`).remove();
	canvas.selectAll(`.matrix-order-btn-${groupId}`).remove();


	// Restore opacity before redrawing
	layerState.allViewElements.forEach((elements) => {
		elements.forEach(el => d3.select(el).style('opacity', '1'));
	});

	if (currentMode === 'all') {
		drawCombinedMatrixView(groupId);
	} else {
		drawStackedMatrixLayers(groupId, layerState.activeLayerIndex || 0);
	}

	setTimeout(() => {
		drawGroupBackground(groupId);
		drawProximityBoundary(groupId, false);
		if (typeof drawGroupNameLabel === 'function') {
			drawGroupNameLabel(groupId);
		}
	}, 450);
}

