	function handleMatrixOrderButtonClick(groupId, clickedIdx) {
		if (!mapDragState.matrixOrderSelection) {
			mapDragState.matrixOrderSelection = new Map();
		}

		let selection = mapDragState.matrixOrderSelection.get(groupId);

		if (selection === undefined || selection === null) {
			// First click — select this position
			mapDragState.matrixOrderSelection.set(groupId, clickedIdx);
			highlightMatrixOrderButton(groupId, clickedIdx);
		} else if (selection === clickedIdx) {
			// Clicked same button — deselect
			mapDragState.matrixOrderSelection.set(groupId, null);
			drawMatrixOrderButtons(groupId); // redraw without highlight
		} else {
			// Second click — swap the two positions
			let viewOrder = mapDragState.matrixViewOrder?.get(groupId);
			if (!viewOrder) return;

			let temp = viewOrder[selection];
			viewOrder[selection] = viewOrder[clickedIdx];
			viewOrder[clickedIdx] = temp;
			mapDragState.matrixViewOrder.set(groupId, viewOrder);
			mapDragState.matrixOrderSelection.set(groupId, null);

			// Redraw the current mode
			let currentMode = mapDragState.matrixDisplayMode?.get(groupId) || 'tabbed';
			let layerState = mapDragState.matrixLayerState?.get(groupId);
			if (layerState) {
				layerState.allViewElements.forEach((elements) => {
					elements.forEach(el => d3.select(el).style('opacity', '1'));
				});
			}

			let canvas = d3.select('#line-canvas');
			canvas.selectAll(`.matrix-cell-${groupId}`).remove();
			canvas.selectAll(`.matrix-label-${groupId}`).remove();
			canvas.selectAll(`.matrix-grid-${groupId}`).remove();
			canvas.selectAll(`.matrix-layer-${groupId}`).remove();
			canvas.selectAll(`.matrix-toggle-${groupId}`).remove();
			canvas.selectAll(`.matrix-connector-${groupId}`).remove();
			canvas.selectAll(`.matrix-anchor-${groupId}`).remove();
			canvas.selectAll(`.matrix-order-btn-${groupId}`).remove();

			if (currentMode === 'all') {
				drawCombinedMatrixView(groupId);
			} else {
				drawStackedMatrixLayers(groupId, layerState?.activeLayerIndex || 0);
			}

			setTimeout(() => {
				drawGroupBackground(groupId);
				drawProximityBoundary(groupId, false);
				if (typeof drawGroupNameLabel === 'function') drawGroupNameLabel(groupId);
			}, 450);
		}
	}

	function highlightMatrixOrderButton(groupId, idx) {
		let canvas = d3.select('#line-canvas');
		// Find the rect buttons and highlight the selected one
		let btnRects = canvas.selectAll(`.matrix-order-btn-${groupId}`).filter('rect');
		let counter = 0;
		btnRects.each(function() {
			let el = d3.select(this);
			if (counter === idx) {
				el.style('stroke-width', '3px')
				  .style('filter', 'drop-shadow(0 0 4px rgba(52, 73, 94, 0.4))');
			}
			counter++;
		});
	}

	function switchMatrixLayer(groupId, newActiveIndex) {
		let layerState = mapDragState.matrixLayerState?.get(groupId);
		if (!layerState) return;

		// Restore opacity on all elements before switching
		layerState.allViewElements.forEach((elements, vt) => {
			elements.forEach(el => d3.select(el).style('opacity', '1'));
		});

		drawStackedMatrixLayers(groupId, newActiveIndex);

		// Update boundary and group visuals
		setTimeout(() => {
			drawGroupBackground(groupId);
			drawProximityBoundary(groupId, false);
			drawGroupNameLabel(groupId);
		}, 450);
	}

