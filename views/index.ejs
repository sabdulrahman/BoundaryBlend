	function updateBoundaryPosition(groupId) {
		let members = mapDragState.groupMembers.get(groupId);
		if (!members || members.size === 0) return;
		
		let arrangementType = mapDragState.groupArrangements?.get(groupId) || 'preserve';
		let useRectangle = (arrangementType === 'matrix' || arrangementType === 'bridge');
		
		let points = [];
		let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
		
		members.forEach(cloneId => {
			let element = document.querySelector(`[clone-id="${cloneId}"]`);
			if (element) {
				let cx, cy;
				if (element.tagName === 'rect') {
					cx = parseFloat(d3.select(element).attr('x')) + 8;
					cy = parseFloat(d3.select(element).attr('y')) + 8;
				} else {
					cx = parseFloat(d3.select(element).attr('cx'));
					cy = parseFloat(d3.select(element).attr('cy'));
				}
				points.push([cx, cy]);
				minX = Math.min(minX, cx);
				minY = Math.min(minY, cy);
				maxX = Math.max(maxX, cx);
				maxY = Math.max(maxY, cy);
			}
		});
		
		if (points.length === 0) return;
		
		let boundary = d3.select(`.proximity-boundary[data-group-id="${groupId}"]`);
		
		if (points.length === 1) {
			// Update circle position
			boundary
				.attr('cx', points[0][0])
				.attr('cy', points[0][1]);
		} else if (useRectangle) {
			// Update rectangle position
			let padding = mapDragState.proximityRadius;
			boundary
				.attr('x', minX - padding)
				.attr('y', minY - padding)
				.attr('width', (maxX - minX) + padding * 2)
				.attr('height', (maxY - minY) + padding * 2);
		} else {
			// Existing hull/ellipse logic
			let spanX = maxX - minX;
			let spanY = maxY - minY;
			let minThickness = mapDragState.proximityRadius * 0.5;
			let isTooFlat = (spanX < minThickness || spanY < minThickness);
			
			let hull = d3.polygonHull(points);
			
			if (!hull || isTooFlat) {
				let centerX = (minX + maxX) / 2;
				let centerY = (minY + maxY) / 2;
				let padding = mapDragState.proximityRadius;
				
				let minSpan = padding * 0.8;
				spanX = Math.max(spanX, minSpan);
				spanY = Math.max(spanY, minSpan);
				
				let rx = (spanX / 2) + padding;
				let ry = (spanY / 2) + padding;
				
				boundary
					.attr('cx', centerX)
					.attr('cy', centerY)
					.attr('rx', rx)
					.attr('ry', ry);
			} else {
				let center = [0, 0];
				hull.forEach(point => {
					center[0] += point[0];
					center[1] += point[1];
				});
				center[0] /= hull.length;
				center[1] /= hull.length;
				
				let expandedHull = hull.map(point => {
					let dx = point[0] - center[0];
					let dy = point[1] - center[1];
					let distance = Math.sqrt(dx * dx + dy * dy);
					let newDistance = distance + mapDragState.proximityRadius;
					let scale = newDistance / distance;
					return [
						center[0] + dx * scale,
						center[1] + dy * scale
					];
				});
				
				boundary.attr('d', 'M' + expandedHull.join('L') + 'Z');
			}
		}
		
		// Also update group background
		updateGroupBackgroundPosition(groupId);
	}

	function updateGroupBackgroundPosition(groupId) {
		let members = mapDragState.groupMembers.get(groupId);
		if (!members || members.size < 2) return;
		
		let points = [];
		members.forEach(cloneId => {
			let element = document.querySelector(`[clone-id="${cloneId}"]`);
			if (element) {
				let cx, cy;
				if (element.tagName === 'rect') {
					cx = parseFloat(d3.select(element).attr('x')) + 8;
					cy = parseFloat(d3.select(element).attr('y')) + 8;
				} else {
					cx = parseFloat(d3.select(element).attr('cx'));
					cy = parseFloat(d3.select(element).attr('cy'));
				}
				points.push([cx, cy]);
			}
		});
		
		if (points.length > 2) {
			let hull = d3.polygonHull(points);
			if (hull) {
				let center = [0, 0];
				hull.forEach(point => {
					center[0] += point[0];
					center[1] += point[1];
				});
				center[0] /= hull.length;
				center[1] /= hull.length;
				
				let expandedHull = hull.map(point => {
					let dx = point[0] - center[0];
					let dy = point[1] - center[1];
					let distance = Math.sqrt(dx * dx + dy * dy);
					let scale = (distance + 15) / distance;
					return [
						center[0] + dx * scale,
						center[1] + dy * scale
					];
				});
				
				d3.select(`.group-background[data-group-id="${groupId}"]`)
					.attr('d', 'M' + expandedHull.join('L') + 'Z');
			}
		}
	}

	function refreshAllGroupVisuals() {
		// Redraw all group backgrounds and boundaries
		mapDragState.groupMembers.forEach((members, groupId) => {
			if (members && members.size > 0) {
				drawGroupBackground(groupId);
				drawProximityBoundary(groupId, false);
			}
		});
	}

	function updateElasticBand(element, x, y) {
		let cloneId = element.id.replace('mappermanentclone', '');
		let origEle = document.getElementById('map' + cloneId);
		
		if (origEle) {
			let leftOffset = document.getElementById('leftplace').offsetWidth;
			let origRect = origEle.getBoundingClientRect();
			let origX = origRect.x - leftOffset + (origRect.width / 2);
			let origY = origRect.y + (origRect.height / 2);
			
			d3.select('#elasticpermanent' + cloneId)
				.attr('x1', origX)
				.attr('y1', origY)
				.attr('x2', x)
				.attr('y2', y);
		}
	}

	function drawGroupBackground(groupId) {
		// Remove existing background for this group
		d3.selectAll(`.group-background[data-group-id="${groupId}"]`).remove();
		
		let members = mapDragState.groupMembers.get(groupId);
		if (!members || members.size < 2) return; // Only draw background for 2+ elements
		
		let points = [];
		members.forEach(cloneId => {
			let element = document.querySelector(`[clone-id="${cloneId}"]`);
			if (element) {
				let cx, cy;
				if (element.tagName === 'rect') {
					cx = parseFloat(d3.select(element).attr('x')) + 8;
					cy = parseFloat(d3.select(element).attr('y')) + 8;
				} else {
					cx = parseFloat(d3.select(element).attr('cx'));
					cy = parseFloat(d3.select(element).attr('cy'));
				}
				points.push([cx, cy]);
			}
		});
		
		if (points.length > 2) {
			// Create convex hull
			let hull = d3.polygonHull(points);
			if (hull) {
				// Expand hull for padding
				let center = [0, 0];
				hull.forEach(point => {
					center[0] += point[0];
					center[1] += point[1];
				});
				center[0] /= hull.length;
				center[1] /= hull.length;
				
				let expandedHull = hull.map(point => {
					let dx = point[0] - center[0];
					let dy = point[1] - center[1];
					let distance = Math.sqrt(dx * dx + dy * dy);
					let scale = (distance + 15) / distance;
					return [
						center[0] + dx * scale,
						center[1] + dy * scale
					];
				});
				
				d3.select('#line-canvas')
					.insert('path', ':first-child')
					.attr('d', 'M' + expandedHull.join('L') + 'Z')
					.attr('class', 'group-background')
					.attr('data-group-id', groupId)
					.style('fill', 'rgba(100, 149, 237, 0.08)')
					.style('stroke', 'rgba(100, 149, 237, 0.3)')
					.style('stroke-width', '1.5px')
					.style('stroke-dasharray', '5,3')
					.lower(); // ADDED: Ensure it's at the back
			}
		}
	}

	function updateGroupVisual(groupId) {
		console.log('updateGroupVisual called for:', groupId);
		
		let members = mapDragState.groupMembers.get(groupId);
		console.log('Members:', members ? members.size : 'none');
		
		// Clean up empty groups
		if (!members || members.size === 0) {
			console.log('Removing visuals for empty group:', groupId);
			d3.selectAll(`.group-background[data-group-id="${groupId}"]`).remove();
			d3.selectAll(`.proximity-boundary[data-group-id="${groupId}"]`).remove();
			return; // ADDED: Return early for empty groups
		}
		
		// First draw background (behind everything)
		drawGroupBackground(groupId);
		
		// Then draw proximity boundary (in front of background)
		drawProximityBoundary(groupId, false);
	}

	function highlightGroup(groupId, highlight = true) {
		let members = mapDragState.groupMembers.get(groupId);
		if (!members) return;
		
		members.forEach(cloneId => {
			let element = document.querySelector(`[clone-id="${cloneId}"]`);
			if (element) {
				if (highlight) {
					d3.select(element)
						.transition()
						.duration(200)
						.style('stroke', '#ffa500')
						.style('stroke-width', '3px');
				} else {
					d3.select(element)
						.transition()
						.duration(200)
						.style('stroke', '#4169e1')
						.style('stroke-width', '2px');
				}
			}
		});
	}

