	function increase_brightness(hex, percent){													//function to handle color of element based on number of connections connected to it.

		hex = hex.replace(/^\s*#|\s*$/g, '');

		if(hex.length == 3){
			hex = hex.replace(/(.)/g, '$1$1');
		}

		var r = parseInt(hex.substr(0, 2), 16),
			g = parseInt(hex.substr(2, 2), 16),											//rgb values to control the color
			b = parseInt(hex.substr(4, 2), 16);

		return '#' +
		   ((0|(1<<8) + r + (256 - r) * percent / 100).toString(16)).substr(1) +
		   ((0|(1<<8) + g + (256 - g) * percent / 100).toString(16)).substr(1) +
		   ((0|(1<<8) + b + (256 ) * percent / 100).toString(16)).substr(1);
	}

