	function drawMatrixToggleControl(groupId, activeMode) {
		let canvas = d3.select('#line-canvas');
		canvas.selectAll(`.matrix-toggle-${groupId}`).remove();

		let grids = canvas.selectAll(`.matrix-grid-${groupId}`);
		if (grids.empty()) return;

		let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
		grids.each(function() {
			let el = d3.select(this);
			let x = parseFloat(el.attr('x')) || 0;
			let y = parseFloat(el.attr('y')) || 0;
			let w = parseFloat(el.attr('width')) || 0;
			let h = parseFloat(el.attr('height')) || 0;
			if (x < minX) minX = x;
			if (y < minY) minY = y;
			if (x + w > maxX) maxX = x + w;
			if (y + h > maxY) maxY = y + h;
		});

		// Also check layer cards and tabs (they can extend above grids in tabbed mode)
		canvas.selectAll(`.matrix-layer-${groupId}`).each(function() {
			let el = d3.select(this);
			let x = parseFloat(el.attr('x')) || 0;
			let y = parseFloat(el.attr('y')) || 0;
			let w = parseFloat(el.attr('width')) || 0;
			let h = parseFloat(el.attr('height')) || 0;
			if (x < minX) minX = x;
			if (y < minY) minY = y;
			if (x + w > maxX) maxX = x + w;
			if (y + h > maxY) maxY = y + h;
		});

		// Also check labels (tabs in tabbed mode have negative Y)
		canvas.selectAll(`.matrix-label-${groupId}`).each(function() {
			let el = d3.select(this);
			let y = parseFloat(el.attr('y')) || 0;
			let x = parseFloat(el.attr('x')) || 0;
			let w = parseFloat(el.attr('width')) || 0;
			let h = parseFloat(el.attr('height')) || 0;
			if (this.tagName === 'rect' && w > 0) {
				if (x < minX) minX = x;
				if (y < minY) minY = y;
				if (x + w > maxX) maxX = x + w;
				if (y + h > maxY) maxY = y + h;
			} else if (this.tagName === 'text') {
				if (y < minY) minY = y - 10;
			}
		});

		let toggleW = 126;
		let toggleH = 22;
		let toggleX = maxX - toggleW - 4;
		// Extra upward offset in tabbed mode so it clears the stacked tabs
		let extraUp = (activeMode === 'all') ? 6 : 0;
		let toggleY = minY - toggleH - 6 - extraUp;
		let halfW = toggleW / 2;

		// Background pill
		canvas.append('rect')
			.attr('class', `matrix-toggle matrix-toggle-${groupId} matrix-label matrix-label-${groupId}`)
			.attr('data-group-id', groupId)
			.attr('data-orig-x', toggleX)
			.attr('data-orig-y', toggleY)
			.attr('x', toggleX)
			.attr('y', toggleY)
			.attr('width', toggleW)
			.attr('height', toggleH)
			.attr('rx', 11)
			.style('fill', 'rgba(52, 73, 94, 0.08)')
			.style('stroke', 'rgba(52, 73, 94, 0.18)')
			.style('stroke-width', '1px')
			.style('pointer-events', 'none');

		// Active indicator
		let activeX = activeMode === 'tabbed' ? toggleX + 1 : toggleX + halfW;
		canvas.append('rect')
			.attr('class', `matrix-toggle matrix-toggle-${groupId} matrix-label matrix-label-${groupId}`)
			.attr('data-group-id', groupId)
			.attr('data-orig-x', activeX)
			.attr('data-orig-y', toggleY + 1)
			.attr('x', activeX)
			.attr('y', toggleY + 1)
			.attr('width', halfW - 1)
			.attr('height', toggleH - 2)
			.attr('rx', 10)
			.style('fill', 'rgba(52, 73, 94, 0.82)')
			.style('pointer-events', 'none');

		// "Tabbed" label
		let labelY = toggleY + toggleH / 2 + 3.5;
		canvas.append('text')
			.attr('class', `matrix-toggle matrix-toggle-${groupId} matrix-label matrix-label-${groupId}`)
			.attr('data-group-id', groupId)
			.attr('data-orig-x', toggleX + halfW / 2)
			.attr('data-orig-y', labelY)
			.attr('x', toggleX + halfW / 2)
			.attr('y', labelY)
			.attr('text-anchor', 'middle')
			.style('fill', activeMode === 'tabbed' ? 'white' : 'rgba(52, 73, 94, 0.55)')
			.style('font-size', '9px')
			.style('font-weight', activeMode === 'tabbed' ? 'bold' : 'normal')
			.style('letter-spacing', '0.5px')
			.style('cursor', 'pointer')
			.style('pointer-events', 'all')
			.text('▦ Tabbed')
			.on('click', function() {
				if (typeof d3.event !== 'undefined' && d3.event) d3.event.stopPropagation();
				else if (typeof event !== 'undefined') event.stopPropagation();
				toggleMatrixDisplayMode(groupId, 'tabbed');
			});

		// "Combined" label
		canvas.append('text')
			.attr('class', `matrix-toggle matrix-toggle-${groupId} matrix-label matrix-label-${groupId}`)
			.attr('data-group-id', groupId)
			.attr('data-orig-x', toggleX + halfW + halfW / 2)
			.attr('data-orig-y', labelY)
			.attr('x', toggleX + halfW + halfW / 2)
			.attr('y', labelY)
			.attr('text-anchor', 'middle')
			.style('fill', activeMode === 'all' ? 'white' : 'rgba(52, 73, 94, 0.55)')
			.style('font-size', '9px')
			.style('font-weight', activeMode === 'all' ? 'bold' : 'normal')
			.style('letter-spacing', '0.5px')
			.style('cursor', 'pointer')
			.style('pointer-events', 'all')
			.text('▤ Combined')
			.on('click', function() {
				if (typeof d3.event !== 'undefined' && d3.event) d3.event.stopPropagation();
				else if (typeof event !== 'undefined') event.stopPropagation();
				toggleMatrixDisplayMode(groupId, 'all');
			});
	}

