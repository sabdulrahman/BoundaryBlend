					d3.select(bar)
						.style("fill", "#6495ed")
						.style("stroke", "black")
						.style("stroke-width", "0.3px")
						.style("filter", "drop-shadow(0 0 4px orange) drop-shadow(0 0 8px orange)");
				} else {
					d3.select(bar)
						.style("fill", "#6495ed")
						.style("stroke", "black")
