	const fcaEntityIndex = {};            // { "abdul ramazi": [1, 9, 13, 17], … }
	const fcaEntityTypeIndex = {};        // { "abdul ramazi": "person", … }
	 
	(function buildIndex() {
		FCA_CLUSTERS.forEach(group => {
			const addEntities = (list, type) => {
				list.forEach(name => {
					const key = name.trim().toLowerCase();
					if (!fcaEntityIndex[key]) fcaEntityIndex[key] = [];
					if (!fcaEntityIndex[key].includes(group.id)) {
						fcaEntityIndex[key].push(group.id);
					}
					fcaEntityTypeIndex[key] = type;
				});
			};
			addEntities(group.persons,       "person");
			addEntities(group.locations,     "location");
			addEntities(group.organizations, "organization");
		});
	})();

	function markClusterMembers() {
		const allKnownNames = Object.keys(fcaEntityIndex);
		document.querySelectorAll('[data-name], [orgname], [label]').forEach(el => {
			const name = (
				el.getAttribute('data-name') ||
				el.getAttribute('orgname') ||
				el.getAttribute('label') || ''
			).trim().toLowerCase();
			if (allKnownNames.includes(name)) {
				el.classList.add('fca-cluster-member');
				el.setAttribute('title', `In FCA cluster — drag to explore`);
			}
		});
	}

	function getGroupsForEntity(entityName) {
		if (!entityName) return [];
		return fcaEntityIndex[entityName.trim().toLowerCase()] || [];
	}

	function getSuggestionsFromGroups(groupIds, excludeNames) {
		const excluded = new Set((excludeNames || []).map(n => n.trim().toLowerCase()));
		const seen = new Set();
		let suggestions = [];
	 
		// Sort groups: non-noise first, then by F1 descending
		const sortedGroupIds = [...new Set(groupIds)].sort((a, b) => {
			const ga = FCA_CLUSTERS.find(g => g.id === a);
			const gb = FCA_CLUSTERS.find(g => g.id === b);
			if (ga.action === "Noise" && gb.action !== "Noise") return 1;
			if (ga.action !== "Noise" && gb.action === "Noise") return -1;
			return (gb.f1 || 0) - (ga.f1 || 0);
		});
	 
		sortedGroupIds.forEach(gid => {
			const group = FCA_CLUSTERS.find(g => g.id === gid);
			if (!group) return;
	 
			const addFromList = (list, type) => {
				list.forEach(name => {
					const key = name.trim().toLowerCase();
					if (!excluded.has(key) && !seen.has(key)) {
						seen.add(key);
						suggestions.push({
							name:      name,
							type:      type,
							groupId:   group.id,
							groupName: group.name,
							action:    group.action,
							f1:        group.f1
						});
					}
				});
			};
			addFromList(group.persons,       "person");
			addFromList(group.locations,     "location");
			addFromList(group.organizations, "organization");
		});
	 
		return suggestions;
	}

	function getFCASuggestions(entityName, alreadyOnBoard) {
		const directGroups = getGroupsForEntity(entityName);
		if (directGroups.length === 0) return { groups: [], suggestions: [] };
	 
		// Also include "related" groups (investigative paths)
		const allGroupIds = new Set(directGroups);
		directGroups.forEach(gid => {
			const group = FCA_CLUSTERS.find(g => g.id === gid);
			if (group && group.related) {
				group.related.forEach(rid => allGroupIds.add(rid));
			}
		});
	 
		const excludeNames = [entityName, ...(alreadyOnBoard || [])];
		const suggestions = getSuggestionsFromGroups([...allGroupIds], excludeNames);
	 
		// Tag direct vs. related
		suggestions.forEach(s => {
			s.isDirect = directGroups.includes(s.groupId);
		});
	 
		const groups = [...allGroupIds].map(gid => FCA_CLUSTERS.find(g => g.id === gid));
	 
		return { groups, suggestions };
	}

