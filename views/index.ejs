		drawBridgeConnectionsFromData(groupId);
	}


	function updateTimelineVisualsOnDrag(groupId, centerX, centerY) {
		let canvas = d3.select('#line-canvas');
		
		if (!mapDragState.timelineData) return;
		let timelineData = mapDragState.timelineData.get(groupId);
		if (!timelineData) return;
		
		let deltaX = centerX - timelineData.originalCenter.x;
		let deltaY = centerY - timelineData.originalCenter.y;
		
		// Update axis line
		canvas.selectAll(`line.timeline-axis-${groupId}`).each(function() {
			let line = d3.select(this);
			let origX1 = parseFloat(line.attr('data-orig-x1'));
			let origY1 = parseFloat(line.attr('data-orig-y1'));
			let origX2 = parseFloat(line.attr('data-orig-x2'));
			let origY2 = parseFloat(line.attr('data-orig-y2'));
			
			if (!isNaN(origX1)) {
				line.attr('x1', origX1 + deltaX)
					.attr('y1', origY1 + deltaY)
					.attr('x2', origX2 + deltaX)
					.attr('y2', origY2 + deltaY);
			}
		});
		
		// Update arrow
		canvas.selectAll(`polygon.timeline-axis-${groupId}`).each(function() {
			let polygon = d3.select(this);
			let origPoints = polygon.attr('data-orig-points');
			if (origPoints) {
				let newPoints = origPoints.split(' ').map(p => {
					let [x, y] = p.split(',').map(Number);
					return `${x + deltaX},${y + deltaY}`;
				}).join(' ');
				polygon.attr('points', newPoints);
			}
		});
		
		// Update sequence numbers
		canvas.selectAll(`.timeline-number.timeline-axis-${groupId}`).each(function() {
			let text = d3.select(this);
			let origX = parseFloat(text.attr('data-orig-x'));
			let origY = parseFloat(text.attr('data-orig-y'));
			
			if (!isNaN(origX)) {
				text.attr('x', origX + deltaX)
					.attr('y', origY + deltaY);
			}
