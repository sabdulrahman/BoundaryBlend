	function updateBridgeVisualsForGroup(groupId) {
		if (!mapDragState.bridgeLabelData || !mapDragState.bridgeLabelData.has(groupId)) {
			return;
		}

		let members = mapDragState.groupMembers.get(groupId);
		if (!members || members.size === 0) return;

		// Calculate current centroid of the group
		let centerX = 0, centerY = 0, count = 0;
		members.forEach(cloneId => {
			let element = document.querySelector(`[clone-id="${cloneId}"]`);
			if (element) {
				let cx, cy;
				if (element.tagName === 'rect') {
					cx = parseFloat(d3.select(element).attr('x')) + 8;
					cy = parseFloat(d3.select(element).attr('y')) + 8;
				} else {
					cx = parseFloat(d3.select(element).attr('cx'));
					cy = parseFloat(d3.select(element).attr('cy'));
				}
				centerX += cx;
				centerY += cy;
				count++;
			}
		});

		if (count === 0) return;

		centerX /= count;
		centerY /= count;

		let labelData = mapDragState.bridgeLabelData.get(groupId);

		// Update label positions
		d3.selectAll(`.bridge-label-map-${groupId}`)
			.attr('x', centerX + labelData.mapLabelOffset.x)
			.attr('y', centerY + labelData.mapLabelOffset.y);

		d3.selectAll(`.bridge-label-org-${groupId}`)
			.attr('x', centerX + labelData.orgLabelOffset.x)
			.attr('y', centerY + labelData.orgLabelOffset.y);

		// Update background position
		let bgWidth = labelData.backgroundOffset.width;
		let bgHeight = labelData.backgroundOffset.height;

		d3.selectAll(`.bridge-background-${groupId}`)
			.attr('x', centerX - bgWidth / 2)
			.attr('y', centerY - bgHeight / 2);

		// Redraw all connections using the unified function
		drawBridgeConnectionsFromData(groupId);
	}

	function updateBridgeConnectionsForGroup(groupId, centerX, centerY) {
		drawBridgeConnectionsFromData(groupId);
	}

	function updateBridgeVisualsOnDrag(groupId, centerX, centerY) {
		let labelData = mapDragState.bridgeLabelData?.get(groupId);
		if (!labelData) return;

		let canvas = d3.select('#line-canvas');

		// Update ALL bridge labels (map, org, person, etc.) using stored offset from center
		canvas.selectAll(`.bridge-label.bridge-label-${groupId}`).each(function() {
			let label = d3.select(this);
			let origX = parseFloat(label.attr('data-orig-x'));
			let origY = parseFloat(label.attr('data-orig-y'));
