	function arrangeGroupVisually(groupId, arrangement = 'preserve') {
		// IMPORTANT: Clean up previous arrangement visuals first
		cleanupArrangementVisuals(groupId);
		
		let members = mapDragState.groupMembers.get(groupId);
		if (!members || members.size === 0) return;
		
		// Calculate center point
		let centerX = 0, centerY = 0, count = 0;
		members.forEach(cloneId => {
			let element = document.querySelector(`[clone-id="${cloneId}"]`);
			if (element) {
				if (element.tagName === 'rect') {
					centerX += parseFloat(d3.select(element).attr('x')) + 8;
					centerY += parseFloat(d3.select(element).attr('y')) + 8;
				} else {
					centerX += parseFloat(d3.select(element).attr('cx'));
					centerY += parseFloat(d3.select(element).attr('cy'));
				}
				count++;
			}
		});
		
		if (count === 0) return;
		centerX /= count;
		centerY /= count;
		
		// Constrain to canvas
		let canvas = document.getElementById('line-canvas');
		let canvasRect = canvas.getBoundingClientRect();
		let margin = 80;
		centerX = Math.max(margin, Math.min(canvasRect.width - margin, centerX));
		centerY = Math.max(margin, Math.min(canvasRect.height - margin, centerY));
		
		// Group by view type
		let viewGroups = new Map();
		members.forEach(cloneId => {
			let element = document.querySelector(`[clone-id="${cloneId}"]`);
			if (element) {
				let sourceView = element.getAttribute('source-view') || 'map';
				if (!viewGroups.has(sourceView)) {
					viewGroups.set(sourceView, []);
				}
				viewGroups.get(sourceView).push(element);
			}
		});
		
		// Apply arrangement
		switch(arrangement) {
			case 'preserve':
				arrangePreserve(viewGroups, centerX, centerY);
				break;
			case 'radial':
				arrangeRadial(viewGroups, centerX, centerY);
				break;
			case 'column':
				arrangeColumn(viewGroups, centerX, centerY);
				break;
			case 'row':
				arrangeRow(viewGroups, centerX, centerY);
				break;
			case 'grid':
				arrangeGrid(viewGroups, centerX, centerY);
				break;
			case 'circle':
				arrangeCircle(viewGroups, centerX, centerY);
				break;
			case 'bridge':
				arrangeSmartBridge(viewGroups, centerX, centerY, groupId);  // Changed from arrangeBridge
				break;
			case 'force':
				arrangeForceDirected(viewGroups, centerX, centerY, groupId);
				break;
			case 'venn':
				arrangeVenn(viewGroups, centerX, centerY, groupId);
				break;
			case 'cluster':
				arrangeCluster(viewGroups, centerX, centerY, groupId);
				break;
			case 'matrix':
				arrangeMatrix(viewGroups, centerX, centerY, groupId);
				break;
			case 'timeline':
				arrangeTimeline(viewGroups, centerX, centerY, groupId);
				break;
			case 'hierarchy':
				arrangeHierarchy(viewGroups, centerX, centerY, groupId);
				break;
			case 'sunburst':
				arrangeSunburst(viewGroups, centerX, centerY, groupId);
				break;
		}
		
		// Redraw group visuals
		setTimeout(() => {
			drawGroupBackground(groupId);
			drawProximityBoundary(groupId, false);
		}, 350);
	}

	function arrangeSmartBridge(viewGroups, centerX, centerY, groupId) {
		let viewTypesList = Array.from(viewGroups.keys());

		// Use stored order if available
		let viewOrder;
		if (mapDragState.bipartiteViewOrder && mapDragState.bipartiteViewOrder.has(groupId)) {
			viewOrder = mapDragState.bipartiteViewOrder.get(groupId).filter(vt => viewGroups.has(vt));
			// Add any new types not in stored order
			viewTypesList.forEach(vt => {
				if (!viewOrder.includes(vt)) viewOrder.push(vt);
			});
		} else {
			viewOrder = viewTypesList;
		}

		if (!mapDragState.bipartiteViewOrder) {
			mapDragState.bipartiteViewOrder = new Map();
		}
		mapDragState.bipartiteViewOrder.set(groupId, [...viewOrder]);

		arrangeSmartBridgeWithOrder(viewGroups, centerX, centerY, groupId, viewOrder);
	}

	function getPermutations(arr) {
		if (arr.length <= 1) return [arr];
		let result = [];
		for (let i = 0; i < arr.length; i++) {
			let rest = arr.slice(0, i).concat(arr.slice(i + 1));
			let perms = getPermutations(rest);
			perms.forEach(p => result.push([arr[i], ...p]));
		}
		return result;
	}

	function applyBipartitePermutation(groupId, permIndex) {
		let permutations = mapDragState.bipartitePermutations?.get(groupId);
		if (!permutations || permIndex >= permutations.length) return;

		let newOrder = permutations[permIndex];

		if (!mapDragState.bipartiteViewOrder) {
			mapDragState.bipartiteViewOrder = new Map();
		}
		mapDragState.bipartiteViewOrder.set(groupId, [...newOrder]);

		rerunBridgeWithOrder(groupId, newOrder);
	}

