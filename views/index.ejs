				menuHTML += `<li class="svg-menu-item-creategroup-${safeCloneId} svg-menu-item">Create Group with Selected</li>`;
			}
			
			if (mapDragState.selectedElements.size > 0 && currentGroupId) {
				let hasUngroupedSelected = false;
				mapDragState.selectedElements.forEach(selectedId => {
					if (!mapDragState.cloneGroups.get(selectedId) || 
						mapDragState.cloneGroups.get(selectedId) !== currentGroupId) {
						hasUngroupedSelected = true;
					}
