	function setupCloneMenuHandlers(cloneId, fullCloneId, currentGroupId, cloneEle) {
		let isOrgClone = cloneEle.getAttribute('clone-id')?.startsWith('orgclone') || 
						 cloneEle.id.includes('orgpermanentclone');
		
		// Get the original element ID
		let originalId = cloneEle.getAttribute('original-id') || getOriginalIdFromClone(fullCloneId);
		let numericId = getNumericIdFromClone(fullCloneId);
		
		let clonePrefix = isOrgClone ? 'orgpermanentclone' : 'mappermanentclone';
		let originalPrefix = isOrgClone ? 'bar' : 'map';
		
		// Delete handler - updated for multi-clone
		let deleteItem = document.querySelector(`.svg-menu-item-deleteclone-${cloneId}`);
		if (deleteItem) {
			deleteItem.addEventListener('click', function(e) {
				document.querySelector('.svg-custom-menu').style.display = 'none';
				
				let groupIdBeforeRemoval = currentGroupId;
				let cloneIdToRemove = cloneEle.getAttribute('clone-id');
				
				// Remove visual elements - use clone-id based selectors
				d3.select(cloneEle).remove();
				d3.select(`[data-clone-id="${cloneIdToRemove}"]`).remove(); // text label
				d3.selectAll(`[data-clone-id="${cloneIdToRemove}"]`).remove(); // elastic band
				
				// Unregister the clone (handles original element styling)
				unregisterClone(cloneIdToRemove);
				
				// Remove from group
				removeFromGroup(cloneIdToRemove);
				
				// Update visuals if group still exists
				if (groupIdBeforeRemoval && mapDragState.groupMembers.has(groupIdBeforeRemoval)) {
					updateGroupVisual(groupIdBeforeRemoval);
				}
				
				mapDragState.selectedElements.delete(cloneIdToRemove);
				
				setTimeout(() => {
					showAllProximityBoundaries();
				}, 400);
			});
		}

		// Toggle Gray Out handler
		let toggleGrayItem = document.querySelector(`.svg-menu-item-togglegray-${cloneId}`);
		if (toggleGrayItem) {
			toggleGrayItem.addEventListener('click', function(e) {
				document.querySelector('.svg-custom-menu').style.display = 'none';
				
				let isGrayedOut = cloneEle.getAttribute('grayed-out') === 'true';
				let cloneIdForBand = cloneEle.getAttribute('clone-id');
				let elasticBand = d3.select(`[data-clone-id="${cloneIdForBand}"]`);
				
				if (isGrayedOut) {
					// Restore - but only affect this clone's elastic band
					cloneEle.setAttribute('grayed-out', 'false');
					if (!elasticBand.empty()) {
						elasticBand.style("display", "block");
					}
				} else {
					// Gray out - but only affect this clone's elastic band
					cloneEle.setAttribute('grayed-out', 'true');
					if (!elasticBand.empty()) {
						elasticBand.style("display", "none");
					}
				}
				
				// Update original element glow based on whether ANY clone is not grayed out
				updateOriginalElementGlow(originalId);
			});
		}

		// Rest of the handlers remain the same...
		// (Create group, Add to group, Leave group, Arrange, Select group handlers)
		
		// Create group handler
		let createGroupItem = document.querySelector(`.svg-menu-item-creategroup-${cloneId}`);
		if (createGroupItem) {
			createGroupItem.addEventListener('click', function(e) {
				document.querySelector('.svg-custom-menu').style.display = 'none';
				
				let groupId = getOrCreateGroupId();
				let clonesToGroup = [fullCloneId];
				
				mapDragState.selectedElements.forEach(selectedId => {
					if (selectedId !== fullCloneId && !mapDragState.cloneGroups.get(selectedId)) {
						clonesToGroup.push(selectedId);
					}
				});
				
				if (clonesToGroup.length > 0) {
					assignGroupToClones(clonesToGroup, groupId);
					arrangeGroupVisually(groupId, 'radial');
					
					setTimeout(() => {
						drawGroupBackground(groupId);
						drawProximityBoundary(groupId, false);
						showAllProximityBoundaries();
					}, 350);
				}
				
				clearMapSelection();
				if (typeof clearOrgSelection === 'function') clearOrgSelection();
			});
		}

		// Add to group handler
		let addToGroupItem = document.querySelector(`.svg-menu-item-addtogroup-${cloneId}`);
		if (addToGroupItem) {
			addToGroupItem.addEventListener('click', function(e) {
				document.querySelector('.svg-custom-menu').style.display = 'none';
				
				let clonesToAdd = [];
				
				mapDragState.selectedElements.forEach(selectedId => {
					let existingGroup = mapDragState.cloneGroups.get(selectedId);
					if (!existingGroup || existingGroup !== currentGroupId) {
						if (existingGroup) {
							removeFromGroup(selectedId);
							updateGroupVisual(existingGroup);
						}
						clonesToAdd.push(selectedId);
					}
				});
				
				if (clonesToAdd.length > 0) {
					assignGroupToClones(clonesToAdd, currentGroupId);
					
					let preferredArrangement = mapDragState.groupArrangements?.get(currentGroupId) || 'radial';
					arrangeGroupVisually(currentGroupId, preferredArrangement);
					
					setTimeout(() => {
						updateGroupVisual(currentGroupId);
						showAllProximityBoundaries();
					}, 350);
				}
				
				clearMapSelection();
				if (typeof clearOrgSelection === 'function') clearOrgSelection();
			});
		}

		// Leave group handler
		let leaveGroupItem = document.querySelector(`.svg-menu-item-leavegroup-${cloneId}`);
		if (leaveGroupItem) {
			leaveGroupItem.addEventListener('click', function(e) {
				document.querySelector('.svg-custom-menu').style.display = 'none';
				
				removeFromGroup(fullCloneId);
				updateGroupVisual(currentGroupId);
				
				let newGroupId = getOrCreateGroupId();
				assignGroupToClones([fullCloneId], newGroupId);
				
				setTimeout(() => {
					showAllProximityBoundaries();
				}, 100);
			});
		}
		
		// Arrange handlers
		let arrangeTypes = [
			'preserve', 'radial', 'column', 'row', 'grid', 'circle', 'bridge',
			'hierarchy', 'timeline', 'venn', 'force', 'matrix', 'cluster', 'sunburst'
		];
		arrangeTypes.forEach(type => {
			let arrangeItem = document.querySelector(`.svg-menu-item-arrange-${type}-${cloneId}`);
			if (arrangeItem) {
				arrangeItem.addEventListener('click', function(e) {
					e.stopPropagation();
					document.querySelector('.svg-custom-menu').style.display = 'none';
					
					if (!mapDragState.groupArrangements) {
						mapDragState.groupArrangements = new Map();
					}
					mapDragState.groupArrangements.set(currentGroupId, type);
					
					arrangeGroupVisually(currentGroupId, type);
					
					setTimeout(() => {
						drawGroupBackground(currentGroupId);
						drawProximityBoundary(currentGroupId, false);
						reorderSVGElements();
					}, 350);
				});
			}
		});

		// Select entire group handler
		let selectGroupItem = document.querySelector(`.svg-menu-item-selectgroup-${cloneId}`);
		if (selectGroupItem) {
			selectGroupItem.addEventListener('click', function(e) {
				document.querySelector('.svg-custom-menu').style.display = 'none';
				
				clearMapSelection();
				if (typeof clearOrgSelection === 'function') clearOrgSelection();

				let groupMembers = mapDragState.groupMembers.get(currentGroupId);
				if (groupMembers) {
					groupMembers.forEach(memberId => {
						mapDragState.selectedElements.add(memberId);
						let element = document.querySelector(`[clone-id="${memberId}"]`);
						if (element) {
							d3.select(element).classed('map-selected', true);
						}
					});
				}
			});
		}
	}

	let cloneDragState = {
		isDragging: false,
		dragThreshold: 5,
		startPos: { x: 0, y: 0 },
		dragOffsets: []
	};

	function cloneDragStart(d) {
		cloneDragState.isDragging = false;
		cloneDragState.dragOccurred = false;
		cloneDragState.startPos = { x: d3.event.x, y: d3.event.y };
		cloneDragState.dragOffsets = [];
		
		let thisCloneId = this.getAttribute('clone-id');
		
		// Individual drag - only this element
		let thisX, thisY;
		
		if (this.tagName === 'rect') {
			thisX = parseFloat(d3.select(this).attr('x')) + 8;
			thisY = parseFloat(d3.select(this).attr('y')) + 8;
		} else {
			thisX = parseFloat(d3.select(this).attr('cx'));
			thisY = parseFloat(d3.select(this).attr('cy'));
		}
		
		cloneDragState.dragOffsets = [{
			element: this,
			offsetX: 0,
			offsetY: 0,
			cloneId: thisCloneId,
			startX: thisX,
			startY: thisY
		}];
	}

	function cloneDragMove(d) {
		let distance = Math.sqrt(
			Math.pow(d3.event.x - cloneDragState.startPos.x, 2) + 
			Math.pow(d3.event.y - cloneDragState.startPos.y, 2)
		);
		
		if (distance > cloneDragState.dragThreshold) {
			cloneDragState.isDragging = true;
			cloneDragState.dragOccurred = true;
		}
		
		if (cloneDragState.isDragging) {
			let newX = d3.event.x;
			let newY = d3.event.y;
			
			let item = cloneDragState.dragOffsets[0];
			if (!item) return;
			
			let draggedCloneId = item.cloneId;
			let currentGroupId = mapDragState.cloneGroups.get(draggedCloneId);
			
			// Check proximity for merging
			let nearbyGroup = checkProximityToGroups(newX, newY, currentGroupId);
			
			if (nearbyGroup !== mapDragState.currentProximityGroup) {
				if (mapDragState.currentProximityGroup) {
					drawProximityBoundary(mapDragState.currentProximityGroup, false);
				}
				if (nearbyGroup) {
					drawProximityBoundary(nearbyGroup, true);
				}
				mapDragState.currentProximityGroup = nearbyGroup;
			}
			
			// Move only this element
			let element = d3.select(item.element);
			
			if (item.element.tagName === 'rect') {
				element.attr('x', newX - 8).attr('y', newY - 8);
			} else {
				element.attr('cx', newX).attr('cy', newY);
			}
			
			// Update text and elastic band
			let cloneIdAttr = item.element.getAttribute('clone-id');
            let isOrgClone = cloneIdAttr && cloneIdAttr.startsWith('orgclone');
            let isPerClone = cloneIdAttr && cloneIdAttr.startsWith('perclone');
            let numId = getNumericIdFromClone(cloneIdAttr);
            let instMatch = cloneIdAttr ? cloneIdAttr.match(/-(\d+)$/) : null;
            let instSuffix = instMatch ? instMatch[0] : '';
            
            if (isPerClone) {
                d3.select('#perclonetext' + numId + instSuffix).attr('x', newX).attr('y', newY - 12);
            } else if (isOrgClone) {
                d3.select('#orgclonetext' + numId + instSuffix).attr('x', newX).attr('y', newY - 12);
            } else {
                d3.select('#mapclonetext' + numId + instSuffix).attr('x', newX).attr('y', newY - 12);
            }
			
			updateElasticBandUniversal(item.element, newX, newY);
			
			// Update group boundary
            if (currentGroupId) {
                updateBoundaryPosition(currentGroupId);
                updateAllArrangementVisuals(currentGroupId);
                updateGroupNameLabelPositionDirect(currentGroupId);
		updateFCAPanelDuringDrag(currentGroupId, newX - item.startX, newY - item.startY);
            }
		}
	}

	function updateFCAPanelPosition(groupIdBeingDragged) {
		let fcaPanel = document.getElementById('fca-suggestion-panel');
		if (!fcaPanel || fcaPanel.style.display === 'none') return;

		// Check if the dragged group is the same as the panel's group
		// OR if the anchor clone is in the dragged group
		let panelGroupId = fcaPanel._anchorGroupId;
		if (!panelGroupId) return;

		// Direct match
		if (panelGroupId !== groupIdBeingDragged) {
			// Also check if anchor clone belongs to the dragged group
			let anchorClone = fcaPanel._anchorClone;
			if (!anchorClone) return;
			let anchorCloneId = anchorClone.getAttribute('clone-id');
			let anchorActualGroup = anchorCloneId ? mapDragState.cloneGroups.get(anchorCloneId) : null;
			if (anchorActualGroup !== groupIdBeingDragged) return;
			// Update stored group ID to match
			fcaPanel._anchorGroupId = groupIdBeingDragged;
		}

		let anchorClone = fcaPanel._anchorClone;
		if (!anchorClone || !anchorClone.parentNode) return;

		let newAnchorX, newAnchorY;
		if (anchorClone.tagName === 'rect') {
			newAnchorX = parseFloat(anchorClone.getAttribute('x')) + 8;
			newAnchorY = parseFloat(anchorClone.getAttribute('y')) + 8;
		} else {
			newAnchorX = parseFloat(anchorClone.getAttribute('cx'));
			newAnchorY = parseFloat(anchorClone.getAttribute('cy'));
		}

		fcaPanel._anchorX = newAnchorX;
		fcaPanel._anchorY = newAnchorY;

		const boardRect = document.getElementById('board').getBoundingClientRect();
		let panelLeft = newAnchorX + 20;
		let panelTop = newAnchorY - 40;
		if (panelLeft + 340 > boardRect.width) panelLeft = newAnchorX - 360;
		if (panelTop < 0) panelTop = 10;
		if (panelTop + 460 > boardRect.height) panelTop = boardRect.height - 470;

		fcaPanel.style.left = panelLeft + 'px';
		fcaPanel.style.top = panelTop + 'px';
	}

	function updateFCAPanelPositionFromGroup(groupId) {
		let fcaPanel = document.getElementById('fca-suggestion-panel');
		if (!fcaPanel || fcaPanel.style.display === 'none') return;

		let panelGroupId = fcaPanel._anchorGroupId;
		if (!panelGroupId) return;

		// Check if this group matches the panel's group
		let isMatch = (panelGroupId === groupId);
		if (!isMatch) {
			let anchorClone = fcaPanel._anchorClone;
			if (anchorClone) {
				let anchorCloneId = anchorClone.getAttribute('clone-id');
				let anchorActualGroup = anchorCloneId ? mapDragState.cloneGroups.get(anchorCloneId) : null;
				if (anchorActualGroup === groupId) {
					fcaPanel._anchorGroupId = groupId;
					isMatch = true;
				}
			}
		}
		if (!isMatch) return;

		// Use the anchor clone's CURRENT position (it moves with group drag)
		let anchorClone = fcaPanel._anchorClone;
		if (anchorClone && anchorClone.parentNode) {
			let ax, ay;
			if (anchorClone.tagName === 'rect') {
				ax = parseFloat(anchorClone.getAttribute('x')) + 8;
				ay = parseFloat(anchorClone.getAttribute('y')) + 8;
			} else {
				ax = parseFloat(anchorClone.getAttribute('cx'));
				ay = parseFloat(anchorClone.getAttribute('cy'));
			}
			fcaPanel._anchorX = ax;
			fcaPanel._anchorY = ay;
		}

		// Fallback: compute group center
		let refX = fcaPanel._anchorX;
		let refY = fcaPanel._anchorY;

		const boardRect = document.getElementById('board').getBoundingClientRect();
		let panelLeft = refX + 20;
		let panelTop = refY - 40;
		if (panelLeft + 340 > boardRect.width) panelLeft = refX - 360;
		if (panelTop < 0) panelTop = 10;
		if (panelTop + 460 > boardRect.height) panelTop = boardRect.height - 470;

		fcaPanel.style.left = panelLeft + 'px';
		fcaPanel.style.top = panelTop + 'px';
	}

	function updateAllArrangementVisuals(groupId) {
			let members = mapDragState.groupMembers.get(groupId);
			if (!members || members.size === 0) return;
			
			// Calculate current center
			let centerX = 0, centerY = 0, count = 0;
			members.forEach(cloneId => {
				let element = document.querySelector(`[clone-id="${cloneId}"]`);
				if (element) {
					let cx, cy;
					if (element.tagName === 'rect') {
						cx = parseFloat(d3.select(element).attr('x')) + 8;
						cy = parseFloat(d3.select(element).attr('y')) + 8;
					} else {
						cx = parseFloat(d3.select(element).attr('cx'));
						cy = parseFloat(d3.select(element).attr('cy'));
					}
					centerX += cx;
					centerY += cy;
					count++;
				}
			});
			
			if (count === 0) return;
			centerX /= count;
			centerY /= count;
			
			// Update all connection lines (works for all arrangements)
			updateAllConnectionLines(groupId);
			
			// Update bridge visuals
			updateBridgeVisualsOnDrag(groupId, centerX, centerY);
			
			// Update venn visuals
			updateVennVisualsOnDrag(groupId, centerX, centerY);
			
			// Update cluster visuals
			updateClusterVisualsOnDrag(groupId, centerX, centerY);
			
			// Matrix is now handled separately - don't update here
			// updateMatrixVisualsOnDrag(groupId, centerX, centerY);
			
			// Update timeline visuals
			updateTimelineVisualsOnDrag(groupId, centerX, centerY);
			
			// Update sunburst visuals
			updateSunburstVisualsOnDrag(groupId, centerX, centerY);
		}

	function cloneDragEnd(d) {
		if (!cloneDragState.isDragging) {
			cloneDragState.isDragging = false;
			cloneDragState.dragOffsets = [];
			mapDragState.currentProximityGroup = null;
			return;
		}
		
		let item = cloneDragState.dragOffsets[0];
		if (!item) {
			cloneDragState.isDragging = false;
			cloneDragState.dragOffsets = [];
			return;
		}
		
		let draggedCloneId = item.cloneId;
		let currentGroupId = mapDragState.cloneGroups.get(draggedCloneId);
		
		// Final proximity check at drop position
		let finalX, finalY;
		if (item.element.tagName === 'rect') {
			finalX = parseFloat(d3.select(item.element).attr('x')) + 8;
			finalY = parseFloat(d3.select(item.element).attr('y')) + 8;
		} else {
			finalX = parseFloat(d3.select(item.element).attr('cx'));
			finalY = parseFloat(d3.select(item.element).attr('cy'));
		}

		if (!mapDragState.currentProximityGroup) {
			mapDragState.currentProximityGroup = checkProximityToGroups(finalX, finalY, currentGroupId);
		}
		
		// Check for merge
		if (mapDragState.currentProximityGroup && mapDragState.currentProximityGroup !== currentGroupId) {
			let targetGroupId = mapDragState.currentProximityGroup;
			
			if (currentGroupId) {
				removeFromGroup(draggedCloneId);
				updateGroupVisual(currentGroupId);
			}
			
			assignGroupToClones([draggedCloneId], targetGroupId);
			
			let preferredArrangement = mapDragState.groupArrangements?.get(targetGroupId) || 'radial';
			arrangeGroupVisually(targetGroupId, preferredArrangement);
			
			highlightGroup(targetGroupId, true);
			setTimeout(() => highlightGroup(targetGroupId, false), 300);
			
			setTimeout(() => {
				updateGroupVisual(targetGroupId);
			}, 350);
		} else if (currentGroupId) {
			setTimeout(() => {
				drawGroupBackground(currentGroupId);
				drawProximityBoundary(currentGroupId, false);
				drawGroupNameLabel(currentGroupId);
			}, 50);
		}
		
		        // Reposition FCA panel if it's tied to this group
        let fcaPanel = document.getElementById('fca-suggestion-panel');
        if (fcaPanel && fcaPanel.style.display !== 'none' && fcaPanel._anchorGroupId === currentGroupId) {
            let anchorClone = fcaPanel._anchorClone;
            if (anchorClone) {
                let newAnchorX, newAnchorY;
                if (anchorClone.tagName === 'rect') {
                    newAnchorX = parseFloat(anchorClone.getAttribute('x')) + 8;
                    newAnchorY = parseFloat(anchorClone.getAttribute('y')) + 8;
                } else {
                    newAnchorX = parseFloat(anchorClone.getAttribute('cx'));
                    newAnchorY = parseFloat(anchorClone.getAttribute('cy'));
                }
                fcaPanel._anchorX = newAnchorX;
                fcaPanel._anchorY = newAnchorY;

                const boardRect = document.getElementById('board').getBoundingClientRect();
                const leftOffset = document.getElementById('leftplace').offsetWidth;
                let panelLeft = newAnchorX + leftOffset + 20;
                let panelTop = newAnchorY - 40;
                if (panelLeft + 340 > boardRect.width) panelLeft = newAnchorX + leftOffset - 360;
                if (panelTop < 0) panelTop = 10;
                if (panelTop + 460 > boardRect.height) panelTop = boardRect.height - 470;

                fcaPanel.style.transition = 'left 0.2s ease, top 0.2s ease';
                fcaPanel.style.left = panelLeft + 'px';
                fcaPanel.style.top = panelTop + 'px';
                setTimeout(() => { fcaPanel.style.transition = ''; }, 250);
            }
        }
		
		if (mapDragState.currentProximityGroup) {
			drawProximityBoundary(mapDragState.currentProximityGroup, false);
		}
		
		setTimeout(() => {
			showAllProximityBoundaries();
			ensureAllClonesHaveGlow();
		}, 400);
		
		cloneDragState.isDragging = false;
		cloneDragState.dragOffsets = [];
		mapDragState.currentProximityGroup = null;
	}

	function clearMapSelection() {
		mapDragState.selectedElements.forEach(id => {
			// The selectedElements set can contain:
			//   a) Original map element IDs like "map5"
			//   b) Clone-ids like "mapclone5-2" or "orgclone3-1"

			// Try as an original element first
			let element = document.getElementById(id);

			// Try as a clone
			let cloneElement = document.querySelector(`[clone-id="${id}"]`);

			if (cloneElement) {
				// Remove clone selection styling
				d3.select(cloneElement)
					.classed('map-selected', false)
					.style('stroke', '#4169e1')
					.style('stroke-width', '2px');
			}

			if (element) {
				// It's an original element (map or org)
				let isCloned = hasAnyClone(id);

				if (isCloned) {
					// Restore orange glow
					d3.select(element)
						.classed('map-selected', false)
						.style("stroke", "none")
						.style("stroke-width", "0")
						.style("filter", "drop-shadow(0 0 4px orange) drop-shadow(0 0 8px orange)");
				} else {
					// Fully clear
					d3.select(element)
						.classed('map-selected', false)
						.style("stroke", "none")
						.style("stroke-width", "0")
						.style("filter", "none");
				}
			}
		});
		mapDragState.selectedElements.clear();
	}

	function checkProximityToGroups(x, y, excludeGroupId = null, draggedIsOrg = false) {
		let closestGroup = null;
		let minDistance = Infinity;
		
		mapDragState.groupMembers.forEach((members, groupId) => {
			if (groupId === excludeGroupId) return;
			if (!members || members.size === 0) return;
			
			// First check if point is inside the boundary
			let boundary = document.querySelector(`.proximity-boundary[data-group-id="${groupId}"]`);
			if (boundary) {
				let isInside = isPointInsideBoundary(x, y, boundary);
				if (isInside) {
					closestGroup = groupId;
					minDistance = 0;
					return;
				}
			}
			
			// Fallback: Calculate distance to nearest member of the group
			let minMemberDistance = Infinity;
			
			members.forEach(cloneId => {
				let element = document.querySelector(`[clone-id="${cloneId}"]`);
				if (element) {
					let cx, cy;
					if (element.tagName === 'rect') {
						cx = parseFloat(d3.select(element).attr('x')) + 8;
						cy = parseFloat(d3.select(element).attr('y')) + 8;
					} else {
						cx = parseFloat(d3.select(element).attr('cx'));
						cy = parseFloat(d3.select(element).attr('cy'));
					}
					
					let distance = Math.sqrt(Math.pow(x - cx, 2) + Math.pow(y - cy, 2));
					minMemberDistance = Math.min(minMemberDistance, distance);
				}
			});
			
			if (minMemberDistance < mapDragState.proximityRadius && minMemberDistance < minDistance) {
				minDistance = minMemberDistance;
				closestGroup = groupId;
			}
		});
		
		return closestGroup;
	}

