	function clearPersonSelection() {
		personDragState.selectedElements.forEach(id => {
			// id is like "per5"
			let element = document.getElementById(id);
			if (element) {
				let isCloned = hasAnyClone(id);

				if (isCloned) {
					d3.select(element)
						.style("fill", "#6495ed")
						.style("filter", "drop-shadow(0 0 4px orange) drop-shadow(0 0 8px orange)");
