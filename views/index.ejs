					.style('stroke-width', '2px');
			}
		});
		mapDragState.selectedElements.clear();
	}

	function checkDropOntoGroup(dropX, dropY) {
		let targetClone = null;
		let minDistance = 40; // pixel threshold for group detection
		let targetGroupId = null;
		
		d3.selectAll('.map-permanent-clone').each(function() {
			let cx = parseFloat(d3.select(this).attr('cx'));
			let cy = parseFloat(d3.select(this).attr('cy'));
			let distance = Math.sqrt(Math.pow(dropX - cx, 2) + Math.pow(dropY - cy, 2));
			
			if (distance < minDistance) {
				targetClone = this;
				minDistance = distance;
			}
		});
		
		if (targetClone) {
			let targetCloneId = targetClone.getAttribute('clone-id');
			targetGroupId = mapDragState.cloneGroups.get(targetCloneId);
			
			if (targetGroupId) {
				// Visual feedback - highlight the target group
				highlightGroup(targetGroupId, true);
				setTimeout(() => highlightGroup(targetGroupId, false), 500);
			}
		}
		
		return targetGroupId;
	}

