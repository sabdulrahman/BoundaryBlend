	// Update the elastic band for organization clones
	function updateOrgElasticBand(element, x, y) {
		let cloneId = element.id.replace('orgpermanentclone', '');
		let origEle = document.getElementById('bar' + cloneId);
		
		if (origEle) {
			let leftOffset = document.getElementById('leftplace').offsetWidth;
			let origRect = origEle.getBoundingClientRect();
			let origX = origRect.x - leftOffset + (origRect.width / 2);
			let origY = origRect.y + (origRect.height / 2);
			
			d3.select('#elasticpermanentorg' + cloneId)
				.attr('x1', origX)
				.attr('y1', origY)
				.attr('x2', x)
				.attr('y2', y);
		}
	}

