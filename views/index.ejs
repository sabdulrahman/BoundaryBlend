	function personDragStart(d) {
		personDragState.isDragging = false;
		personDragState.dragOccurred = false;
		personDragState.startPos = { x: d3.event.x, y: d3.event.y };
		personDragState.originalElement = this;
		personDragState.isMultiDrag = false;
		personDragState.cloneGroup = [];

		let thisId = 'per' + this.getAttribute('personsid');
		if (personDragState.selectedElements.has(thisId) && personDragState.selectedElements.size > 1) {
			personDragState.isMultiDrag = true;
		}
	}

	function personDragElement(d) {
		let ele = this;
		let personsid = ele.getAttribute('personsid');
		let name = ele.getAttribute('data-name');

		let distance = Math.sqrt(
			Math.pow(d3.event.x - personDragState.startPos.x, 2) +
			Math.pow(d3.event.y - personDragState.startPos.y, 2)
		);

		// --- Create clones once threshold exceeded ---
		if (distance > personDragState.dragThreshold && !personDragState.isDragging) {
			personDragState.isDragging = true;
			personDragState.dragOccurred = true;

			let boardg = d3.select('#line-canvas');
			let leftOffset = document.getElementById('leftplace').offsetWidth;

			if (personDragState.isMultiDrag) {
				let selectedArray = Array.from(personDragState.selectedElements);

				selectedArray.forEach((selectedId, index) => {
					// selectedId is like "per5"
					let numId = selectedId.replace('per', '');
					let selectedEle = document.getElementById('per' + numId);
					if (!selectedEle) return;

					let eleRect = selectedEle.getBoundingClientRect();
					let canvasX = eleRect.x - leftOffset + (eleRect.width / 2);
					let canvasY = eleRect.y + (eleRect.height / 2);

					let selectedName = selectedEle.getAttribute('data-name');

					let clone = boardg.append("circle")
						.attr("cx", canvasX)
						.attr("cy", canvasY)
						.attr("r", 10)
						.attr("id", 'perclonetemp' + numId + '-' + index)
						.attr("data-name", selectedName)
						.style("fill", d3.select(selectedEle).style("fill"))
						.style("stroke", "orange")
						.style("stroke-width", "3px")
						.style("opacity", "0.8")
						.style("cursor", "move");

					let elasticBand = boardg.append("line")
						.attr("id", 'elasticpertemp' + numId + '-' + index)
						.attr("class", "elastic-band")
						.attr("x1", canvasX)
						.attr("y1", canvasY)
						.attr("x2", canvasX)
						.attr("y2", canvasY);

					boardg.append("text")
						.attr("x", canvasX)
						.attr("y", canvasY - 12)
						.attr("id", 'perclonetexttemp' + numId + '-' + index)
						.attr("text-anchor", "middle")
						.style("fill", "white")
						.style("font-size", "10px")
						.style("font-weight", "bold")
						.style("pointer-events", "none")
						.style("text-shadow", "1px 1px 2px black")
						.text(selectedName);

					personDragState.cloneGroup.push({
						clone: clone,
						elasticBand: elasticBand,
						textLabel: d3.select('#perclonetexttemp' + numId + '-' + index),
						originalElement: selectedEle,
						personId: numId,
						offsetX: canvasX - (d3.event.sourceEvent.clientX - leftOffset),
						offsetY: canvasY - d3.event.sourceEvent.clientY
					});
				});

			} else {
				let eleRect = ele.getBoundingClientRect();
				let canvasX = eleRect.x - leftOffset + (eleRect.width / 2);
				let canvasY = eleRect.y + (eleRect.height / 2);

				personDragState.currentClone = boardg.append("circle")
					.attr("cx", canvasX)
					.attr("cy", canvasY)
					.attr("r", 10)
					.attr("id", 'perclonetemp' + personsid)
