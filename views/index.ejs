				// Check connection
				let hasConnection = false;
				if (typeof mapcondata !== 'undefined' && mapcondata[mapNumericId]) {
					let moConnections = mapcondata[mapNumericId]['mo'] || '';
					hasConnection = moConnections.split(',').includes(orgNumericId);
