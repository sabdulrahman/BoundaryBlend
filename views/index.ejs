	function showFCABrowser() {
		let panel = document.getElementById('fca-browser-panel');
		if (panel) { panel.style.display = panel.style.display === 'none' ? 'block' : 'none'; return; }

		panel = document.createElement('div');
		panel.id = 'fca-browser-panel';
		panel.innerHTML = `
			<div class="fca-panel-header">
				<span class="fca-panel-title">All FCA Clusters (${FCA_CLUSTERS.length})</span>
				<span class="fca-panel-close" onclick="document.getElementById('fca-browser-panel').style.display='none'">✕</span>
			</div>
			<div class="fca-browser-filter">
				<input id="fca-browser-search" type="text" placeholder="Search clusters or entities…" />
				<div class="fca-filter-pills">
					${['All','Coordination','Boston','Atlanta','NYSE','Mixed','Noise'].map(a =>
						`<span class="fca-pill${a==='All'?' active':''}" data-action="${a}">${a}</span>`
					).join('')}
				</div>
			</div>
			<div class="fca-browser-body"></div>
		`;
		document.getElementById('board').appendChild(panel);

		// Filter logic
		let activeAction = 'All';
		let searchText   = '';

		function renderBrowser() {
			const body = panel.querySelector('.fca-browser-body');
			body.innerHTML = '';
			FCA_CLUSTERS
				.filter(g => activeAction === 'All' || g.action === activeAction)
				.filter(g => {
					if (!searchText) return true;
					const q = searchText.toLowerCase();
					return g.name.toLowerCase().includes(q) ||
						[...g.persons, ...g.locations, ...g.organizations]
							.some(n => n.toLowerCase().includes(q));
				})
				.forEach(group => {
					const section = document.createElement('div');
					section.className = 'fca-cluster-section';

					const header = document.createElement('div');
					header.className = 'fca-cluster-header fca-action-' + group.action.toLowerCase();
					header.style.cursor = 'pointer';
					header.innerHTML = `
						<span class="fca-cluster-number">C${group.id}</span>
						<span class="fca-cluster-name">${group.name}</span>
						<span class="fca-cluster-meta">
							${group.f1 != null ? `F1:${group.f1.toFixed(2)}` : ''}
							<span class="fca-cluster-badge">${group.action}</span>
						</span>
						<span class="fca-expand-toggle">▸</span>
					`;

					const entityList = document.createElement('div');
					entityList.className = 'fca-entity-list';
					entityList.style.display = 'none';

					// Add-all from browser — uses board center as anchor
					const addBtn = document.createElement('button');
					addBtn.className = 'fca-add-all-btn';
					addBtn.textContent = `⊕ Highlight all entities`;
					addBtn.onclick = (e) => {
						e.stopPropagation();
						group._anchorName = null;  // no anchor — uses board center
						addAllClusterEntities(group);
					};
					entityList.appendChild(addBtn);

					[
						{ list: group.persons,       icon: '👤' },
						{ list: group.locations,     icon: '📍' },
						{ list: group.organizations, icon: '🏢' }
					].forEach(({ list, icon }) => {
						list.forEach(name => {
							const row = document.createElement('div');
							row.className = 'fca-suggestion-row';
							row.innerHTML = `<span class="fca-icon">${icon}</span><span class="fca-name">${name}</span>`;
							row.onclick = () => {
								const type = fcaEntityTypeIndex[name.trim().toLowerCase()];
								if (type) highlightEntityInView(name, type);
							};
							entityList.appendChild(row);
						});
					});

					header.onclick = () => {
						const open = entityList.style.display !== 'none';
						entityList.style.display = open ? 'none' : 'block';
						header.querySelector('.fca-expand-toggle').textContent = open ? '▸' : '▾';
					};

					section.appendChild(header);
					section.appendChild(entityList);
					body.appendChild(section);
				});
		}

		panel.querySelector('#fca-browser-search').addEventListener('input', e => {
			searchText = e.target.value;
			renderBrowser();
		});

		panel.querySelectorAll('.fca-pill').forEach(pill => {
			pill.onclick = () => {
				panel.querySelectorAll('.fca-pill').forEach(p => p.classList.remove('active'));
				pill.classList.add('active');
				activeAction = pill.dataset.action;
				renderBrowser();
			};
		});

		renderBrowser();
	}


	function drawConnectionLines(connections, groupId, className = 'arrangement-connection') {
		let canvas = d3.select('#line-canvas');
		
		// Remove existing connections for this group
		canvas.selectAll(`.${className}-${groupId}`).remove();
		
		connections.forEach(conn => {
			let sourceX, sourceY, targetX, targetY;
			
			// Get source position
			if (conn.sourceElement.tagName === 'rect') {
				sourceX = parseFloat(d3.select(conn.sourceElement).attr('x')) + 8;
				sourceY = parseFloat(d3.select(conn.sourceElement).attr('y')) + 8;
			} else {
				sourceX = parseFloat(d3.select(conn.sourceElement).attr('cx'));
				sourceY = parseFloat(d3.select(conn.sourceElement).attr('cy'));
			}
			
			// Get target position
			if (conn.targetElement.tagName === 'rect') {
				targetX = parseFloat(d3.select(conn.targetElement).attr('x')) + 8;
				targetY = parseFloat(d3.select(conn.targetElement).attr('y')) + 8;
			} else {
				targetX = parseFloat(d3.select(conn.targetElement).attr('cx'));
				targetY = parseFloat(d3.select(conn.targetElement).attr('cy'));
			}
			
			// Draw connection line
			canvas.insert('line', '.proximity-boundary')
				.attr('class', `${className} ${className}-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('x1', sourceX)
				.attr('y1', sourceY)
				.attr('x2', targetX)
				.attr('y2', targetY)
				.style('stroke', 'rgba(255, 165, 0, 0.5)')
				.style('stroke-width', '2px')
				.style('stroke-dasharray', '4,2')
				.style('pointer-events', 'none');
			
			// Draw midpoint circle
			let midX = (sourceX + targetX) / 2;
			let midY = (sourceY + targetY) / 2;
			
			canvas.insert('circle', '.proximity-boundary')
				.attr('class', `${className} ${className}-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-source', conn.sourceElement?.getAttribute('clone-id') || '')
				.attr('data-target', conn.targetElement?.getAttribute('clone-id') || '')
				.attr('cx', midX)
				.attr('cy', midY)
		});
	}

	function getConnectionsBetweenClones(members) {
		let connections = [];
		let membersArray = Array.from(members);
		
		console.log('=== getConnectionsBetweenClones ===');
		console.log('Members:', membersArray);
		
		membersArray.forEach(sourceCloneId => {
			let sourceElement = document.querySelector(`[clone-id="${sourceCloneId}"]`);
			if (!sourceElement) return;
			
			let sourceIsMap = sourceCloneId.startsWith('mapclone');
			let sourceIsOrg = sourceCloneId.startsWith('orgclone');
			
			// Extract numeric ID (handles both old format "mapclone5" and new format "mapclone5-2")
			let sourceNumericId = getNumericIdFromClone(sourceCloneId);
			
			console.log('Checking source:', sourceCloneId, 'NumericId:', sourceNumericId, 'IsMap:', sourceIsMap, 'IsOrg:', sourceIsOrg);
			
			membersArray.forEach(targetCloneId => {
				if (sourceCloneId === targetCloneId) return;
				
				let targetElement = document.querySelector(`[clone-id="${targetCloneId}"]`);
				if (!targetElement) return;
				
				let targetIsMap = targetCloneId.startsWith('mapclone');
				let targetIsOrg = targetCloneId.startsWith('orgclone');
				let sourceIsPer = sourceCloneId.startsWith('perclone');
				let targetIsPer = targetCloneId.startsWith('perclone');				
				let targetNumericId = getNumericIdFromClone(targetCloneId);
				
				let hasConnection = false;
				
				// Check map → org connection (mo)
				if (sourceIsMap && targetIsOrg) {
					if (typeof mapcondata !== 'undefined' && mapcondata[sourceNumericId]) {
						let moConnections = mapcondata[sourceNumericId]['mo'] || '';
						console.log('Map', sourceNumericId, 'mo connections:', moConnections);
						if (moConnections.split(',').includes(targetNumericId)) {
							hasConnection = true;
							console.log('FOUND: Map', sourceNumericId, '-> Org', targetNumericId);
						}
					}
				}
				
				// Check org → map connection (om)
				if (sourceIsOrg && targetIsMap) {
					if (typeof mapcondata !== 'undefined' && mapcondata[sourceNumericId]) {
						let omConnections = mapcondata[sourceNumericId]['om'] || '';
						console.log('Org', sourceNumericId, 'om connections:', omConnections);
						if (omConnections.split(',').includes(targetNumericId)) {
							hasConnection = true;
							console.log('FOUND: Org', sourceNumericId, '-> Map', targetNumericId);
						}
					}
				}
				
				// Check person → map connection (gm)
				if (sourceIsPer && targetIsMap) {
					if (typeof mapcondata !== 'undefined' && mapcondata[sourceNumericId]) {
						let gmConnections = mapcondata[sourceNumericId]['gm'] || '';
						if (gmConnections.split(',').includes(targetNumericId)) {
							hasConnection = true;
						}
					}
				}

				// Check map → person connection (mg)
				if (sourceIsMap && targetIsPer) {
					if (typeof mapcondata !== 'undefined' && mapcondata[sourceNumericId]) {
						let mgConnections = mapcondata[sourceNumericId]['mg'] || '';
						if (mgConnections.split(',').includes(targetNumericId)) {
							hasConnection = true;
						}
					}
				}

				// Check person → org connection (go)
				if (sourceIsPer && targetIsOrg) {
					if (typeof mapcondata !== 'undefined' && mapcondata[sourceNumericId]) {
						let goConnections = mapcondata[sourceNumericId]['go'] || '';
						if (goConnections.split(',').includes(targetNumericId)) {
							hasConnection = true;
						}
					}
				}

				// Check org → person connection (og) - reverse lookup
				if (sourceIsOrg && targetIsPer) {
					if (typeof mapcondata !== 'undefined' && mapcondata[targetNumericId]) {
						let goConnections = mapcondata[targetNumericId]['go'] || '';
						if (goConnections.split(',').includes(sourceNumericId)) {
							hasConnection = true;
						}
					}
				}

				// Check reverse: map → person via gm
				if (sourceIsMap && targetIsPer) {
					if (typeof mapcondata !== 'undefined' && mapcondata[targetNumericId]) {
						let gmConnections = mapcondata[targetNumericId]['gm'] || '';
						if (gmConnections.split(',').includes(sourceNumericId)) {
							hasConnection = true;
						}
					}
				}

				
				// Also check reverse (org has om that points to map)
				if (sourceIsMap && targetIsOrg) {
					if (typeof mapcondata !== 'undefined' && mapcondata[targetNumericId]) {
						let omConnections = mapcondata[targetNumericId]['om'] || '';
						if (omConnections.split(',').includes(sourceNumericId)) {
							hasConnection = true;
							console.log('FOUND (reverse): Org', targetNumericId, '-> Map', sourceNumericId);
						}
					}
				}
				
				if (hasConnection) {
					let existingConnection = connections.find(c => 
						(c.source === sourceCloneId && c.target === targetCloneId) ||
						(c.source === targetCloneId && c.target === sourceCloneId)
					);
					
					if (!existingConnection) {
						connections.push({
							source: sourceCloneId,
							target: targetCloneId,
							sourceElement: sourceElement,
							targetElement: targetElement
						});
					}
				}
			});
		});
		
		console.log('Total connections found:', connections.length);
		return connections;
	}

	function hasClone(elementId, isOrgElement, isPersonElement) {
		if (isOrgElement === undefined) isOrgElement = false;
		if (isPersonElement === undefined) isPersonElement = false;
		let originalId = isPersonElement ? 'per' + elementId : (isOrgElement ? 'bar' + elementId : 'map' + elementId);
		return hasAnyClone(originalId);
	}
																																																				
	let mapDragState = {
		isDragging: false,
		dragThreshold: 10,
		startPos: { x: 0, y: 0 },
		currentClone: null,
		originalElement: null,
		selectedElements: new Set(),
		isMultiDrag: false,
		cloneGroup: [],
		// NEW: Group management
		cloneGroups: new Map(), // Maps clone-id to group-id
		nextGroupId: 0,
		groupMembers: new Map(), // Maps group-id to Set of clone-ids
		proximityRadius: 60,
		currentProximityGroup: null,
		groupNames: new Map(),
		groupRotations: new Map(),
		// NEW: Multi-clone support
		nextCloneInstance: new Map(), // Maps original element id (e.g., "map5") to next instance number
		originalToClones: new Map(), // Maps original element id to Set of clone-ids
		cloneToOriginal: new Map() // Maps clone-id to original element id
	};

	function getNextCloneInstance(originalId) {
		// Get the next instance number for a given original element
		if (!mapDragState.nextCloneInstance.has(originalId)) {
			mapDragState.nextCloneInstance.set(originalId, 1);
		}
		let instance = mapDragState.nextCloneInstance.get(originalId);
		mapDragState.nextCloneInstance.set(originalId, instance + 1);
		return instance;
	}

	function generateCloneId(originalId, isOrg = false, isPerson = false) {
		let prefix = isPerson ? 'perclone' : (isOrg ? 'orgclone' : 'mapclone');
		let numericId = originalId.replace('map', '').replace('bar', '').replace('per', '');
		let instance = getNextCloneInstance(originalId);
		return `${prefix}${numericId}-${instance}`;
	}

	function registerClone(originalId, cloneId) {
		// Track the relationship between original and clone
		if (!mapDragState.originalToClones.has(originalId)) {
			mapDragState.originalToClones.set(originalId, new Set());
		}
		mapDragState.originalToClones.get(originalId).add(cloneId);
		mapDragState.cloneToOriginal.set(cloneId, originalId);
	}

	function unregisterClone(cloneId) {
		let originalId = mapDragState.cloneToOriginal.get(cloneId);
		if (originalId) {
			let clones = mapDragState.originalToClones.get(originalId);
			if (clones) {
				clones.delete(cloneId);
				if (clones.size === 0) {
					mapDragState.originalToClones.delete(originalId);
				}
			}
			mapDragState.cloneToOriginal.delete(cloneId);
		}

		// Always update the glow state for the original element
		if (originalId) {
			updateOriginalElementGlow(originalId);
		}
	}

	function getCloneCountForOriginal(originalId) {
		// Get the number of clones for an original element
		let clones = mapDragState.originalToClones.get(originalId);
		return clones ? clones.size : 0;
	}

	function getAllClonesForOriginal(originalId) {
		// Get all clone IDs for an original element
		return mapDragState.originalToClones.get(originalId) || new Set();
	}

	function hasAnyClone(originalId) {
		// Check if an original element has any clones
		return getCloneCountForOriginal(originalId) > 0;
	}

	function getOriginalIdFromClone(cloneId) {
		let match = cloneId.match(/^(map|org|per)clone(\d+)(-\d+)?$/);
		if (match) {
			let prefix = match[1] === 'org' ? 'bar' : (match[1] === 'per' ? 'per' : 'map');
			return prefix + match[2];
		}
		return null;
	}

	function getNumericIdFromClone(cloneId) {
		let match = cloneId.match(/^(?:map|org|per)clone(\d+)(?:-\d+)?$/);
		return match ? match[1] : null;
	}

	function getOrCreateGroupId() {
		mapDragState.nextGroupId++;
		let groupId = 'group-' + mapDragState.nextGroupId;
		return groupId;
	}

	function assignGroupToClones(cloneIds, groupId) {
		if (!mapDragState.groupMembers.has(groupId)) {
			mapDragState.groupMembers.set(groupId, new Set());
		}
		
		let groupSet = mapDragState.groupMembers.get(groupId);
		cloneIds.forEach(cloneId => {
			mapDragState.cloneGroups.set(cloneId, groupId);
			groupSet.add(cloneId);
		});
	}

	function getGroupMembers(cloneId) {
		let groupId = mapDragState.cloneGroups.get(cloneId);
		if (!groupId) return new Set([cloneId]);
		return mapDragState.groupMembers.get(groupId) || new Set([cloneId]);
	}

	function removeFromGroup(cloneId) {
		let groupId = mapDragState.cloneGroups.get(cloneId);
		if (groupId) {
			let groupSet = mapDragState.groupMembers.get(groupId);
			if (groupSet) {
				groupSet.delete(cloneId);
				
				// If group is empty, delete it and clean up visuals
				if (groupSet.size === 0) {
					mapDragState.groupMembers.delete(groupId);
					cleanupArrangementVisuals(groupId);
					d3.selectAll(`.group-background[data-group-id="${groupId}"]`).remove();
					d3.selectAll(`.proximity-boundary[data-group-id="${groupId}"]`).remove();
					d3.selectAll(`.group-name-label[data-group-id="${groupId}"]`).remove();
					d3.selectAll(`.group-rotate-handle[data-group-id="${groupId}"]`).remove();
					mapDragState.groupNames.delete(groupId);
					mapDragState.groupRotations.delete(groupId);
					if (mapDragState.groupOriginalPositions) {
						mapDragState.groupOriginalPositions.delete(groupId);
					}					
				} else {
					// Re-arrange remaining elements to fill the gap
					rearrangeGroupAfterRemoval(groupId);
				}
			}
			mapDragState.cloneGroups.delete(cloneId);
		}
	}

	function rearrangeGroupAfterRemoval(groupId) {
		let members = mapDragState.groupMembers.get(groupId);
		if (!members || members.size === 0) return;
		
		// Get the current arrangement type for this group
		let arrangement = mapDragState.groupArrangements?.get(groupId) || 'preserve';
		
		// Calculate current center of remaining elements
		let centerX = 0, centerY = 0, count = 0;
		members.forEach(cloneId => {
			let element = document.querySelector(`[clone-id="${cloneId}"]`);
			if (element) {
				let cx, cy;
				if (element.tagName === 'rect') {
					cx = parseFloat(d3.select(element).attr('x')) + 8;
					cy = parseFloat(d3.select(element).attr('y')) + 8;
				} else {
					cx = parseFloat(d3.select(element).attr('cx'));
					cy = parseFloat(d3.select(element).attr('cy'));
				}
				centerX += cx;
				centerY += cy;
				count++;
			}
		});
		
		if (count === 0) return;
		centerX /= count;
		centerY /= count;
		
		// Re-apply the arrangement to close gaps
		arrangeGroupVisually(groupId, arrangement);
		
		// Update visuals after rearrangement
		setTimeout(() => {
			drawGroupBackground(groupId);
			drawProximityBoundary(groupId, false);
			updateGroupNameLabelPosition(groupId);
			updateGroupRotateHandlePosition(groupId);
		}, 350);
	}

	function arrangeBridge(viewGroups, centerX, centerY, groupId) {
		let mapElements = [];
		let orgElements = [];
		
		viewGroups.forEach((elements, viewType) => {
			if (viewType === 'map') {
				mapElements = Array.from(elements);
			} else if (viewType === 'org') {
				orgElements = Array.from(elements);
			}
		});
		
		console.log('=== arrangeBridge ===');
		console.log('Map elements:', mapElements.length);
		console.log('Org elements:', orgElements.length);
		
		if (mapElements.length === 0 || orgElements.length === 0) {
			arrangeRadial(viewGroups, centerX, centerY);
			return;
		}
		
		let columnSpacing = 150;
		let rowSpacing = 35;
		let leftColumnX = centerX - columnSpacing / 2;
		let rightColumnX = centerX + columnSpacing / 2;
		
		let maxElements = Math.max(mapElements.length, orgElements.length);
		let mapStartY = centerY - ((mapElements.length - 1) * rowSpacing / 2);
		let orgStartY = centerY - ((orgElements.length - 1) * rowSpacing / 2);
		
		let mapLabelY = centerY - (maxElements * rowSpacing / 2) - 25;
		let orgLabelY = centerY - (maxElements * rowSpacing / 2) - 25;
		
		drawBridgeBackground(centerX, centerY, columnSpacing, maxElements * rowSpacing + 50, groupId);
		drawViewLabel("MAP", leftColumnX, mapLabelY, groupId);
		drawViewLabel("ORG", rightColumnX, orgLabelY, groupId);
		
		if (!mapDragState.bridgeLabelData) {
			mapDragState.bridgeLabelData = new Map();
		}
		
		mapDragState.bridgeLabelData.set(groupId, {
			mapLabelOffset: { x: leftColumnX - centerX, y: mapLabelY - centerY },
			orgLabelOffset: { x: rightColumnX - centerX, y: orgLabelY - centerY },
			columnSpacing: columnSpacing,
			rowSpacing: rowSpacing,
			backgroundOffset: { 
				x: centerX, 
				y: centerY,
				width: columnSpacing + 60,
				height: maxElements * rowSpacing + 70
			}
		});
		
		mapElements.forEach((element, index) => {
			let y = mapStartY + (index * rowSpacing);
			animateCloneToPosition(element, leftColumnX, y);
		});
		
		orgElements.forEach((element, index) => {
			let y = orgStartY + (index * rowSpacing);
			animateCloneToPosition(element, rightColumnX, y);
		});
		
		setTimeout(() => {
			drawBridgeConnectionsFromData(groupId);
		}, 400);
	}

	function drawArrangementConnections(groupId, className = 'arrangement-connection', color = '#e63946') {
		let canvas = d3.select('#line-canvas');
		canvas.selectAll(`.${className}-${groupId}`).remove();
		
		let members = mapDragState.groupMembers.get(groupId);
		if (!members) return;
		
		let connections = getConnectionsBetweenClones(members);
		
		connections.forEach(conn => {
			let sourceX, sourceY, targetX, targetY;
			
			if (conn.sourceElement.tagName === 'rect') {
				sourceX = parseFloat(d3.select(conn.sourceElement).attr('x')) + 8;
				sourceY = parseFloat(d3.select(conn.sourceElement).attr('y')) + 8;
			} else {
				sourceX = parseFloat(d3.select(conn.sourceElement).attr('cx'));
				sourceY = parseFloat(d3.select(conn.sourceElement).attr('cy'));
			}
			
			if (conn.targetElement.tagName === 'rect') {
				targetX = parseFloat(d3.select(conn.targetElement).attr('x')) + 8;
				targetY = parseFloat(d3.select(conn.targetElement).attr('y')) + 8;
			} else {
				targetX = parseFloat(d3.select(conn.targetElement).attr('cx'));
				targetY = parseFloat(d3.select(conn.targetElement).attr('cy'));
			}
			
			canvas.append('line')
				.attr('class', `${className} ${className}-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-source', conn.source)
				.attr('data-target', conn.target)
				.attr('x1', sourceX)
				.attr('y1', sourceY)
				.attr('x2', targetX)
				.attr('y2', targetY)
				.style('stroke', color)
				.style('stroke-width', '2.5px')
				.style('stroke-opacity', '0.8')
				.style('pointer-events', 'none');
			
			let midX = (sourceX + targetX) / 2;
			let midY = (sourceY + targetY) / 2;
			
			canvas.append('circle')
				.attr('class', `${className} ${className}-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('cx', midX)
				.attr('cy', midY)
				.attr('r', 4)
				.style('fill', color)
				.style('stroke', 'white')
				.style('stroke-width', '1px')
				.style('pointer-events', 'none');
		});
	}

	function drawBridgeConnectionsFromData(groupId) {
		let canvas = d3.select('#line-canvas');
		canvas.selectAll(`.bridge-connection-${groupId}`).remove();

		let members = mapDragState.groupMembers.get(groupId);
		if (!members) {
			console.log('No members found for group:', groupId);
			return;
		}

		// Get current column order
		let viewOrder = mapDragState.bipartiteViewOrder?.get(groupId);
		if (!viewOrder) {
			// Fallback: build order from members
			let viewTypes = new Set();
			members.forEach(cloneId => {
				let element = document.querySelector(`[clone-id="${cloneId}"]`);
				if (element) {
					viewTypes.add(element.getAttribute('source-view') || 'map');
				}
			});
			viewOrder = Array.from(viewTypes);
		}

		// Build a map of viewType -> column index
		let columnIndex = new Map();
		viewOrder.forEach((vt, idx) => columnIndex.set(vt, idx));

		let connections = getConnectionsBetweenClones(members);
		console.log('Drawing', connections.length, 'bridge connections');

		// Get center Y for arc direction decisions
		let labelData = mapDragState.bridgeLabelData?.get(groupId);
		let bgCenterY = labelData ? labelData.backgroundOffset.y : 0;

		connections.forEach((conn) => {
			let sourceX, sourceY, targetX, targetY;

			if (conn.sourceElement.tagName === 'rect') {
				sourceX = parseFloat(d3.select(conn.sourceElement).attr('x')) + 8;
				sourceY = parseFloat(d3.select(conn.sourceElement).attr('y')) + 8;
			} else {
				sourceX = parseFloat(d3.select(conn.sourceElement).attr('cx'));
				sourceY = parseFloat(d3.select(conn.sourceElement).attr('cy'));
			}

			if (conn.targetElement.tagName === 'rect') {
				targetX = parseFloat(d3.select(conn.targetElement).attr('x')) + 8;
				targetY = parseFloat(d3.select(conn.targetElement).attr('y')) + 8;
			} else {
				targetX = parseFloat(d3.select(conn.targetElement).attr('cx'));
				targetY = parseFloat(d3.select(conn.targetElement).attr('cy'));
			}

			// Determine which columns source and target belong to
			let sourceView = conn.sourceElement.getAttribute('source-view') || 'map';
			let targetView = conn.targetElement.getAttribute('source-view') || 'map';
			let sourceCol = columnIndex.get(sourceView) ?? 0;
			let targetCol = columnIndex.get(targetView) ?? 0;
			let columnsSkipped = Math.abs(sourceCol - targetCol);

			if (columnsSkipped <= 1) {
				// === ADJACENT: straight line ===
				let lineStartX, lineEndX;
				if (sourceX < targetX) {
					lineStartX = sourceX + 12;
					lineEndX = targetX - 12;
				} else if (sourceX > targetX) {
					lineStartX = sourceX - 12;
					lineEndX = targetX + 12;
				} else {
					lineStartX = sourceX;
					lineEndX = targetX;
				}

				canvas.append('line')
					.attr('class', `bridge-connection bridge-connection-${groupId}`)
					.attr('data-group-id', groupId)
					.attr('data-source', conn.source)
					.attr('data-target', conn.target)
					.attr('data-conn-type', 'adjacent')
					.attr('x1', lineStartX)
					.attr('y1', sourceY)
					.attr('x2', lineEndX)
					.attr('y2', targetY)
					.style('stroke', '#e63946')
					.style('stroke-width', '2.5px')
					.style('stroke-opacity', '0.8')
					.style('pointer-events', 'none');

				let midX = (lineStartX + lineEndX) / 2;
				let midY = (sourceY + targetY) / 2;

				canvas.append('circle')
					.attr('class', `bridge-connection bridge-connection-${groupId}`)
					.attr('data-group-id', groupId)
					.attr('cx', midX)
					.attr('cy', midY)
					.attr('r', 4)
					.style('fill', '#e63946')
					.style('stroke', 'white')
					.style('stroke-width', '1px')
					.style('pointer-events', 'none');

			} else {
				// === NON-ADJACENT: curved arc ===
				let midX = (sourceX + targetX) / 2;
				let avgY = (sourceY + targetY) / 2;

				// Arc away from center to avoid crossing middle column
				let arcDirection = avgY < bgCenterY ? -1 : 1;
				let arcStrength = 40 + (columnsSkipped * 20);
				let controlY = Math.min(sourceY, targetY) + (arcDirection * -arcStrength);

				// Offset start/end points
				let startX = sourceX < targetX ? sourceX + 12 : sourceX - 12;
				let endX = sourceX < targetX ? targetX - 12 : targetX + 12;

				canvas.append('path')
					.attr('class', `bridge-connection bridge-connection-${groupId}`)
					.attr('data-group-id', groupId)
					.attr('data-source', conn.source)
					.attr('data-target', conn.target)
					.attr('data-conn-type', 'non-adjacent')
					.attr('d', `M ${startX} ${sourceY} Q ${midX} ${controlY} ${endX} ${targetY}`)
					.style('stroke', '#ff9f1c')
					.style('stroke-width', '2px')
					.style('fill', 'none')
					.style('stroke-opacity', '0.6')
					.style('stroke-dasharray', '6,3')
					.style('pointer-events', 'none');

				// Midpoint dot on the curve (approximate at curve peak)
				let dotX = midX;
				let dotY = (sourceY + targetY + controlY * 2) / 4; // approximate quadratic midpoint

				canvas.append('circle')
					.attr('class', `bridge-connection bridge-connection-${groupId}`)
					.attr('data-group-id', groupId)
					.attr('cx', dotX)
					.attr('cy', dotY)
					.attr('r', 3)
					.style('fill', '#ff9f1c')
					.style('stroke', 'white')
					.style('stroke-width', '1px')
					.style('pointer-events', 'none');
			}
		});

		// Re-raise buttons so they stay clickable
		d3.selectAll(`.bridge-reorder-btn-${groupId}`).raise();
	}

	function drawBridgeBackground(centerX, centerY, width, height, groupId) {
		let canvas = d3.select('#line-canvas');
		
		// Create gradient definition
		let defs = canvas.select('defs');
		if (defs.empty()) {
			defs = canvas.append('defs');
		}
		
		// Create unique gradient ID for this group
		let gradientId = `bridgeGradient-${groupId}`;
		defs.selectAll(`#${gradientId}`).remove();
		
		let gradient = defs.append('linearGradient')
			.attr('id', gradientId)
			.attr('x1', '0%')
			.attr('x2', '100%');
		
		gradient.append('stop')
			.attr('offset', '0%')
			.attr('stop-color', 'rgba(100, 149, 237, 0.15)');
		
		gradient.append('stop')
			.attr('offset', '50%')
			.attr('stop-color', 'rgba(150, 150, 200, 0.1)');
		
		gradient.append('stop')
			.attr('offset', '100%')
			.attr('stop-color', 'rgba(100, 149, 237, 0.15)');
		
		// Remove old background for this group
		canvas.selectAll(`.bridge-background-${groupId}`).remove();
		
		// Draw the background as a RECTANGLE (not polygon)
		canvas.insert('rect', ':first-child')
			.attr('class', `bridge-background bridge-background-${groupId}`)
			.attr('data-group-id', groupId)
			.attr('x', centerX - width / 2 - 20)
			.attr('y', centerY - height / 2 - 10)
			.attr('width', width + 40)
			.attr('height', height + 20)
			.attr('rx', 8)  // Rounded corners
			.attr('ry', 8)
			.style('fill', `url(#${gradientId})`)
			.style('stroke', 'rgba(100, 149, 237, 0.4)')
			.style('stroke-width', '2px')
			.style('pointer-events', 'none');
	}

	function drawViewLabel(text, x, y, groupId) {
		let canvas = d3.select('#line-canvas');
		
		// Remove old label if exists for this group
		canvas.selectAll(`.bridge-label-${text.toLowerCase()}-${groupId}`).remove();
		
		let label = canvas.append('text')
			.attr('class', `bridge-label bridge-label-${text.toLowerCase()} bridge-label-${groupId}`)
			.attr('data-group-id', groupId)
			.attr('data-orig-x', x)
			.attr('data-orig-y', y)
			.attr('x', x)
			.attr('y', y)
			.attr('text-anchor', 'middle')
			.style('fill', 'rgba(100, 149, 237, 0.8)')
			.style('font-size', '11px')
			.style('font-weight', 'bold')
			.style('font-family', 'Arial, sans-serif')
			.style('letter-spacing', '1px')
			.style('pointer-events', 'none')  // Important!
			.text(text);
		
		return label;
	}

	function drawBridgeConnections(mapElements, orgElements, leftX, rightX, 
								   mapStartY, orgStartY, rowSpacing, groupId) {
		let canvas = d3.select('#line-canvas');
		
		// Remove old bridge connections for this group
		canvas.selectAll(`.bridge-connection-${groupId}`).remove();
		
		// Draw connections between related elements
		mapElements.forEach((mapEl, mapIdx) => {
			let mapCloneId = mapEl.getAttribute('clone-id');
			let mapNumericId = getNumericIdFromClone(mapCloneId);
			let mapY = mapStartY + (mapIdx * rowSpacing);
			
			orgElements.forEach((orgEl, orgIdx) => {
				let orgCloneId = orgEl.getAttribute('clone-id');
				let orgNumericId = getNumericIdFromClone(orgCloneId);
				let orgY = orgStartY + (orgIdx * rowSpacing);
				
				let hasConnection = false;
				if (typeof mapcondata !== 'undefined' && mapcondata[orgNumericId]) {
					let connections = mapcondata[orgNumericId]['om'];
					if (connections && connections.split(',').includes(mapNumericId)) {
						hasConnection = true;
					}
				}
				
				if (hasConnection) {
					canvas.insert('line', '.bridge-background + *')
						.attr('class', `bridge-connection bridge-connection-${groupId}`)
						.attr('data-group-id', groupId)
						.attr('x1', leftX + 12)
						.attr('y1', mapY)
						.attr('x2', rightX - 12)
						.attr('y2', orgY)
						.style('stroke', 'rgba(255, 165, 0, 0.4)')
						.style('stroke-width', '1.5px')
						.style('stroke-dasharray', '3,3')
						.style('pointer-events', 'none');
					
					let midX = (leftX + rightX) / 2;
					let midY = (mapY + orgY) / 2;
					
					canvas.insert('circle', '.bridge-background + *')
						.attr('class', `bridge-connection bridge-connection-${groupId}`)
						.attr('data-group-id', groupId)
						.attr('cx', midX)
						.attr('cy', midY)
						.attr('r', 2)
						.style('fill', 'rgba(255, 165, 0, 0.6)')
						.style('pointer-events', 'none');
				}
			});
		});
	}

	// Clean up bridge visualization when arrangement changes
	function cleanupBridgeVisualization() {
		d3.selectAll('.bridge-background').remove();
		d3.selectAll('.bridge-label').remove();
		d3.selectAll('.bridge-connection').remove();
	}

	function updateArrangementVisualsOnDrag(groupId) {
		let members = mapDragState.groupMembers.get(groupId);
		if (!members || members.size === 0) return;
		
		// Calculate new center
		let centerX = 0, centerY = 0, count = 0;
		members.forEach(cloneId => {
			let element = document.querySelector(`[clone-id="${cloneId}"]`);
			if (element) {
				let cx, cy;
				if (element.tagName === 'rect') {
					cx = parseFloat(d3.select(element).attr('x')) + 8;
					cy = parseFloat(d3.select(element).attr('y')) + 8;
				} else {
					cx = parseFloat(d3.select(element).attr('cx'));
					cy = parseFloat(d3.select(element).attr('cy'));
				}
				centerX += cx;
				centerY += cy;
				count++;
			}
		});
		
		if (count === 0) return;
		centerX /= count;
		centerY /= count;
		
		// Update connection lines
		updateConnectionLinePositions(groupId);
		
		// Update bridge-specific visuals
		updateBridgeVisualsOnDrag(groupId, centerX, centerY);
		
		// Update other arrangement visuals
		updateForceVisualsOnDrag(groupId);
		updateMatrixVisualsOnDrag(groupId, centerX, centerY);
		updateVennVisualsOnDrag(groupId, centerX, centerY);
		updateClusterVisualsOnDrag(groupId);
		updateTimelineVisualsOnDrag(groupId, centerX, centerY);
		updateSunburstVisualsOnDrag(groupId, centerX, centerY);
	}

	function updateConnectionLinePositions(groupId) {
		let canvas = d3.select('#line-canvas');
		
		// Update all connection types
		let connectionClasses = [
			'bridge-connection',
			'force-link', 
			'venn-connection',
			'cluster-connection',
			'arrangement-connection'
		];
		
		connectionClasses.forEach(className => {
			canvas.selectAll(`.${className}-${groupId}`).each(function() {
				let line = d3.select(this);
				
				if (this.tagName === 'line') {
					let sourceId = line.attr('data-source');
					let targetId = line.attr('data-target');
					
					if (sourceId && targetId) {
						let sourceElement = document.querySelector(`[clone-id="${sourceId}"]`);
						let targetElement = document.querySelector(`[clone-id="${targetId}"]`);
						
						if (sourceElement && targetElement) {
							let sourceX, sourceY, targetX, targetY;
							
							if (sourceElement.tagName === 'rect') {
								sourceX = parseFloat(d3.select(sourceElement).attr('x')) + 8;
								sourceY = parseFloat(d3.select(sourceElement).attr('y')) + 8;
							} else {
								sourceX = parseFloat(d3.select(sourceElement).attr('cx'));
								sourceY = parseFloat(d3.select(sourceElement).attr('cy'));
							}
							
							if (targetElement.tagName === 'rect') {
								targetX = parseFloat(d3.select(targetElement).attr('x')) + 8;
								targetY = parseFloat(d3.select(targetElement).attr('y')) + 8;
							} else {
								targetX = parseFloat(d3.select(targetElement).attr('cx'));
								targetY = parseFloat(d3.select(targetElement).attr('cy'));
							}
							
							// Add offset for bridge connections
							if (className === 'bridge-connection') {
								if (sourceX < targetX) {
									sourceX += 12;
									targetX -= 12;
								} else if (sourceX > targetX) {
									sourceX -= 12;
									targetX += 12;
								}
							}
							
							line.attr('x1', sourceX)
								.attr('y1', sourceY)
								.attr('x2', targetX)
								.attr('y2', targetY);
						}
					}
				} else if (this.tagName === 'circle' && line.attr('data-source')) {
					// This is a midpoint circle - need special handling
				}
			});
		});
		
		// Update midpoint circles separately
		updateMidpointCircles(groupId);
	}

	function updateMidpointCircles(groupId) {
		let canvas = d3.select('#line-canvas');
		
		let connectionClasses = [
			'bridge-connection',
			'force-link',
			'venn-connection', 
			'cluster-connection',
			'arrangement-connection'
		];
		
		connectionClasses.forEach(className => {
			// Get all lines and their positions
			let lines = [];
			canvas.selectAll(`line.${className}-${groupId}`).each(function() {
				let line = d3.select(this);
				lines.push({
					x1: parseFloat(line.attr('x1')),
					y1: parseFloat(line.attr('y1')),
					x2: parseFloat(line.attr('x2')),
					y2: parseFloat(line.attr('y2'))
				});
			});
			
			// Update circles to midpoints
			let circleIndex = 0;
			canvas.selectAll(`circle.${className}-${groupId}`).each(function() {
				if (circleIndex < lines.length) {
					let line = lines[circleIndex];
					let midX = (line.x1 + line.x2) / 2;
					let midY = (line.y1 + line.y2) / 2;
					
					d3.select(this)
						.attr('cx', midX)
						.attr('cy', midY);
					
					circleIndex++;
				}
			});
		});
	}

	function mapDragStart(d) {
		mapDragState.isDragging = false;
		mapDragState.dragOccurred = false;
		mapDragState.startPos = { x: d3.event.x, y: d3.event.y };
		mapDragState.originalElement = this;
		mapDragState.isMultiDrag = false;
		mapDragState.cloneGroup = [];
		
		let thisId = this.getAttribute('map-id');
		if (mapDragState.selectedElements.has(thisId) && mapDragState.selectedElements.size > 1) {
			mapDragState.isMultiDrag = true;
		}
	}

	function mapDragElement(d) {
		let ele = this;
		let mapid = ele.getAttribute('map-id');
		let name = ele.getAttribute('data-name');
		let location = ele.getAttribute('data-location');
		
		let distance = Math.sqrt(
			Math.pow(d3.event.x - mapDragState.startPos.x, 2) + 
			Math.pow(d3.event.y - mapDragState.startPos.y, 2)
		);
		
		if (distance > mapDragState.dragThreshold && !mapDragState.isDragging) {
			mapDragState.isDragging = true;
			mapDragState.dragOccurred = true;
			
			let boardg = d3.select('#line-canvas');
			let leftOffset = document.getElementById('leftplace').offsetWidth;
			
			if (mapDragState.isMultiDrag) {
				let selectedArray = Array.from(mapDragState.selectedElements);
				
				selectedArray.forEach((selectedId, index) => {
					let selectedEle = document.getElementById(selectedId);
					if (!selectedEle) return;
					
					let eleRect = selectedEle.getBoundingClientRect();
					let canvasX = eleRect.x - leftOffset + (eleRect.width / 2);
					let canvasY = eleRect.y + (eleRect.height / 2);
					
					let selectedName = selectedEle.getAttribute('data-name');
					let selectedMapId = selectedEle.getAttribute('map-id');
					
					let clone = boardg.append("circle")
						.attr("cx", canvasX)
						.attr("cy", canvasY)
						.attr("r", 10)
						.attr("id", 'mapclone' + selectedMapId.slice(3))
						.attr("data-name", selectedName)
						.attr("map-id", selectedMapId + '-clone')
						.attr("original-id", selectedMapId)
						.style("fill", d3.select(selectedEle).style("fill"))
						.style("stroke", "orange")
						.style("stroke-width", "3px")
						.style("opacity", "0.8")
						.style("cursor", "move");
					
					let elasticBand = boardg.append("line")
						.attr("id", 'elastic' + selectedMapId.slice(3))
						.attr("class", "elastic-band")
						.attr("x1", canvasX)
						.attr("y1", canvasY)
						.attr("x2", canvasX)
						.attr("y2", canvasY);
					
					boardg.append("text")
						.attr("x", canvasX)
						.attr("y", canvasY - 12)
						.attr("id", 'mapclonetext' + selectedMapId.slice(3))
						.attr("text-anchor", "middle")
						.style("fill", "white")
						.style("font-size", "10px")
						.style("font-weight", "bold")
						.style("pointer-events", "none")
						.style("text-shadow", "1px 1px 2px black")
						.text(selectedName);
					
					mapDragState.cloneGroup.push({
						clone: clone,
						elasticBand: elasticBand,
						originalElement: selectedEle,
						offsetX: canvasX - (d3.event.sourceEvent.clientX - leftOffset),
						offsetY: canvasY - d3.event.sourceEvent.clientY
					});
				});
				
			} else {
				let eleRect = ele.getBoundingClientRect();
				let canvasX = eleRect.x - leftOffset + (eleRect.width / 2);
				let canvasY = eleRect.y + (eleRect.height / 2);
				
				mapDragState.currentClone = boardg.append("circle")
					.attr("cx", canvasX)
					.attr("cy", canvasY)
					.attr("r", 10)
					.attr("id", 'mapclone' + mapid.slice(3))
					.attr("data-name", name)
					.attr("map-id", mapid + '-clone')
					.style("fill", d3.select(ele).style("fill"))
					.style("stroke", "orange")
					.style("stroke-width", "3px")
					.style("opacity", "0.8")
					.style("cursor", "move");
				
				boardg.append("line")
					.attr("id", 'elastic' + mapid.slice(3))
					.attr("class", "elastic-band")
					.attr("x1", canvasX)
					.attr("y1", canvasY)
					.attr("x2", canvasX)
					.attr("y2", canvasY);
				
				boardg.append("text")
					.attr("x", canvasX)
					.attr("y", canvasY - 12)
					.attr("id", 'mapclonetext' + mapid.slice(3))
					.attr("text-anchor", "middle")
					.style("fill", "white")
					.style("font-size", "10px")
					.style("font-weight", "bold")
					.style("pointer-events", "none")
					.style("text-shadow", "1px 1px 2px black")
					.text(name);
				
				mapDragState.offsetX = canvasX - (d3.event.sourceEvent.clientX - leftOffset);
				mapDragState.offsetY = canvasY - d3.event.sourceEvent.clientY;
			}
		}
		
		if (mapDragState.isDragging) {
			let leftOffset = document.getElementById('leftplace').offsetWidth;
			
			if (mapDragState.isMultiDrag) {
				mapDragState.cloneGroup.forEach(item => {
					let canvasX = d3.event.sourceEvent.clientX - leftOffset + item.offsetX;
					let canvasY = d3.event.sourceEvent.clientY + item.offsetY;
					
					item.clone.attr("cx", canvasX).attr("cy", canvasY);
					
					let originalRect = item.originalElement.getBoundingClientRect();
					let origX = originalRect.x - leftOffset + (originalRect.width / 2);
					let origY = originalRect.y + (originalRect.height / 2);
					
					item.elasticBand
						.attr("x1", origX)
						.attr("y1", origY)
						.attr("x2", canvasX)
						.attr("y2", canvasY);
					
					let cloneId = item.clone.attr('id').replace('mapclone', '');
					d3.select('#mapclonetext' + cloneId)
						.attr("x", canvasX)
						.attr("y", canvasY - 12);
				});
				
				// NEW: Check proximity for multi-drag
				if (mapDragState.cloneGroup.length > 0) {
					let firstItem = mapDragState.cloneGroup[0];
					let checkX = parseFloat(firstItem.clone.attr('cx'));
					let checkY = parseFloat(firstItem.clone.attr('cy'));
					
					let draggedIsOrg = false;
					
					let nearbyGroup = checkProximityToGroups(checkX, checkY, null);
					
					if (nearbyGroup !== mapDragState.currentProximityGroup) {
						if (mapDragState.currentProximityGroup) {
							drawProximityBoundary(mapDragState.currentProximityGroup, false);
						}
						if (nearbyGroup) {
							drawProximityBoundary(nearbyGroup, true);
						}
						mapDragState.currentProximityGroup = nearbyGroup;
					}
				}
				
			} else {
				let canvasX = d3.event.sourceEvent.clientX - leftOffset + mapDragState.offsetX;
				let canvasY = d3.event.sourceEvent.clientY + mapDragState.offsetY;
				
				mapDragState.currentClone.attr("cx", canvasX).attr("cy", canvasY);
				
				let eleRect = ele.getBoundingClientRect();
				let origX = eleRect.x - leftOffset + (eleRect.width / 2);
				let origY = eleRect.y + (eleRect.height / 2);
				
				d3.select('#elastic' + mapid.slice(3))
					.attr("x1", origX)
					.attr("y1", origY)
					.attr("x2", canvasX)
					.attr("y2", canvasY);
				
				d3.select('#mapclonetext' + mapid.slice(3))
					.attr("x", canvasX)
					.attr("y", canvasY - 12);
				
				// NEW: Check proximity for single drag
				let draggedIsOrg = false;
				let nearbyGroup = checkProximityToGroups(canvasX, canvasY, null);
				
				if (nearbyGroup !== mapDragState.currentProximityGroup) {
					if (mapDragState.currentProximityGroup) {
						drawProximityBoundary(mapDragState.currentProximityGroup, false);
					}
					if (nearbyGroup) {
						drawProximityBoundary(nearbyGroup, true);
					}
					mapDragState.currentProximityGroup = nearbyGroup;
				}
			}
		}
	}

	function ensureAllClonesHaveGlow() {
		// Step 1: Update elastic band visibility for every clone in the DOM
		d3.selectAll('.map-permanent-clone, .org-permanent-clone, .per-permanent-clone').each(function () {
			let cloneId = this.getAttribute('clone-id');
			if (!cloneId) return;

			let isGrayedOut = this.getAttribute('grayed-out') === 'true';

			// Find elastic band using data-clone-id (most reliable)
			let elasticBand = d3.select(`[data-clone-id="${cloneId}"].elastic-band`);

			// Fallback: try ID-based lookup
            if (elasticBand.empty()) {
                let isOrgClone = cloneId.startsWith('orgclone');
                let isPerClone = cloneId.startsWith('perclone');
                let numericId = getNumericIdFromClone(cloneId);
                let instanceMatch = cloneId.match(/-(\d+)$/);
                let instanceSuffix = instanceMatch ? instanceMatch[0] : '';
                let elasticPrefix = isPerClone ? 'elasticpermanentper' : (isOrgClone ? 'elasticpermanentorg' : 'elasticpermanent');
                elasticBand = d3.select('#' + elasticPrefix + numericId + instanceSuffix);
            }

			if (!elasticBand.empty()) {
				elasticBand.style("display", isGrayedOut ? "none" : "block");
			}
		});

		// Step 2: Build a set of ALL original IDs that currently have clones in the DOM
		let originalsWithClones = new Set();

			d3.selectAll('.map-permanent-clone, .org-permanent-clone, .per-permanent-clone').each(function () {
			let cloneId = this.getAttribute('clone-id');
			if (!cloneId) return;

			let originalId = this.getAttribute('original-id') || getOriginalIdFromClone(cloneId);
			if (originalId) {
				originalsWithClones.add(originalId);

				// Ensure the clone is registered in the tracking maps
				if (!mapDragState.originalToClones.has(originalId)) {
					mapDragState.originalToClones.set(originalId, new Set());
				}
				mapDragState.originalToClones.get(originalId).add(cloneId);
				mapDragState.cloneToOriginal.set(cloneId, originalId);
			}
		});

		// Step 3: Update glow for every original that HAS clones
		originalsWithClones.forEach(originalId => {
			updateOriginalElementGlow(originalId);
		});

		// Step 4: Also update any originals in the tracking map that might
		//         have had their clones removed (cleanup stale entries)
		mapDragState.originalToClones.forEach((clones, originalId) => {
			if (!originalsWithClones.has(originalId)) {
				// This original is tracked but no clones exist in DOM
				updateOriginalElementGlow(originalId); // Will clean up
			}
		});
	}

	function mapDragEnd(d) {
		if (!mapDragState.isDragging) {
			mapDragState.dragOccurred = false;
			mapDragState.currentProximityGroup = null;
			return;
		}
		
		let boardg = d3.select('#line-canvas');
		
		// Get the target group AFTER proximity has been checked during drag
		let targetGroupId = mapDragState.currentProximityGroup;
		
		// If no proximity group was detected during drag, check one final time at drop position
		if (!targetGroupId) {
			if (mapDragState.isMultiDrag && mapDragState.cloneGroup.length > 0) {
				let firstItem = mapDragState.cloneGroup[0];
				let checkX = parseFloat(firstItem.clone.attr('cx'));
				let checkY = parseFloat(firstItem.clone.attr('cy'));
				targetGroupId = checkProximityToGroups(checkX, checkY, null);
			} else if (mapDragState.currentClone) {
				let checkX = parseFloat(mapDragState.currentClone.attr('cx'));
				let checkY = parseFloat(mapDragState.currentClone.attr('cy'));
				targetGroupId = checkProximityToGroups(checkX, checkY, null);
			}
		}
		
		if (mapDragState.isMultiDrag) {
			// Create a group for multiple elements OR merge into existing
			let groupId = targetGroupId || getOrCreateGroupId();
			let cloneIds = [];
			
			// Calculate the centroid of dragged elements to preserve relative positions
			let centroidX = 0, centroidY = 0;
			mapDragState.cloneGroup.forEach(item => {
				centroidX += parseFloat(item.clone.attr('cx'));
				centroidY += parseFloat(item.clone.attr('cy'));
			});
			centroidX /= mapDragState.cloneGroup.length;
			centroidY /= mapDragState.cloneGroup.length;
			
			mapDragState.cloneGroup.forEach(item => {
				let originalMapId = item.originalElement.getAttribute('map-id');
				let originalId = 'map' + originalMapId.slice(3);
				let name = item.originalElement.getAttribute('data-name');
				let location = item.originalElement.getAttribute('data-location');
				let label = item.originalElement.getAttribute('label');
				let sourceView = 'map';
				
				// Generate unique clone ID with instance number
				let finalCloneId = generateCloneId(originalId, false);
				cloneIds.push(finalCloneId);
				
				// Register the clone
				registerClone(originalId, finalCloneId);
				
				// Store the offset from centroid for each clone
				let offsetFromCentroid = {
					x: parseFloat(item.clone.attr('cx')) - centroidX,
					y: parseFloat(item.clone.attr('cy')) - centroidY
				};

				let originalColor = d3.select(item.originalElement).style("fill");
				
				// Extract instance number for element IDs
				let instanceMatch = finalCloneId.match(/-(\d+)$/);
				let instanceSuffix = instanceMatch ? instanceMatch[0] : '';
				let numericId = getNumericIdFromClone(finalCloneId);

				item.clone
					.attr("id", 'mappermanentclone' + numericId + instanceSuffix)
					.attr("data-name", name)
					.attr("data-location", location)
					.attr("label", label)
					.attr("clone-id", finalCloneId)
					.attr("original-id", originalId)
					.attr("source-view", sourceView)
					.attr("offset-x", offsetFromCentroid.x)
					.attr("offset-y", offsetFromCentroid.y)
					.attr("class", "map-permanent-clone")
					.classed('map-selected', false)
					.style("fill", originalColor)                
					.style("stroke", "#4169e1")
					.style("stroke-width", "2px")
					.style("opacity", "1")
					.on("click", handleCloneClick)
					.call(d3.drag()
						.on("start", cloneDragStart)
						.on("drag", cloneDragMove)
						.on("end", cloneDragEnd))
					.on("mouseover", cloneMouseOver)
					.on("mousemove", cloneMouseMove)
					.on("mouseout", cloneMouseOut)
					.on("contextmenu", handleCloneRightClick);
				
				// Update elastic band ID
				let oldElasticId = item.elasticBand.attr('id');
				item.elasticBand
					.attr("id", 'elasticpermanent' + numericId + instanceSuffix)
					.attr("data-clone-id", finalCloneId)
					.style("opacity", "0.4");
				
				// Update text label ID
				d3.select('#mapclonetext' + originalMapId.slice(3))
					.attr("id", 'mapclonetext' + numericId + instanceSuffix)
					.attr("data-clone-id", finalCloneId);
				
				// Apply orange glow to original element
				updateOriginalElementGlow(originalId);

				
				console.log('Created clone:', finalCloneId, 'for original:', originalId);
			});
			
			assignGroupToClones(cloneIds, groupId);
			
			// If merging into existing group, arrange it
			if (targetGroupId) {
				if (!mapDragState.groupArrangements) {
					mapDragState.groupArrangements = new Map();
				}
				let preferredArrangement = mapDragState.groupArrangements.get(groupId) || 'preserve';
				arrangeGroupVisually(groupId, preferredArrangement);
				
				highlightGroup(groupId, true);
				setTimeout(() => highlightGroup(groupId, false), 300);
				
				setTimeout(() => {
					drawGroupBackground(groupId);
					drawProximityBoundary(groupId, false);
				}, 320);
			} else {
				drawGroupBackground(groupId);
				drawProximityBoundary(groupId, false);
			}
			
			clearMapSelection();
		}
		else {
			// Single element drag
			let ele = mapDragState.originalElement;
			let mapid = ele.getAttribute('map-id');
			let originalId = 'map' + mapid.slice(3);
			let name = ele.getAttribute('data-name');
			let location = ele.getAttribute('data-location');
			let label = ele.getAttribute('label');
			let sourceView = 'map';
			
			if (mapDragState.currentClone) {
				// Generate unique clone ID with instance number
				let finalCloneId = generateCloneId(originalId, false);
				
				// Register the clone
				registerClone(originalId, finalCloneId);
				
				let originalColor = d3.select(ele).style("fill");
				
				// Extract instance number for element IDs
				let instanceMatch = finalCloneId.match(/-(\d+)$/);
				let instanceSuffix = instanceMatch ? instanceMatch[0] : '';
				let numericId = getNumericIdFromClone(finalCloneId);
				
				mapDragState.currentClone
					.attr("id", 'mappermanentclone' + numericId + instanceSuffix)
					.attr("data-name", name)
					.attr("data-location", location)
					.attr("label", label)
					.attr("clone-id", finalCloneId)
					.attr("original-id", originalId)
					.attr("source-view", sourceView)
					.attr("class", "map-permanent-clone")
					.classed('map-selected', false)
					.style("fill", originalColor) 
					.style("stroke", "#4169e1")
					.style("stroke-width", "2px")
					.style("opacity", "1")
					.on("click", handleCloneClick)
					.call(d3.drag()
						.on("start", cloneDragStart)
						.on("drag", cloneDragMove)
						.on("end", cloneDragEnd))
					.on("mouseover", cloneMouseOver)
					.on("mousemove", cloneMouseMove)
					.on("mouseout", cloneMouseOut)
					.on("contextmenu", handleCloneRightClick);
				
				// Update elastic band
				d3.select('#elastic' + mapid.slice(3))
					.attr("id", 'elasticpermanent' + numericId + instanceSuffix)
					.attr("data-clone-id", finalCloneId)
					.style("opacity", "0.4");
				
				// Update text label
				d3.select('#mapclonetext' + mapid.slice(3))
					.attr("id", 'mapclonetext' + numericId + instanceSuffix)
					.attr("data-clone-id", finalCloneId);
					
				updateOriginalElementGlow(originalId);

				
				console.log('Created clone:', finalCloneId, 'for original:', originalId);
				
				// Either add to existing group or create new one
				if (targetGroupId) {
					assignGroupToClones([finalCloneId], targetGroupId);
					
					if (!mapDragState.groupArrangements) {
						mapDragState.groupArrangements = new Map();
