	function addAllClusterEntities(group) {
		const leftOffset = document.getElementById('leftplace').offsetWidth;

		// Anchor clone is already in line-canvas SVG space — cx/cy are canvas coords directly
		const anchorClone = group._anchorName ? document.querySelector(
			`.map-permanent-clone[data-name="${group._anchorName}"],
			 .org-permanent-clone[data-name="${group._anchorName}"],
			 .per-permanent-clone[data-name="${group._anchorName}"]`
		) : null;

		let centerX, centerY;
		if (anchorClone) {
			// cx/cy are already SVG canvas coordinates
			if (anchorClone.tagName === 'rect') {
				centerX = parseFloat(anchorClone.getAttribute('x')) + 8;
				centerY = parseFloat(anchorClone.getAttribute('y')) + 8;
			} else {
				centerX = parseFloat(anchorClone.getAttribute('cx'));
				centerY = parseFloat(anchorClone.getAttribute('cy'));
			}
		} else {
			// Fallback: center of the canvas element
			const canvas = document.getElementById('line-canvas');
			const canvasRect = canvas.getBoundingClientRect();
			centerX = (canvasRect.width  / 2);
			centerY = (canvasRect.height / 2);
		}

		// Collect names already on the board to avoid duplicates
		const alreadyOnBoard = new Set();
		d3.selectAll('.map-permanent-clone, .org-permanent-clone, .per-permanent-clone')
			.each(function () {
				const n = this.getAttribute('data-name') || this.getAttribute('label');
				if (n) alreadyOnBoard.add(n.trim().toLowerCase());
			});

		const allEntities = [
			...group.persons.map(n => ({ name: n, type: 'person' })),
			...group.locations.map(n => ({ name: n, type: 'location' })),
			...group.organizations.map(n => ({ name: n, type: 'organization' }))
		].filter(e => !alreadyOnBoard.has(e.name.trim().toLowerCase()));

		if (allEntities.length === 0) {
			if (anchorClone) _pulseClone(anchorClone);
			return;
		}

		// Reuse anchor's group or create a new one
		let targetGroupId = null;
		if (anchorClone) {
			const anchorCloneId = anchorClone.getAttribute('clone-id');
			targetGroupId = anchorCloneId
				? mapDragState.cloneGroups.get(anchorCloneId)
				: null;
		}
		if (!targetGroupId) {
			targetGroupId = getOrCreateGroupId();
			if (anchorClone) {
				const anchorCloneId = anchorClone.getAttribute('clone-id');
				if (anchorCloneId) assignGroupToClones([anchorCloneId], targetGroupId);
			}
		}

		let createdCount = 0;
		const totalToCreate = allEntities.length;

		allEntities.forEach((entity, i) => {
			setTimeout(() => {

				const nameLower = entity.name.toLowerCase();
				let sourceOriginalId = null;
				let isOrg    = false;
				let isPerson = false;

				// Walk every candidate element in the open views
				const candidates = document.querySelectorAll(
					'#bubbleMap circle, #bubbleMap rect, ' +
					'#graphbox circle, #graphbox rect, ' +
					'.organize-data-box rect, .organize-data-box circle, ' +
					'[data-name], [orgname], [label], [personsid], [barid], [map-id]'
				);

				for (const el of candidates) {
					const n = (
						el.getAttribute('data-name')  ||
						el.getAttribute('orgname')     ||
						el.getAttribute('label')       || ''
					).trim().toLowerCase();

					if (n !== nameLower) continue;

					// Determine the stable original-element ID that createAdditionalClone expects
					const elId = el.id || '';

					if (entity.type === 'person' || el.getAttribute('personsid') != null) {
						const pid = el.getAttribute('personsid') || elId.replace('per', '');
						sourceOriginalId = 'per' + pid;
						isPerson = true;

					} else if (
						entity.type === 'organization' ||
						el.getAttribute('barid') != null ||
						el.closest('.organize-data-box')
					) {
						const bid = el.getAttribute('barid') || elId.replace('bar', '');
						sourceOriginalId = 'bar' + bid;
						isOrg = true;

					} else {
						// map / location / default
						const mid = el.getAttribute('map-id') || elId;
						// map-id is like "map5", elId might be "map5" too
						sourceOriginalId = mid.startsWith('map') ? mid : ('map' + mid.replace('map', ''));
					}

					// Verify the element actually exists in the DOM
					if (document.getElementById(sourceOriginalId)) break;

					// ID didn't resolve — try raw el.id
					if (el.id && document.getElementById(el.id)) {
						sourceOriginalId = el.id;
						break;
					}

					sourceOriginalId = null; // reset and keep searching
				}

				if (!sourceOriginalId || !document.getElementById(sourceOriginalId)) {
					createdCount++;
					if (createdCount === totalToCreate) {
						setTimeout(() => _finalizeClusterGroup(targetGroupId, centerX, centerY), 80);
					}
					return;
				}

				// Spawn exactly at the anchor/center so the preserve-arrange
				// can pull them out from there to their natural source positions
				const spawnX = centerX + (Math.random() - 0.5) * 20;
				const spawnY = centerY + (Math.random() - 0.5) * 20;

				createAdditionalClone(
					sourceOriginalId, spawnX, spawnY,
					isOrg, targetGroupId, isPerson
				);

				createdCount++;
				if (createdCount === totalToCreate) {
					setTimeout(() => _finalizeClusterGroup(targetGroupId, centerX, centerY), 80);
				}

			}, i * 60);
		});
	}

	function _pulseClone(el) {
		el.style.transition = 'transform 0.15s ease';
		el.style.transform  = 'scale(1.8)';
		el.style.filter     = 'drop-shadow(0 0 12px #7ec8e3)';
		setTimeout(() => {
			el.style.transform = '';
			setTimeout(() => { el.style.filter = ''; el.style.transition = ''; }, 300);
		}, 300);
	}

	function _finalizeClusterGroup(groupId, centerX, centerY) {
		if (!mapDragState.groupArrangements) mapDragState.groupArrangements = new Map();
		mapDragState.groupArrangements.set(groupId, 'preserve');

		// Force the preserve logic to treat centerX/centerY as the group centroid
		// by temporarily nudging every new clone to exactly that point,
		// then letting arrangeGroupVisually pull them to source-relative positions.
		const members = mapDragState.groupMembers.get(groupId);
		if (members) {
			members.forEach(cloneId => {
				const el = document.querySelector(`[clone-id="${cloneId}"]`);
				if (!el) return;
				// Only nudge clones that are piled on top of each other (within 25px of center)
				let cx, cy;
				if (el.tagName === 'rect') {
					cx = parseFloat(el.getAttribute('x')) + 8;
					cy = parseFloat(el.getAttribute('y')) + 8;
				} else {
					cx = parseFloat(el.getAttribute('cx'));
					cy = parseFloat(el.getAttribute('cy'));
				}
				const dist = Math.sqrt((cx - centerX) ** 2 + (cy - centerY) ** 2);
				if (dist < 30) {
					// Tiny random nudge so preserve can compute relative offsets
					const nx = centerX + (Math.random() - 0.5) * 10;
					const ny = centerY + (Math.random() - 0.5) * 10;
					if (el.tagName === 'rect') {
						el.setAttribute('x', nx - 8);
						el.setAttribute('y', ny - 8);
					} else {
						el.setAttribute('cx', nx);
						el.setAttribute('cy', ny);
					}
				}
			});
		}

		arrangeGroupVisually(groupId, 'preserve');

		setTimeout(() => {
			drawGroupBackground(groupId);
			drawProximityBoundary(groupId, false);
			showAllProximityBoundaries();
			ensureAllClonesHaveGlow();
		}, 420);
	}

