			menuHTML += `<li class="svg-menu-item-matrixreorder-boundary-${groupId} svg-menu-item">⇄ Cycle View Order</li>`;
		}

		// Bipartite reorder if currently in bridge arrangement
		if (arrangementType === 'bridge') {
			menuHTML += `<li class="svg-menu-item-separator" style="border-top:1px solid #ddd; margin:4px 0;"></li>`;
			menuHTML += `<li class="svg-menu-item-bipartitereorder-boundary-${groupId} svg-menu-item">⇄ Cycle Column Order</li>`;
		}

		rightCustomMenu.innerHTML = menuHTML;
		rightCustomMenu.style.display = 'block';
		rightCustomMenu.style.left = d3.event.clientX + 'px';
		rightCustomMenu.style.top = d3.event.clientY + 'px';

		setupBoundaryMenuHandlers(groupId);
	}

