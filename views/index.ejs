	function handleCloneClick() {
		// Check if this was a drag operation
		if (mapDragState.dragOccurred || cloneDragState.dragOccurred || (personDragState && personDragState.dragOccurred)) {
			mapDragState.dragOccurred = false;
			cloneDragState.dragOccurred = false;
			return;
		}
		
		let cloneId = this.getAttribute('clone-id');
		
		// Ctrl+Click or Cmd+Click for multi-select/deselect
		if ((d3.event.ctrlKey || d3.event.metaKey) && d3.event.button === 0) {
			d3.event.stopPropagation();
			d3.event.preventDefault();
			
			// Toggle selection
			if (mapDragState.selectedElements.has(cloneId)) {
				// DESELECT - remove from selection
				mapDragState.selectedElements.delete(cloneId);
				d3.select(this)
					.classed('map-selected', false)
					.style('stroke', '#4169e1')
					.style('stroke-width', '2px');
				console.log('Deselected:', cloneId);
			} else {
				// SELECT - add to selection
				mapDragState.selectedElements.add(cloneId);
				d3.select(this)
					.classed('map-selected', true)
					.style('stroke', '#FFD700')
					.style('stroke-width', '3px');
				console.log('Selected:', cloneId);
			}
			return;
		}
		
		// Regular click (without Ctrl) - clear selection
		if (d3.event.button === 0 && !d3.event.ctrlKey && !d3.event.metaKey) {
			clearAllCloneSelections();
		}
	}

	function isPointInsideBoundary(x, y, boundary) {
		let tagName = boundary.tagName.toLowerCase();
		
		if (tagName === 'circle') {
			let cx = parseFloat(boundary.getAttribute('cx'));
			let cy = parseFloat(boundary.getAttribute('cy'));
			let r = parseFloat(boundary.getAttribute('r'));
			let distance = Math.sqrt(Math.pow(x - cx, 2) + Math.pow(y - cy, 2));
			return distance <= r;
		}
		
		if (tagName === 'ellipse') {
			let cx = parseFloat(boundary.getAttribute('cx'));
			let cy = parseFloat(boundary.getAttribute('cy'));
			let rx = parseFloat(boundary.getAttribute('rx'));
			let ry = parseFloat(boundary.getAttribute('ry'));
			// Check if point is inside ellipse: (x-cx)²/rx² + (y-cy)²/ry² <= 1
			let normalized = Math.pow((x - cx) / rx, 2) + Math.pow((y - cy) / ry, 2);
			return normalized <= 1;
		}
		
		if (tagName === 'rect') {
			let rx = parseFloat(boundary.getAttribute('x'));
			let ry = parseFloat(boundary.getAttribute('y'));
			let width = parseFloat(boundary.getAttribute('width'));
			let height = parseFloat(boundary.getAttribute('height'));
			return x >= rx && x <= rx + width && y >= ry && y <= ry + height;
		}
		
		if (tagName === 'path') {
			// For polygon/path, use SVG's built-in point-in-path check
			let svg = document.getElementById('line-canvas');
			let point = svg.createSVGPoint();
			point.x = x;
			point.y = y;
			return boundary.isPointInFill(point);
		}
		
		return false;
	}

	// Helper function to clear all clone selections
	function clearAllCloneSelections() {
		mapDragState.selectedElements.forEach(cloneId => {
			let element = document.querySelector(`[clone-id="${cloneId}"]`);
			if (element) {
				d3.select(element)
					.classed('map-selected', false)
