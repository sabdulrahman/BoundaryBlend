	function finalizeMatrixPositions(groupId) {
		let matrixData = mapDragState.matrixData?.get(groupId);
		if (!matrixData) return;

		let members = mapDragState.groupMembers.get(groupId);
		if (!members || members.size === 0) return;

		let centerX = 0, centerY = 0, count = 0;
		members.forEach(cloneId => {
			let element = document.querySelector(`[clone-id="${cloneId}"]`);
			if (element) {
				let cx, cy;
				if (element.tagName === 'rect') {
					cx = parseFloat(d3.select(element).attr('x')) + 8;
					cy = parseFloat(d3.select(element).attr('y')) + 8;
				} else {
					cx = parseFloat(d3.select(element).attr('cx'));
					cy = parseFloat(d3.select(element).attr('cy'));
				}
				centerX += cx;
				centerY += cy;
				count++;
			}
		});

		if (count === 0) return;
		centerX /= count;
		centerY /= count;

		matrixData.originalCenter = { x: centerX, y: centerY };

		let canvas = d3.select('#line-canvas');

		// STEP 1: Compute cumulative delta from a reference grid rect BEFORE updating it
		let deltaX = 0, deltaY = 0;
		let refGrid = canvas.select(`.matrix-grid-${groupId}`);
		if (!refGrid.empty()) {
			let refOrigX = parseFloat(refGrid.attr('data-orig-x'));
			let refCurX = parseFloat(refGrid.attr('x'));
			let refOrigY = parseFloat(refGrid.attr('data-orig-y'));
			let refCurY = parseFloat(refGrid.attr('y'));
			if (!isNaN(refOrigX) && !isNaN(refCurX)) {
				deltaX = refCurX - refOrigX;
				deltaY = refCurY - refOrigY;
			}
		}

		// STEP 2: Finalize standard elements (rect, text, line, circle)
		canvas.selectAll(`.matrix-grid-${groupId}, .matrix-cell-${groupId}, .matrix-label-${groupId}`).each(function() {
			let el = d3.select(this);
			if (this.tagName === 'path') return;

			if (this.tagName === 'line') {
				el.attr('data-orig-x', el.attr('x1'))
				  .attr('data-orig-y', el.attr('y1'));
			} else if (this.tagName === 'circle') {
				el.attr('data-orig-x', el.attr('cx'))
				  .attr('data-orig-y', el.attr('cy'));
			} else if (this.tagName === 'rect') {
				el.attr('data-orig-x', el.attr('x'))
				  .attr('data-orig-y', el.attr('y'));
			} else if (this.tagName === 'text') {
				el.attr('data-orig-x', el.attr('x'))
				  .attr('data-orig-y', el.attr('y'));
			}
		});

		// STEP 3: Finalize ribbon paths — shift stored endpoints by the computed delta
		canvas.selectAll(`.matrix-ribbon-${groupId}`).each(function() {
			let el = d3.select(this);
			let rx1 = parseFloat(el.attr('data-ribbon-x1'));
			let ry1 = parseFloat(el.attr('data-ribbon-y1'));
			let rx2 = parseFloat(el.attr('data-ribbon-x2'));
			let ry2 = parseFloat(el.attr('data-ribbon-y2'));

			if (!isNaN(rx1)) {
				el.attr('data-ribbon-x1', rx1 + deltaX);
				el.attr('data-ribbon-y1', ry1 + deltaY);
				el.attr('data-ribbon-x2', rx2 + deltaX);
				el.attr('data-ribbon-y2', ry2 + deltaY);
				el.attr('data-orig-x', rx1 + deltaX);
				el.attr('data-orig-y', ry1 + deltaY);
			}
		});
	}

	function updateMatrixVisualsOnBoundaryDrag(groupId, deltaX, deltaY) {
		let matrixData = mapDragState.matrixData?.get(groupId);
		if (!matrixData) return;

		let canvas = d3.select('#line-canvas');

		// Update grid backgrounds
		canvas.selectAll(`.matrix-grid-${groupId}`).each(function() {
			let el = d3.select(this);
			let origX = parseFloat(el.attr('data-orig-x'));
			let origY = parseFloat(el.attr('data-orig-y'));
			if (!isNaN(origX) && !isNaN(origY)) {
				el.attr('x', origX + deltaX)
				  .attr('y', origY + deltaY);
			}
		});

		// Update cells
		canvas.selectAll(`.matrix-cell-${groupId}`).each(function() {
			let el = d3.select(this);
			let origX = parseFloat(el.attr('data-orig-x'));
			let origY = parseFloat(el.attr('data-orig-y'));
			if (!isNaN(origX) && !isNaN(origY)) {
				if (this.tagName === 'rect') {
					el.attr('x', origX + deltaX).attr('y', origY + deltaY);
				} else if (this.tagName === 'text') {
					el.attr('x', origX + deltaX).attr('y', origY + deltaY);
				}
			}
		});

		// Update labels (text, rect, line, circle — NOT path)
		canvas.selectAll(`.matrix-label-${groupId}`).each(function() {
			let el = d3.select(this);

			// Skip paths — handled separately as ribbons below
			if (this.tagName === 'path') return;

			let origX = parseFloat(el.attr('data-orig-x'));
			let origY = parseFloat(el.attr('data-orig-y'));

			if (!isNaN(origX) && !isNaN(origY)) {
				let newX = origX + deltaX;
				let newY = origY + deltaY;

				if (this.tagName === 'line') {
					let curX1 = parseFloat(el.attr('x1'));
					let curY1 = parseFloat(el.attr('y1'));
					let curX2 = parseFloat(el.attr('x2'));
					let curY2 = parseFloat(el.attr('y2'));
					let dx2 = curX2 - curX1;
					let dy2 = curY2 - curY1;
					el.attr('x1', newX).attr('y1', newY)
					  .attr('x2', newX + dx2).attr('y2', newY + dy2);
				} else if (this.tagName === 'circle') {
					el.attr('cx', newX).attr('cy', newY);
				} else {
					el.attr('x', newX).attr('y', newY);

					let transform = el.attr('transform');
					if (transform && transform.includes('rotate')) {
						let match = transform.match(/rotate\((-?\d+)/);
						if (match) {
							el.attr('transform', `rotate(${match[1]}, ${newX}, ${newY})`);
						}
					}
				}
			}
		});

		// Update ribbons by reconstructing paths from stored endpoints + delta
		canvas.selectAll(`.matrix-ribbon-${groupId}`).each(function() {
			let el = d3.select(this);
			let rx1 = parseFloat(el.attr('data-ribbon-x1'));
			let ry1 = parseFloat(el.attr('data-ribbon-y1'));
			let rx2 = parseFloat(el.attr('data-ribbon-x2'));
			let ry2 = parseFloat(el.attr('data-ribbon-y2'));
			let dir = el.attr('data-ribbon-dir');

			if (isNaN(rx1) || isNaN(ry1) || isNaN(rx2) || isNaN(ry2)) return;

			let nx1 = rx1 + deltaX, ny1 = ry1 + deltaY;
			let nx2 = rx2 + deltaX, ny2 = ry2 + deltaY;

			let ribbonWidth = 7;
			let halfW = ribbonWidth / 2;
			let taperNarrow = halfW * 0.35;
			let d;

			if (dir === 'horizontal') {
				let midX = (nx1 + nx2) / 2;
				d = `M${nx1},${ny1 - halfW} `
				  + `C${midX},${ny1 - halfW} ${midX},${ny2 - taperNarrow} ${nx2},${ny2 - taperNarrow} `
				  + `L${nx2},${ny2 + taperNarrow} `
				  + `C${midX},${ny2 + taperNarrow} ${midX},${ny1 + halfW} ${nx1},${ny1 + halfW} Z`;
			} else if (dir === 'curve') {
				let cp1x = nx1;
				let cp1y = ny1 + (ny2 - ny1) * 0.55;
				let cp2x = nx2;
				let cp2y = ny1 + (ny2 - ny1) * 0.45;
				d = `M${nx1 - halfW},${ny1} `
				  + `C${cp1x - halfW},${cp1y} ${cp2x - taperNarrow},${cp2y} ${nx2 - taperNarrow},${ny2} `
				  + `L${nx2 + taperNarrow},${ny2} `
				  + `C${cp2x + taperNarrow},${cp2y} ${cp1x + halfW},${cp1y} ${nx1 + halfW},${ny1} Z`;
			}

			if (d) el.attr('d', d);
		});
	}

	function updateAllArrangementVisualsExceptMatrix(groupId) {
