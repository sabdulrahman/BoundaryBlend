				const n = this.getAttribute('data-name') || this.getAttribute('label');
				if (n) alreadyOnBoard.push(n);
			});

		const result = getFCASuggestions(entityName, alreadyOnBoard);
		if (result.suggestions.length === 0) { hideFCASuggestionPanel(); return; }

