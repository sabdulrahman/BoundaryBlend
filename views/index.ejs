                    d3.select(this).style("fill", "#485D5E");
                    if(isCloned) {
                        d3.select(this).style("filter", "drop-shadow(0 0 4px orange) drop-shadow(0 0 8px orange)");
                    } else {
                        d3.select(this).style("filter", "none");
                    }
                }
                d3.select(this).style("stroke-width", 1);
                event.target.setAttribute('clicked', false);
            }
        }
    }
    
    // Reappend elements to their parents
    function reappendToParent(selectorPrefix) {
        var elements = $('[id^="' + selectorPrefix + '"]');
        for (let i = 0; i < elements.length; i++) {
            elements[i].parentNode.appendChild(elements[i]);
        }
    }

    reappendToParent("dupcirc");
    reappendToParent("clone");
    reappendToParent("progcloneci");
    reappendToParent("progtextci");
    reappendToParent("progress");		
}

