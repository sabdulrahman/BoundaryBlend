            .attr('title', tooltip)
            .attr('data-perm-index', idx)
            .style('background', isActive
                ? 'linear-gradient(135deg, rgba(230,57,70,0.9), rgba(200,40,60,1))'
                : 'linear-gradient(135deg, rgba(100,149,237,0.7), rgba(70,130,230,0.9))')
            .style('color', 'white')
            .style('border', isActive ? '2px solid #fff' : '1px solid rgba(255,255,255,0.3)')
            .style('border-radius', '4px')
            .style('width', btnSize + 'px')
            .style('height', btnSize + 'px')
            .style('display', 'flex')
            .style('align-items', 'center')
            .style('justify-content', 'center')
            .style('cursor', 'pointer')
