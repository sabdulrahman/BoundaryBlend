	// Organization drag state (add this near the top with mapDragState)
	let orgDragState = {
		isDragging: false,
		dragThreshold: 10,
		startPos: { x: 0, y: 0 },
		currentClone: null,
		originalElement: null,
		selectedElements: new Set(),
		isMultiDrag: false,
		cloneGroup: [],
		dragOccurred: false
	};

	// Organization drag start handler
	function orgBarDragStart(d) {
		orgDragState.isDragging = false;
		orgDragState.dragOccurred = false;
		orgDragState.startPos = { x: d3.event.x, y: d3.event.y };
		orgDragState.originalElement = this;
		orgDragState.isMultiDrag = false;
		orgDragState.cloneGroup = [];

		let thisId = this.getAttribute('barid');
		if (orgDragState.selectedElements.has(thisId) && orgDragState.selectedElements.size > 1) {
			orgDragState.isMultiDrag = true;
		}
	}

	function orgBarDragElement(d) {
		let ele = this;
		let orgid = ele.getAttribute('barid');
		let orgname = ele.getAttribute('orgname');

		let distance = Math.sqrt(
			Math.pow(d3.event.x - orgDragState.startPos.x, 2) +
			Math.pow(d3.event.y - orgDragState.startPos.y, 2)
		);

		// --- Create clones once threshold exceeded ---
		if (distance > orgDragState.dragThreshold && !orgDragState.isDragging) {
			orgDragState.isDragging = true;
			orgDragState.dragOccurred = true;

			let boardg = d3.select('#line-canvas');
			let leftOffset = document.getElementById('leftplace').offsetWidth;

			if (orgDragState.isMultiDrag) {
				let selectedArray = Array.from(orgDragState.selectedElements);

				selectedArray.forEach((selectedId, index) => {
					let selectedEle = document.getElementById('bar' + selectedId);
					if (!selectedEle) return;

					let eleRect = selectedEle.getBoundingClientRect();
					let canvasX = eleRect.x - leftOffset + (eleRect.width / 2);
					let canvasY = eleRect.y + (eleRect.height / 2);

					let selectedName = selectedEle.getAttribute('orgname');

					// Temporary IDs during drag (will be replaced in DragEnd)
					let clone = boardg.append("rect")
						.attr("x", canvasX - 8)
						.attr("y", canvasY - 8)
						.attr("width", 16)
						.attr("height", 16)
						.attr("id", 'orgclonetemp' + selectedId + '-' + index)
						.attr("data-name", selectedName)
						.attr("label", selectedEle.getAttribute('label') || selectedName)
						.style("fill", d3.select(selectedEle).style("fill"))
						.style("stroke", "orange")
						.style("stroke-width", "3px")
						.style("opacity", "0.8")
						.style("cursor", "move");

					let elasticBand = boardg.append("line")
						.attr("id", 'elasticorgtemp' + selectedId + '-' + index)
						.attr("class", "elastic-band")
						.attr("x1", canvasX)
						.attr("y1", canvasY)
						.attr("x2", canvasX)
						.attr("y2", canvasY);

					boardg.append("text")
						.attr("x", canvasX)
						.attr("y", canvasY - 12)
						.attr("id", 'orgclonetexttemp' + selectedId + '-' + index)
						.attr("text-anchor", "middle")
						.style("fill", "white")
						.style("font-size", "10px")
						.style("font-weight", "bold")
						.style("pointer-events", "none")
						.style("text-shadow", "1px 1px 2px black")
						.text(selectedName);

					orgDragState.cloneGroup.push({
						clone: clone,
						elasticBand: elasticBand,
						textLabel: d3.select('#orgclonetexttemp' + selectedId + '-' + index),
						originalElement: selectedEle,
						orgId: selectedId,
						offsetX: canvasX - (d3.event.sourceEvent.clientX - leftOffset),
						offsetY: canvasY - d3.event.sourceEvent.clientY
					});
				});

			} else {
				let eleRect = ele.getBoundingClientRect();
				let canvasX = eleRect.x - leftOffset + (eleRect.width / 2);
				let canvasY = eleRect.y + (eleRect.height / 2);

				orgDragState.currentClone = boardg.append("rect")
					.attr("x", canvasX - 8)
					.attr("y", canvasY - 8)
					.attr("width", 16)
					.attr("height", 16)
					.attr("id", 'orgclonetemp' + orgid)
					.attr("data-name", orgname)
					.attr("label", ele.getAttribute('label') || orgname)
					.style("fill", d3.select(ele).style("fill"))
					.style("stroke", "orange")
					.style("stroke-width", "3px")
					.style("opacity", "0.8")
					.style("cursor", "move");

				boardg.append("line")
					.attr("id", 'elasticorgtemp' + orgid)
					.attr("class", "elastic-band")
					.attr("x1", canvasX)
					.attr("y1", canvasY)
					.attr("x2", canvasX)
					.attr("y2", canvasY);

				orgDragState.currentTextLabel = boardg.append("text")
					.attr("x", canvasX)
					.attr("y", canvasY - 12)
					.attr("id", 'orgclonetexttemp' + orgid)
					.attr("text-anchor", "middle")
					.style("fill", "white")
					.style("font-size", "10px")
					.style("font-weight", "bold")
					.style("pointer-events", "none")
					.style("text-shadow", "1px 1px 2px black")
					.text(orgname);

				orgDragState.currentElasticBand = d3.select('#elasticorgtemp' + orgid);
				orgDragState.offsetX = canvasX - (d3.event.sourceEvent.clientX - leftOffset);
				orgDragState.offsetY = canvasY - d3.event.sourceEvent.clientY;
			}
		}

		// --- Move clones during drag ---
		if (orgDragState.isDragging) {
			let leftOffset = document.getElementById('leftplace').offsetWidth;

			if (orgDragState.isMultiDrag) {
				orgDragState.cloneGroup.forEach(item => {
					let canvasX = d3.event.sourceEvent.clientX - leftOffset + item.offsetX;
					let canvasY = d3.event.sourceEvent.clientY + item.offsetY;

					item.clone.attr("x", canvasX - 8).attr("y", canvasY - 8);

					let originalRect = item.originalElement.getBoundingClientRect();
					let origX = originalRect.x - leftOffset + (originalRect.width / 2);
					let origY = originalRect.y + (originalRect.height / 2);

					item.elasticBand
						.attr("x1", origX)
						.attr("y1", origY)
						.attr("x2", canvasX)
						.attr("y2", canvasY);

					item.textLabel
						.attr("x", canvasX)
						.attr("y", canvasY - 12);
				});

				// Check proximity
				if (orgDragState.cloneGroup.length > 0) {
					let firstItem = orgDragState.cloneGroup[0];
					let checkX = parseFloat(firstItem.clone.attr('x')) + 8;
					let checkY = parseFloat(firstItem.clone.attr('y')) + 8;
					let nearbyGroup = checkProximityToGroups(checkX, checkY, null);

					if (nearbyGroup !== mapDragState.currentProximityGroup) {
						if (mapDragState.currentProximityGroup) {
							drawProximityBoundary(mapDragState.currentProximityGroup, false);
						}
						if (nearbyGroup) {
							drawProximityBoundary(nearbyGroup, true);
						}
						mapDragState.currentProximityGroup = nearbyGroup;
					}
				}

			} else {
				let canvasX = d3.event.sourceEvent.clientX - leftOffset + orgDragState.offsetX;
				let canvasY = d3.event.sourceEvent.clientY + orgDragState.offsetY;

				orgDragState.currentClone.attr("x", canvasX - 8).attr("y", canvasY - 8);

				let eleRect = ele.getBoundingClientRect();
				let origX = eleRect.x - leftOffset + (eleRect.width / 2);
				let origY = eleRect.y + (eleRect.height / 2);

				orgDragState.currentElasticBand
					.attr("x1", origX)
					.attr("y1", origY)
					.attr("x2", canvasX)
					.attr("y2", canvasY);

				orgDragState.currentTextLabel
					.attr("x", canvasX)
					.attr("y", canvasY - 12);

				// Check proximity
				let nearbyGroup = checkProximityToGroups(canvasX, canvasY, null);
				if (nearbyGroup !== mapDragState.currentProximityGroup) {
					if (mapDragState.currentProximityGroup) {
						drawProximityBoundary(mapDragState.currentProximityGroup, false);
					}
					if (nearbyGroup) {
						drawProximityBoundary(nearbyGroup, true);
					}
					mapDragState.currentProximityGroup = nearbyGroup;
				}
			}
		}
	}

	function orgBarDragEnd(d) {
		if (!orgDragState.isDragging) {
			orgDragState.dragOccurred = false;
			mapDragState.currentProximityGroup = null;
			return;
		}

		let boardg = d3.select('#line-canvas');
		let leftOffset = document.getElementById('leftplace').offsetWidth;

		// Get target group from proximity
		let targetGroupId = mapDragState.currentProximityGroup;

		// Final proximity check if none detected during drag
		if (!targetGroupId) {
			if (orgDragState.isMultiDrag && orgDragState.cloneGroup.length > 0) {
				let firstItem = orgDragState.cloneGroup[0];
				let checkX = parseFloat(firstItem.clone.attr('x')) + 8;
				let checkY = parseFloat(firstItem.clone.attr('y')) + 8;
				targetGroupId = checkProximityToGroups(checkX, checkY, null);
			} else if (orgDragState.currentClone) {
				let checkX = parseFloat(orgDragState.currentClone.attr('x')) + 8;
				let checkY = parseFloat(orgDragState.currentClone.attr('y')) + 8;
				targetGroupId = checkProximityToGroups(checkX, checkY, null);
			}
		}

		if (orgDragState.isMultiDrag) {
			// =============================================
			// MULTI-DRAG: finalize all org clones
			// =============================================
			let groupId = targetGroupId || getOrCreateGroupId();
			let cloneIds = [];

			// Calculate centroid
			let centroidX = 0, centroidY = 0;
			orgDragState.cloneGroup.forEach(item => {
				centroidX += parseFloat(item.clone.attr('x')) + 8;
				centroidY += parseFloat(item.clone.attr('y')) + 8;
			});
			centroidX /= orgDragState.cloneGroup.length;
			centroidY /= orgDragState.cloneGroup.length;

			orgDragState.cloneGroup.forEach(item => {
				let numericOrgId = item.orgId;                // e.g. "5"
				let originalId = 'bar' + numericOrgId;        // FIX #2: 'bar' prefix, not 'org'
				let name = item.originalElement.getAttribute('orgname') || '';
				let label = item.originalElement.getAttribute('label') || name;

				// FIX #1: Use generateCloneId for unique IDs
				let finalCloneId = generateCloneId(originalId, true);  // true = isOrg
				cloneIds.push(finalCloneId);

				// FIX #1: Register in tracking system
				registerClone(originalId, finalCloneId);

				let numericId = getNumericIdFromClone(finalCloneId);
				let instanceMatch = finalCloneId.match(/-(\d+)$/);
				let instanceSuffix = instanceMatch ? instanceMatch[0] : '';

				let cx = parseFloat(item.clone.attr('x')) + 8;
				let cy = parseFloat(item.clone.attr('y')) + 8;
				let offsetFromCentroid = { x: cx - centroidX, y: cy - centroidY };
				let originalColor = d3.select(item.originalElement).style("fill");

				// Finalize the clone element
				item.clone
					.attr("id", 'orgpermanentclone' + numericId + instanceSuffix)
					.attr("data-name", name)
					.attr("label", label)
					.attr("clone-id", finalCloneId)            // FIX: unique clone-id
					.attr("original-id", originalId)            // FIX #2: 'bar5' not 'org5'
					.attr("source-view", "org")
					.attr("offset-x", offsetFromCentroid.x)
					.attr("offset-y", offsetFromCentroid.y)
					.attr("class", "org-permanent-clone")
					.classed('map-selected', false)
					.style("fill", originalColor)
					.style("stroke", "#4169e1")
					.style("stroke-width", "2px")
					.style("opacity", "1")
					.on("click", handleCloneClick)
					.call(d3.drag()
						.on("start", cloneDragStart)
						.on("drag", cloneDragMove)
						.on("end", cloneDragEnd))
					.on("mouseover", cloneMouseOver)
					.on("mousemove", cloneMouseMove)
					.on("mouseout", cloneMouseOut)
					.on("contextmenu", handleCloneRightClick);

				// FIX #3: Set data-clone-id on elastic band
				item.elasticBand
					.attr("id", 'elasticpermanentorg' + numericId + instanceSuffix)
					.attr("data-clone-id", finalCloneId)
					.style("opacity", "0.4");

				// FIX #6: Set data-clone-id on text label
				item.textLabel
					.attr("id", 'orgclonetext' + numericId + instanceSuffix)
					.attr("data-clone-id", finalCloneId);

				// FIX #4: Use correct originalId (was undefined before)
				updateOriginalElementGlow(originalId);

				console.log('Created org clone:', finalCloneId, 'for original:', originalId);
			});

			assignGroupToClones(cloneIds, groupId);

			if (targetGroupId) {
				if (!mapDragState.groupArrangements) {
					mapDragState.groupArrangements = new Map();
				}
				let preferredArrangement = mapDragState.groupArrangements.get(groupId) || 'preserve';
				arrangeGroupVisually(groupId, preferredArrangement);

				highlightGroup(groupId, true);
