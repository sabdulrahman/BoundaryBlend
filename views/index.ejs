			let cloneId = cloneEle.getAttribute('clone-id');
			let fullCloneId = cloneId;
			
			// Extract a safe ID for menu items (replace dashes with underscores)
			let safeCloneId = cloneId.replace(/-/g, '_');
			
			let currentGroupId = mapDragState.cloneGroups.get(fullCloneId);
			let originalId = cloneEle.getAttribute('original-id') || getOriginalIdFromClone(cloneId);
			let cloneCount = getCloneCountForOriginal(originalId);
			
			const rightCustomMenu = document.querySelector('.svg-custom-menu');
			
			let menuHTML = `<li class="svg-menu-item-deleteclone-${safeCloneId} svg-menu-item">Delete Clone</li>`;
			
			// Add "Create Another Clone" option
			menuHTML += `<li class="svg-menu-item-createanother-${safeCloneId} svg-menu-item">Create Another Clone (${cloneCount} existing)</li>`;
			
			// Add Gray Out option
			let isGrayedOut = cloneEle.getAttribute('grayed-out') === 'true';
			menuHTML += `<li class="svg-menu-item-togglegray-${safeCloneId} svg-menu-item">${isGrayedOut ? 'Restore Clone Connection' : 'Hide Clone Connection'}</li>`;
			
