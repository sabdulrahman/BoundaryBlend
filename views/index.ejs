	function groupBoundaryDragStart(groupId) {
			groupBoundaryDragState.isDragging = true;
			groupBoundaryDragState.activeGroupId = groupId;
			groupBoundaryDragState.startPos = { x: d3.event.x, y: d3.event.y };
			groupBoundaryDragState.currentDelta = { x: 0, y: 0 };
			groupBoundaryDragState.memberOffsets = [];
			
			let members = mapDragState.groupMembers.get(groupId);
			if (!members) return;
			
			// Store initial positions of all members
			members.forEach(cloneId => {
				let element = document.querySelector(`[clone-id="${cloneId}"]`);
				if (element) {
					let cx, cy;
					if (element.tagName === 'rect') {
						cx = parseFloat(d3.select(element).attr('x')) + 8;
						cy = parseFloat(d3.select(element).attr('y')) + 8;
					} else {
						cx = parseFloat(d3.select(element).attr('cx'));
						cy = parseFloat(d3.select(element).attr('cy'));
					}
					
					groupBoundaryDragState.memberOffsets.push({
						element: element,
						cloneId: cloneId,
						startX: cx,
						startY: cy
					});
				}
			});
			
			// Highlight the group being dragged
			highlightGroup(groupId, true);
		}

	function groupBoundaryDragMove(groupId) {
		if (!groupBoundaryDragState.isDragging) return;
		
		let dx = d3.event.x - groupBoundaryDragState.startPos.x;
		let dy = d3.event.y - groupBoundaryDragState.startPos.y;
		
		// Store current delta for use by visual update functions
		groupBoundaryDragState.currentDelta = { x: dx, y: dy };
		
		// Move all members
		groupBoundaryDragState.memberOffsets.forEach(item => {
			let newX = item.startX + dx;
			let newY = item.startY + dy;
			
			let element = d3.select(item.element);
			
			if (item.element.tagName === 'rect') {
				element.attr('x', newX - 8).attr('y', newY - 8);
			} else {
				element.attr('cx', newX).attr('cy', newY);
			}
			
			let cloneIdAttr = item.element.getAttribute('clone-id');
            let isOrgClone = cloneIdAttr && cloneIdAttr.startsWith('orgclone');
            let isPerClone = cloneIdAttr && cloneIdAttr.startsWith('perclone');
            let numId = getNumericIdFromClone(cloneIdAttr);
            let instMatch = cloneIdAttr ? cloneIdAttr.match(/-(\d+)$/) : null;
            let instSuffix = instMatch ? instMatch[0] : '';
            
            // Update text
            if (isPerClone) {
                d3.select('#perclonetext' + numId + instSuffix)
                    .attr('x', newX)
                    .attr('y', newY - 12);
            } else if (isOrgClone) {
                d3.select('#orgclonetext' + numId + instSuffix)
                    .attr('x', newX)
                    .attr('y', newY - 12);
            } else {
                d3.select('#mapclonetext' + numId + instSuffix)
                    .attr('x', newX)
                    .attr('y', newY - 12);
            }
			
			// Update elastic bands
			updateElasticBandUniversal(item.element, newX, newY);
		});
		
		// Update matrix visuals using direct delta (not recalculated center)
		updateMatrixVisualsOnBoundaryDrag(groupId, dx, dy);
		
		// Update other arrangement visuals
		updateAllArrangementVisualsExceptMatrix(groupId);
		
		// Update the boundary position
		updateBoundaryPosition(groupId);
		
		// Update the group name label and rotate handle position
		updateGroupNameLabelPositionDirect(groupId);
	}

