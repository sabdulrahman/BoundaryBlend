				let currentX, currentY;
				if (cloneEle.tagName === 'rect') {
					currentX = parseFloat(d3.select(cloneEle).attr('x')) + 8;
					currentY = parseFloat(d3.select(cloneEle).attr('y')) + 8;
				} else {
					currentX = parseFloat(d3.select(cloneEle).attr('cx'));
					currentY = parseFloat(d3.select(cloneEle).attr('cy'));
