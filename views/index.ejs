	function updateVennVisualsOnDrag(groupId, centerX, centerY) {
		let vennData = mapDragState.vennData?.get(groupId);
		if (!vennData) return;
		
		let deltaX = centerX - vennData.originalCenter.x;
		let deltaY = centerY - vennData.originalCenter.y;
		
		// Skip if no significant movement
		if (Math.abs(deltaX) < 0.01 && Math.abs(deltaY) < 0.01) return;
		
		let canvas = d3.select('#line-canvas');
		
		// Update all circles
		canvas.selectAll(`.venn-circle-${groupId}`).each(function() {
			let circle = d3.select(this);
			let origCX = parseFloat(circle.attr('data-orig-cx'));
			let origCY = parseFloat(circle.attr('data-orig-cy'));
			
			if (!isNaN(origCX) && !isNaN(origCY)) {
				circle.attr('cx', origCX + deltaX)
					  .attr('cy', origCY + deltaY);
			}
		});
		
		// Update all labels
		canvas.selectAll(`.venn-label-${groupId}`).each(function() {
			let label = d3.select(this);
			let origX = parseFloat(label.attr('data-orig-x'));
			let origY = parseFloat(label.attr('data-orig-y'));
			
			if (!isNaN(origX) && !isNaN(origY)) {
				label.attr('x', origX + deltaX)
					 .attr('y', origY + deltaY);
			}
		});
	}

	function updateClusterVisualsOnDrag(groupId, centerX, centerY) {
		let clusterData = mapDragState.clusterData?.get(groupId);
		if (!clusterData) return;
		
		let deltaX = centerX - clusterData.originalCenter.x;
		let deltaY = centerY - clusterData.originalCenter.y;
		
		let canvas = d3.select('#line-canvas');
		
		// Recalculate each cluster's center based on its members
		clusterData.clusters.forEach((cluster, clusterIndex) => {
			let clusterCenterX = 0, clusterCenterY = 0, count = 0;
			
			cluster.forEach(cloneId => {
				let element = document.querySelector(`[clone-id="${cloneId}"]`);
				if (element) {
					let cx, cy;
					if (element.tagName === 'rect') {
						cx = parseFloat(d3.select(element).attr('x')) + 8;
						cy = parseFloat(d3.select(element).attr('y')) + 8;
					} else {
						cx = parseFloat(d3.select(element).attr('cx'));
						cy = parseFloat(d3.select(element).attr('cy'));
					}
					clusterCenterX += cx;
					clusterCenterY += cy;
					count++;
				}
			});
			
			if (count > 0) {
				clusterCenterX /= count;
				clusterCenterY /= count;
				
				// Update cluster background
				canvas.selectAll(`.cluster-bg-${groupId}`)
					.filter(function() {
						return d3.select(this).attr('data-cluster-index') == clusterIndex;
					})
					.attr('cx', clusterCenterX)
					.attr('cy', clusterCenterY);
				
				// Update cluster label
				let bgRadius = parseFloat(canvas.select(`.cluster-bg-${groupId}[data-cluster-index="${clusterIndex}"]`).attr('r')) || 60;
				
				canvas.selectAll(`.cluster-label-${groupId}`)
					.filter(function() {
						return d3.select(this).attr('data-cluster-index') == clusterIndex;
					})
					.attr('x', clusterCenterX)
					.attr('y', clusterCenterY - bgRadius - 5);
			}
		});
		
		// Update original center
		clusterData.originalCenter = { x: centerX, y: centerY };
	}


