		if (!mapDragState.bridgeLabelData) {
			mapDragState.bridgeLabelData = new Map();
		}

		let firstColX = startColumnX;
		let lastColX = startColumnX + (viewTypesList.length - 1) * columnSpacing;
		mapDragState.bridgeLabelData.set(groupId, {
			mapLabelOffset: { x: firstColX - centerX, y: labelY - centerY },
			orgLabelOffset: { x: lastColX - centerX, y: labelY - centerY },
			columnSpacing: totalWidth,
			rowSpacing: rowSpacing,
			backgroundOffset: {
				x: centerX,
				y: centerY,
				width: totalWidth + 60,
				height: maxElements * rowSpacing + 70
			}
		});

		let canvas = d3.select('#line-canvas');

		// === Draw the order selection buttons (A, B, C) ===
// === Draw the order selection buttons (A, B, C) near the group text box ===
    canvas.selectAll(`.bridge-reorder-btn-${groupId}`).remove();

    let baseViewTypes = getAllViewTypesForGroup(groupId, viewGroups);
    let permutations = getPermutations(baseViewTypes);
    let labels = ['A', 'B', 'C', 'D', 'E', 'F'];

    if (!mapDragState.bipartitePermutations) {
        mapDragState.bipartitePermutations = new Map();
    }
    mapDragState.bipartitePermutations.set(groupId, permutations);

    let activeIndex = permutations.findIndex(perm =>
        perm.length === viewTypesList.length &&
        perm.every((vt, i) => vt === viewTypesList[i])
    );

    // Position buttons near the group text box / rotate button
    // Find the group name label (text box) position
    let groupNameLabel = canvas.select(`.group-name-label-${groupId}`);
    let rotateBtn = canvas.select(`.rotate-btn-${groupId}`);
    
	let btnGroupX, btnGroupY;
		
		if (!rotateBtn.empty()) {
			// Place to the right of rotate button with extra gap, aligned to text box height
			let rotateBtnX = parseFloat(rotateBtn.attr('x'));
			let rotateBtnY = parseFloat(rotateBtn.attr('y'));
			let rotateBtnWidth = parseFloat(rotateBtn.attr('width')) || 28;
			btnGroupX = rotateBtnX + rotateBtnWidth + 50;
			
			// Move up to match text box height
			if (!groupNameLabel.empty()) {
				btnGroupY = parseFloat(groupNameLabel.attr('y')) - (btnSize / 2) - 2;
			} else {
				btnGroupY = rotateBtnY - 50;
			}
		} else if (!groupNameLabel.empty()) {
			// Fallback: place to the right of the group name label, same vertical level
			let nameLabelX = parseFloat(groupNameLabel.attr('x'));
			let nameLabelY = parseFloat(groupNameLabel.attr('y'));
			let nameLabelWidth = parseFloat(groupNameLabel.attr('width') || groupNameLabel.node().getBBox?.()?.width) || 80;
			btnGroupX = nameLabelX + nameLabelWidth + 24;
			btnGroupY = nameLabelY - (btnSize / 2) - 8;
		} else {
			// Final fallback
			btnGroupX = centerX - ((permutations.length * 28) / 2) + 120;  // +80 moves right
			btnGroupY = centerY - (maxElements * rowSpacing / 2) - 80;     // -70 moves up
		}
	
    let btnSize = 22;
    let btnGap = 3;
    let foWidth = permutations.length * (btnSize + btnGap) + 6;
    let foHeight = btnSize + 6;

    let fo = canvas.append('foreignObject')
        .attr('class', `bridge-label bridge-label-${groupId} bridge-reorder-btn-${groupId}`)
        .attr('data-group-id', groupId)
        .attr('data-orig-x', btnGroupX)
        .attr('data-orig-y', btnGroupY)
        .attr('x', btnGroupX)
        .attr('y', btnGroupY)
        .attr('width', foWidth)
        .attr('height', foHeight)
        .style('overflow', 'visible')
		.style('pointer-events', 'auto')   // ADD THIS
		.style('z-index', '99999');         // ADD THI

    let btnContainer = fo.append('xhtml:div')
        .style('display', 'flex')
        .style('gap', btnGap + 'px')
        .style('align-items', 'center')
		.style('pointer-events', 'auto');   // ADD THIS

		
