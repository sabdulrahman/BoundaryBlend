				</div>
			</div>
			<div class="fca-panel-subtitle">"${entityName}" in ${result.groups.length} cluster(s)</div>
			<div class="fca-panel-body"></div>
		`;

		panel.querySelector('.fca-panel-close').onclick = () => hideFCASuggestionPanel();
		panel.querySelector('.fca-panel-minimize').onclick = () => {
			const body = panel.querySelector('.fca-panel-body');
			const sub = panel.querySelector('.fca-panel-subtitle');
			if (body.style.display === 'none') {
				body.style.display = '';
				sub.style.display = '';
			} else {
				body.style.display = 'none';
				sub.style.display = 'none';
			}
		};

		const body = panel.querySelector('.fca-panel-body');

		sortedGroups.forEach((group, idx) => {
			const isDirect = directGroupIds.includes(group.id);
			const section = document.createElement('div');
			section.className = 'fca-cluster-section';

			const header = document.createElement('div');
			header.className = 'fca-cluster-header fca-action-' + group.action.toLowerCase();
			header.style.cursor = 'pointer';

			const totalEntities = group.persons.length + group.locations.length + group.organizations.length;
			header.innerHTML = `
				<span class="fca-cluster-number">${isDirect ? '●' : '○'}</span>
				<span class="fca-cluster-name">${group.name}</span>
				<span class="fca-cluster-meta">
					${group.f1 != null ? `F1:${group.f1.toFixed(2)}` : ''}
					<span class="fca-cluster-badge fca-action-${group.action.toLowerCase()}-badge">${group.action}</span>
				</span>
				<span class="fca-toggled-count" style="font-size:10px;color:#7ec8e3;min-width:20px;text-align:right;">0/${totalEntities}</span>
				<span class="fca-expand-toggle">▾</span>
			`;

			const entityList = document.createElement('div');
			entityList.className = 'fca-entity-list';
			entityList.style.display = isDirect ? 'block' : 'none';

			// Add all / Remove all toggle button
			const toggleAllBtn = document.createElement('button');
			toggleAllBtn.className = 'fca-add-all-btn';
			toggleAllBtn.textContent = `⊕ Add all ${totalEntities} entities`;
			toggleAllBtn.setAttribute('data-group-id', group.id);
			toggleAllBtn.addEventListener('click', (e) => {
				e.stopPropagation();
				toggleAllClusterEntities(group, section, panel);
			});
			entityList.appendChild(toggleAllBtn);

			// Entity chips container
			const chipsContainer = document.createElement('div');
			chipsContainer.className = 'fca-chips-container';
			chipsContainer.style.cssText = 'display:flex;flex-wrap:wrap;gap:5px;padding:6px 14px;';

			[
				{ list: group.persons, type: 'person', icon: '👤', color: '#e76f51' },
				{ list: group.locations, type: 'location', icon: '📍', color: '#2a9d8f' },
				{ list: group.organizations, type: 'organization', icon: '🏢', color: '#e9c46a' }
			].forEach(({ list, type, icon, color }) => {
				list.forEach(name => {
					const chip = document.createElement('div');
					chip.className = 'fca-entity-chip';
					chip.setAttribute('data-entity-name', name);
					chip.setAttribute('data-entity-type', type);
					chip.setAttribute('data-cluster-id', group.id);

					// Check if already toggled on
					const isActive = panel._toggledClones.has(name.toLowerCase());

					chip.innerHTML = `<span class="fca-chip-icon">${icon}</span><span class="fca-chip-name">${name}</span>`;
					chip.style.cssText = `
						display:inline-flex;align-items:center;gap:4px;
						padding:4px 10px;border-radius:14px;font-size:11px;
						cursor:pointer;transition:all 0.2s;user-select:none;
						border:1px solid ${isActive ? color : '#3a3a5c'};
						background:${isActive ? color + '30' : '#0f0f1e'};
						color:${isActive ? '#fff' : '#ccc'};
					`;

					chip.addEventListener('click', function(e) {
						e.stopPropagation();
						toggleEntityClone(name, type, chip, panel, color);
						updateClusterCounts(section, group, panel);
					});

					// Right-click to highlight in source view
					chip.addEventListener('contextmenu', function(e) {
						e.preventDefault();
						highlightEntityInView(name, type);
					});

					chipsContainer.appendChild(chip);
				});
			});

			entityList.appendChild(chipsContainer);
			section.appendChild(header);
			section.appendChild(entityList);

			header.addEventListener('click', () => {
				const open = entityList.style.display !== 'none';
				entityList.style.display = open ? 'none' : 'block';
				header.querySelector('.fca-expand-toggle').textContent = open ? '▸' : '▾';
			});

			body.appendChild(section);
			updateClusterCounts(section, group, panel);
		});
	}

	function toggleEntityClone(entityName, entityType, chipElement, panel, color) {
		const key = entityName.toLowerCase();
		const isActive = panel._toggledClones.has(key);

		if (isActive) {
        // REMOVE the clone
        const cloneId = panel._toggledClones.get(key);
        const cloneEl = document.querySelector(`[clone-id="${cloneId}"]`);
        
        if (cloneEl) {
            const anchorX = panel._anchorX;
            const anchorY = panel._anchorY;
            const groupBefore = mapDragState.cloneGroups.get(cloneId);

            // Remove text and elastic band immediately
            d3.selectAll(`[data-clone-id="${cloneId}"]`).remove();

            if (cloneEl.tagName === 'rect') {
                d3.select(cloneEl)
                    .transition().duration(250).ease(d3.easeCubicIn)
                    .attr('x', anchorX - 8).attr('y', anchorY - 8)
                    .attr('width', 0).attr('height', 0)
                    .on('end', function() {
                        d3.select(this).remove();
                        finalizeRemoval(cloneId, groupBefore);
                    });
            } else {
                d3.select(cloneEl)
                    .transition().duration(250).ease(d3.easeCubicIn)
                    .attr('cx', anchorX).attr('cy', anchorY)
                    .attr('r', 0)
                    .on('end', function() {
                        d3.select(this).remove();
                        finalizeRemoval(cloneId, groupBefore);
                    });
            }
        } else {
            // Element already gone, just clean up state
            const groupBefore = mapDragState.cloneGroups.get(cloneId);
            finalizeRemoval(cloneId, groupBefore);
        }

        panel._toggledClones.delete(key);
        chipElement.style.border = '1px solid #3a3a5c';
        chipElement.style.background = '#0f0f1e';
        chipElement.style.color = '#ccc';
    } else {
        // ADD a clone, animated from anchor position
        const sourceInfo = findSourceElement(entityName, entityType);
        if (!sourceInfo) {
            console.log('Source element not found for:', entityName);
            chipElement.style.background = 'rgba(255,50,50,0.2)';
            setTimeout(() => { chipElement.style.background = '#0f0f1e'; }, 500);
            return;
        }

        // Determine target group
        let targetGroupId = panel._anchorGroupId;
        if (!targetGroupId) {
            targetGroupId = getOrCreateGroupId();
            panel._anchorGroupId = targetGroupId;
            if (panel._anchorClone) {
                const aid = panel._anchorClone.getAttribute('clone-id');
                if (aid) assignGroupToClones([aid], targetGroupId);
            }
        }

        const spawnX = panel._anchorX;
        const spawnY = panel._anchorY;

        // Create clone WITHOUT passing targetGroupId so it won't auto-arrange
        createAdditionalClone(
            sourceInfo.originalId, spawnX, spawnY,
            sourceInfo.isOrg, null, sourceInfo.isPerson
        );

        // Find the newly created clone
        const clones = getAllClonesForOriginal(sourceInfo.originalId);
        let newCloneId = null;
        clones.forEach(cid => { newCloneId = cid; });

        if (newCloneId) {
            panel._toggledClones.set(key, newCloneId);

            // Remove from the auto-created solo group
            const autoGroup = mapDragState.cloneGroups.get(newCloneId);
            if (autoGroup && autoGroup !== targetGroupId) {
                removeFromGroup(newCloneId);
            }

            // Add to the anchor's group
            assignGroupToClones([newCloneId], targetGroupId);

            // Calculate position: radial offset from anchor based on how many are toggled
            const memberCount = mapDragState.groupMembers.get(targetGroupId)?.size || 1;
            const angle = ((memberCount - 1) * 2 * Math.PI) / Math.max(memberCount, 6);
            const radius = 40 + Math.floor((memberCount - 1) / 6) * 30;
            const targetX = spawnX + radius * Math.cos(angle);
            const targetY = spawnY + radius * Math.sin(angle);

            const newEl = document.querySelector(`[clone-id="${newCloneId}"]`);
            if (newEl) {
                if (newEl.tagName === 'rect') {
                    // Start at anchor, animate to target
                    d3.select(newEl)
                        .attr('x', spawnX - 8).attr('y', spawnY - 8)
                        .attr('width', 0).attr('height', 0)
                        .transition().duration(350).ease(d3.easeCubicOut)
                        .attr('x', targetX - 8).attr('y', targetY - 8)
                        .attr('width', 16).attr('height', 16);
                } else {
                    d3.select(newEl)
                        .attr('cx', spawnX).attr('cy', spawnY)
                        .attr('r', 0)
                        .transition().duration(350).ease(d3.easeCubicOut)
                        .attr('cx', targetX).attr('cy', targetY)
                        .attr('r', 10);
                }

                // Animate text label
                const numId = getNumericIdFromClone(newCloneId);
                const instMatch = newCloneId.match(/-(\d+)$/);
                const instSuffix = instMatch ? instMatch[0] : '';
                const isPer = newCloneId.startsWith('perclone');
                const isOrg = newCloneId.startsWith('orgclone');
                const textPrefix = isPer ? 'perclonetext' : (isOrg ? 'orgclonetext' : 'mapclonetext');
                const textEl = d3.select('#' + textPrefix + numId + instSuffix);
                if (!textEl.empty()) {
                    textEl
                        .attr('x', spawnX).attr('y', spawnY - 12)
                        .style('opacity', 0)
                        .transition().duration(350).ease(d3.easeCubicOut)
                        .attr('x', targetX).attr('y', targetY - 12)
                        .style('opacity', 1);
                }

                // Update elastic band after animation
                setTimeout(() => {
                    const finalX = newEl.tagName === 'rect' ? parseFloat(newEl.getAttribute('x')) + 8 : parseFloat(newEl.getAttribute('cx'));
                    const finalY = newEl.tagName === 'rect' ? parseFloat(newEl.getAttribute('y')) + 8 : parseFloat(newEl.getAttribute('cy'));
                    updateElasticBandUniversal(newEl, finalX, finalY);
                }, 360);
            }

            // Update group visuals after animation completes
            setTimeout(() => {
                drawGroupBackground(targetGroupId);
                drawProximityBoundary(targetGroupId, false);
                showAllProximityBoundaries();
            }, 400);
        }

        chipElement.style.border = `1px solid ${color}`;
        chipElement.style.background = color + '30';
        chipElement.style.color = '#fff';
    }
	}

	function finalizeRemoval(cloneId, groupBefore) {
		unregisterClone(cloneId);
		
		// Manually remove from group WITHOUT triggering rearrangeGroupAfterRemoval
		let groupId = mapDragState.cloneGroups.get(cloneId);
		if (groupId) {
			let groupSet = mapDragState.groupMembers.get(groupId);
			if (groupSet) {
				groupSet.delete(cloneId);
				if (groupSet.size === 0) {
					mapDragState.groupMembers.delete(groupId);
					cleanupArrangementVisuals(groupId);
					d3.selectAll(`.group-background[data-group-id="${groupId}"]`).remove();
					d3.selectAll(`.proximity-boundary[data-group-id="${groupId}"]`).remove();
					d3.selectAll(`.group-name-label[data-group-id="${groupId}"]`).remove();
					d3.selectAll(`.group-rotate-handle[data-group-id="${groupId}"]`).remove();
					mapDragState.groupNames.delete(groupId);
					mapDragState.groupRotations.delete(groupId);
				}
			}
			mapDragState.cloneGroups.delete(cloneId);
		}
		
		mapDragState.selectedElements.delete(cloneId);

		// Update visuals without re-arranging (no left drift)
		if (groupBefore && mapDragState.groupMembers.has(groupBefore)) {
			drawGroupBackground(groupBefore);
			drawProximityBoundary(groupBefore, false);
		}
		
		setTimeout(() => showAllProximityBoundaries(), 300);
	}

	function findSourceElement(entityName, entityType) {
		const nameLower = entityName.toLowerCase();
		const candidates = document.querySelectorAll(
			'#bubbleMap circle, #bubbleMap rect, ' +
			'#graphbox circle, #graphbox rect, ' +
			'.organize-data-box rect, .organize-data-box circle, ' +
			'[data-name], [orgname], [label], [personsid], [barid], [map-id]'
		);

		for (const el of candidates) {
			const n = (
				el.getAttribute('data-name') ||
				el.getAttribute('orgname') ||
				el.getAttribute('label') || ''
			).trim().toLowerCase();
			if (n !== nameLower) continue;

			let originalId = null, isOrg = false, isPerson = false;
			const elId = el.id || '';

			if (entityType === 'person' || el.getAttribute('personsid') != null) {
				const pid = el.getAttribute('personsid') || elId.replace('per', '');
				originalId = 'per' + pid;
				isPerson = true;
			} else if (
				entityType === 'organization' ||
				el.getAttribute('barid') != null ||
				el.closest('.organize-data-box')
			) {
				const bid = el.getAttribute('barid') || elId.replace('bar', '');
				originalId = 'bar' + bid;
				isOrg = true;
			} else {
				const mid = el.getAttribute('map-id') || elId;
				originalId = mid.startsWith('map') ? mid : ('map' + mid.replace('map', ''));
			}

			if (document.getElementById(originalId)) {
				return { originalId, isOrg, isPerson };
			}
			if (el.id && document.getElementById(el.id)) {
				return { originalId: el.id, isOrg, isPerson };
			}
		}
		return null;
	}

	function updateClusterCounts(sectionElement, group, panel) {
		const totalEntities = group.persons.length + group.locations.length + group.organizations.length;
		let activeCount = 0;
		[...group.persons, ...group.locations, ...group.organizations].forEach(name => {
			if (panel._toggledClones.has(name.toLowerCase())) activeCount++;
		});
		const countEl = sectionElement.querySelector('.fca-toggled-count');
		if (countEl) {
			countEl.textContent = `${activeCount}/${totalEntities}`;
			countEl.style.color = activeCount > 0 ? '#2a9d8f' : '#7ec8e3';
		}
		// Update toggle-all button text
		const toggleBtn = sectionElement.querySelector('.fca-add-all-btn');
		if (toggleBtn) {
			if (activeCount === totalEntities) {
				toggleBtn.textContent = `⊖ Remove all ${totalEntities} entities`;
			} else {
				toggleBtn.textContent = `⊕ Add all ${totalEntities} entities (${activeCount} active)`;
			}
		}
	}

	function toggleAllClusterEntities(group, sectionElement, panel) {
		const allNames = [...group.persons, ...group.locations, ...group.organizations];
		const allTypes = [
			...group.persons.map(() => 'person'),
			...group.locations.map(() => 'location'),
			...group.organizations.map(() => 'organization')
		];
		const colors = {
			person: '#e76f51',
			location: '#2a9d8f',
			organization: '#e9c46a'
		};

		// Determine if we should add all or remove all
		let activeCount = 0;
		allNames.forEach(name => {
			if (panel._toggledClones.has(name.toLowerCase())) activeCount++;
		});
		const shouldRemoveAll = activeCount === allNames.length;

		const chips = sectionElement.querySelectorAll('.fca-entity-chip');

		allNames.forEach((name, i) => {
			const key = name.toLowerCase();
			const type = allTypes[i];
			const isActive = panel._toggledClones.has(key);
			const chip = [...chips].find(c => c.getAttribute('data-entity-name') === name);

			if (shouldRemoveAll && isActive) {
				if (chip) toggleEntityClone(name, type, chip, panel, colors[type]);
			} else if (!shouldRemoveAll && !isActive) {
				// Stagger additions
				setTimeout(() => {
					if (chip) toggleEntityClone(name, type, chip, panel, colors[type]);
					updateClusterCounts(sectionElement, group, panel);
				}, i * 80);
			}
		});

		setTimeout(() => updateClusterCounts(sectionElement, group, panel), allNames.length * 80 + 100);
	}

	function hideFCASuggestionPanel() {
		const panel = document.getElementById('fca-suggestion-panel');
		if (panel) {
			panel.style.display = 'none';
			// Clear toggled state so chips reset on next open
			if (panel._toggledClones) panel._toggledClones.clear();
		}
	}

	function toggleFCASuggestionPanel() {
		const panel = document.getElementById('fca-suggestion-panel');
		if (panel) {
			panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
		}
	}

	function highlightEntityInView(entityName, entityType) {
		let targets = [];
		const nameLower = entityName.toLowerCase();
	 
		if (entityType === 'location' || entityType === 'person') {
			// Search in the bubble-map circles and the graph nodes
			document.querySelectorAll('#bubbleMap circle, #graphbox circle, #graphbox rect')
				.forEach(el => {
					const n = (el.getAttribute('data-name') || el.getAttribute('label') || '').toLowerCase();
					if (n === nameLower) targets.push(el);
				});
			// Also look at SVG text labels
			document.querySelectorAll('#bubbleMap text, #graphbox text')
				.forEach(el => {
					if ((el.textContent || '').trim().toLowerCase() === nameLower) {
						targets.push(el);
					}
				});
		}
	 
		if (entityType === 'organization') {
			// Search in the org bar
			document.querySelectorAll('.organize-data-box rect, .organize-data-box text')
				.forEach(el => {
					const n = (el.getAttribute('orgname') || el.getAttribute('label') || el.textContent || '').trim().toLowerCase();
					if (n === nameLower) targets.push(el);
				});
		}
	 
		// Also search attribute selectors as a catch-all
		document.querySelectorAll(`[data-name="${entityName}"], [orgname="${entityName}"], [label="${entityName}"]`)
			.forEach(el => {
				if (!targets.includes(el)) targets.push(el);
			});
	 
		if (targets.length === 0) {
			console.log('FCA Suggestion: "' + entityName + '" not found in any open view');
			return;
		}
	 
		// Pulse animation on found elements
		targets.forEach(el => {
			const orig = el.style.cssText;
			el.style.transition = 'all 0.15s ease';
			el.style.filter = 'drop-shadow(0 0 8px #ff6b35) drop-shadow(0 0 16px #ff6b35)';
			el.style.transform = 'scale(1.6)';
			el.scrollIntoView && el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
	 
			setTimeout(() => { el.style.transform = 'scale(1.0)'; }, 200);
			setTimeout(() => { el.style.filter = 'drop-shadow(0 0 6px #ff6b35)'; }, 400);
			setTimeout(() => {
				el.style.cssText = orig;
				el.style.transition = 'all 0.3s ease';
				setTimeout(() => { el.style.transition = ''; }, 300);
			}, 2000);
		});
	}

