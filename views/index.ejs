	}

	function arrangeForceDirected(viewGroups, centerX, centerY, groupId) {
		let allElements = [];
		let nodes = [];
		
		viewGroups.forEach((elements, viewType) => {
			elements.forEach(element => {
				allElements.push(element);
				let cloneId = element.getAttribute('clone-id');
				let x, y;
				if (element.tagName === 'rect') {
					x = parseFloat(d3.select(element).attr('x')) + 8;
					y = parseFloat(d3.select(element).attr('y')) + 8;
				} else {
					x = parseFloat(d3.select(element).attr('cx'));
					y = parseFloat(d3.select(element).attr('cy'));
				}
				nodes.push({
					id: cloneId,
					element: element,
					x: x,
					y: y,
					vx: 0,
					vy: 0
				});
			});
		});
		
		let members = mapDragState.groupMembers.get(groupId);
		let connections = getConnectionsBetweenClones(members);
		
		let links = connections.map(conn => ({
			source: conn.source,
			target: conn.target
		}));
		
		// Force simulation
		let iterations = 100;
		let repulsion = 1200;
		let attraction = connections.length > 0 ? 0.08 : 0;
		let damping = 0.85;
		
		for (let iter = 0; iter < iterations; iter++) {
			// Repulsion
			for (let i = 0; i < nodes.length; i++) {
				for (let j = i + 1; j < nodes.length; j++) {
					let dx = nodes[j].x - nodes[i].x;
					let dy = nodes[j].y - nodes[i].y;
					let dist = Math.sqrt(dx * dx + dy * dy) || 1;
					let force = repulsion / (dist * dist);
					
					nodes[i].vx -= (dx / dist) * force;
					nodes[i].vy -= (dy / dist) * force;
					nodes[j].vx += (dx / dist) * force;
					nodes[j].vy += (dy / dist) * force;
				}
			}
			
			// Attraction along links
			links.forEach(link => {
				let source = nodes.find(n => n.id === link.source);
				let target = nodes.find(n => n.id === link.target);
				if (source && target) {
					let dx = target.x - source.x;
					let dy = target.y - source.y;
					
					source.vx += dx * attraction;
					source.vy += dy * attraction;
					target.vx -= dx * attraction;
					target.vy -= dy * attraction;
				}
			});
			
			// Center gravity
			nodes.forEach(n => {
				n.vx += (centerX - n.x) * 0.02;
				n.vy += (centerY - n.y) * 0.02;
			});
			
			// Apply velocities
			nodes.forEach(n => {
				n.x += n.vx;
				n.y += n.vy;
				n.vx *= damping;
				n.vy *= damping;
			});
		}
		
		// Store node positions for connection updates
		if (!mapDragState.forceData) {
			mapDragState.forceData = new Map();
		}
		mapDragState.forceData.set(groupId, {
			originalCenter: { x: centerX, y: centerY },
			connections: connections
		});
		
		// Animate elements
		nodes.forEach(n => {
			animateCloneToPosition(n.element, n.x, n.y);
		});
		
		// Draw connections after animation
		setTimeout(() => {
			drawForceConnections(groupId);
		}, 400);
	}

	function drawForceConnections(groupId) {
		let canvas = d3.select('#line-canvas');
		canvas.selectAll(`.force-link-${groupId}`).remove();
		
		let members = mapDragState.groupMembers.get(groupId);
		if (!members) return;
		
		let connections = getConnectionsBetweenClones(members);
		
		connections.forEach(conn => {
			let sourceX, sourceY, targetX, targetY;
			
			if (conn.sourceElement.tagName === 'rect') {
				sourceX = parseFloat(d3.select(conn.sourceElement).attr('x')) + 8;
				sourceY = parseFloat(d3.select(conn.sourceElement).attr('y')) + 8;
			} else {
				sourceX = parseFloat(d3.select(conn.sourceElement).attr('cx'));
				sourceY = parseFloat(d3.select(conn.sourceElement).attr('cy'));
			}
			
			if (conn.targetElement.tagName === 'rect') {
				targetX = parseFloat(d3.select(conn.targetElement).attr('x')) + 8;
				targetY = parseFloat(d3.select(conn.targetElement).attr('y')) + 8;
			} else {
				targetX = parseFloat(d3.select(conn.targetElement).attr('cx'));
				targetY = parseFloat(d3.select(conn.targetElement).attr('cy'));
			}
			
			// Draw line
			canvas.append('line')
				.attr('class', `force-link force-link-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-source', conn.source)
				.attr('data-target', conn.target)
				.attr('x1', sourceX)
				.attr('y1', sourceY)
				.attr('x2', targetX)
				.attr('y2', targetY)
				.style('stroke', '#2ecc71')
				.style('stroke-width', '3px')
				.style('stroke-opacity', '0.8')
				.style('pointer-events', 'none');
			
			// Draw midpoint
			let midX = (sourceX + targetX) / 2;
			let midY = (sourceY + targetY) / 2;
			
			canvas.append('circle')
				.attr('class', `force-link force-link-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-source', conn.source)
				.attr('data-target', conn.target)
				.attr('cx', midX)
				.attr('cy', midY)
				.attr('r', 5)
				.style('fill', '#2ecc71')
				.style('stroke', 'white')
				.style('stroke-width', '2px')
				.style('pointer-events', 'none');
		});
	}

	function arrangeVenn(viewGroups, centerX, centerY, groupId) {
		let viewTypes = Array.from(viewGroups.keys());
		
		if (viewTypes.length < 2) {
			arrangeRadial(viewGroups, centerX, centerY);
			return;
		}
		
		let canvas = d3.select('#line-canvas');
		canvas.selectAll(`.venn-circle-${groupId}`).remove();
		canvas.selectAll(`.venn-label-${groupId}`).remove();
		canvas.selectAll(`.venn-connection-${groupId}`).remove();
		
		// Get connections for overlap detection
		let allMembers = new Set();
		viewGroups.forEach((elements) => {
			elements.forEach(el => {
				allMembers.add(el.getAttribute('clone-id'));
			});
		});
		let connections = getConnectionsBetweenClones(allMembers);
		let connectedElements = new Set();
		connections.forEach(conn => {
			connectedElements.add(conn.source);
			connectedElements.add(conn.target);
		});
		
		// Store data for drag updates
		if (!mapDragState.vennData) {
			mapDragState.vennData = new Map();
		}
		
		// Color palette per view type
		let viewColors = {
			'map': { fill: 'rgba(52, 152, 219, 0.2)', stroke: 'rgba(52, 152, 219, 0.7)', label: 'rgba(52, 152, 219, 1)' },
			'org': { fill: 'rgba(231, 76, 60, 0.2)', stroke: 'rgba(231, 76, 60, 0.7)', label: 'rgba(231, 76, 60, 1)' },
			'person': { fill: 'rgba(46, 204, 113, 0.2)', stroke: 'rgba(46, 204, 113, 0.7)', label: 'rgba(46, 204, 113, 1)' }
		};
		let defaultColor = { fill: 'rgba(155, 89, 182, 0.2)', stroke: 'rgba(155, 89, 182, 0.7)', label: 'rgba(155, 89, 182, 1)' };
		
		if (viewTypes.length === 2) {
			// ===== 2 VIEW TYPES: Classic 2-circle Venn =====
			let circleRadius = 100;
			let overlapDistance = 60;
			
			let leftCircleX = centerX - overlapDistance;
			let rightCircleX = centerX + overlapDistance;
			
			mapDragState.vennData.set(groupId, {
				originalCenter: { x: centerX, y: centerY },
				circleRadius: circleRadius,
				overlapDistance: overlapDistance,
				viewCount: 2
			});
			
			let leftType = viewTypes[0];
			let rightType = viewTypes[1];
			let leftColor = viewColors[leftType] || defaultColor;
			let rightColor = viewColors[rightType] || defaultColor;
			
			// Draw left circle
			canvas.insert('circle', ':first-child')
				.attr('class', `venn-circle venn-circle-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-orig-cx', leftCircleX)
				.attr('data-orig-cy', centerY)
				.attr('data-side', 'left')
				.attr('cx', leftCircleX)
				.attr('cy', centerY)
				.attr('r', circleRadius)
				.style('fill', leftColor.fill)
				.style('stroke', leftColor.stroke)
				.style('stroke-width', '3px')
				.style('pointer-events', 'none');
			
			// Draw right circle
			canvas.insert('circle', ':first-child')
				.attr('class', `venn-circle venn-circle-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-orig-cx', rightCircleX)
				.attr('data-orig-cy', centerY)
				.attr('data-side', 'right')
				.attr('cx', rightCircleX)
				.attr('cy', centerY)
				.attr('r', circleRadius)
				.style('fill', rightColor.fill)
				.style('stroke', rightColor.stroke)
				.style('stroke-width', '3px')
				.style('pointer-events', 'none');
			
			// Labels
			canvas.append('text')
				.attr('class', `venn-label venn-label-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-orig-x', leftCircleX - 50)
				.attr('data-orig-y', centerY - circleRadius - 15)
				.attr('x', leftCircleX - 50)
				.attr('y', centerY - circleRadius - 15)
				.attr('text-anchor', 'middle')
				.style('fill', leftColor.label)
				.style('font-size', '14px')
				.style('font-weight', 'bold')
				.style('pointer-events', 'none')
				.text(leftType.toUpperCase());
			
			canvas.append('text')
				.attr('class', `venn-label venn-label-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-orig-x', rightCircleX + 50)
				.attr('data-orig-y', centerY - circleRadius - 15)
				.attr('x', rightCircleX + 50)
				.attr('y', centerY - circleRadius - 15)
				.attr('text-anchor', 'middle')
				.style('fill', rightColor.label)
				.style('font-size', '14px')
				.style('font-weight', 'bold')
				.style('pointer-events', 'none')
				.text(rightType.toUpperCase());
			
			canvas.append('text')
				.attr('class', `venn-label venn-label-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-orig-x', centerX)
				.attr('data-orig-y', centerY + circleRadius + 25)
				.attr('x', centerX)
				.attr('y', centerY + circleRadius + 25)
				.attr('text-anchor', 'middle')
				.style('fill', 'rgba(155, 89, 182, 1)')
				.style('font-size', '12px')
				.style('font-style', 'italic')
				.style('pointer-events', 'none')
				.text('Connected Elements');
			
			// Categorize elements
			let leftExclusive = [];
			let rightExclusive = [];
			let leftConnected = [];
			let rightConnected = [];
			
			viewGroups.forEach((elements, viewType) => {
				elements.forEach(element => {
					let cloneId = element.getAttribute('clone-id');
					let isConnected = connectedElements.has(cloneId);
					
					if (viewType === leftType) {
						if (isConnected) leftConnected.push(element);
						else leftExclusive.push(element);
					} else if (viewType === rightType) {
						if (isConnected) rightConnected.push(element);
						else rightExclusive.push(element);
					}
				});
			});
			
			// Position exclusive left elements
			leftExclusive.forEach((element, i) => {
				let angle = ((i / Math.max(leftExclusive.length, 1)) * Math.PI) - Math.PI * 0.75;
				let radius = circleRadius * 0.6;
				let x = leftCircleX - 25 + radius * Math.cos(angle);
				let y = centerY + radius * Math.sin(angle);
				animateCloneToPosition(element, x, y);
			});
			
			// Position exclusive right elements
			rightExclusive.forEach((element, i) => {
				let angle = ((i / Math.max(rightExclusive.length, 1)) * Math.PI) - Math.PI * 0.25;
				let radius = circleRadius * 0.6;
				let x = rightCircleX + 25 + radius * Math.cos(angle);
				let y = centerY + radius * Math.sin(angle);
				animateCloneToPosition(element, x, y);
			});
			
			// Position connected left elements (left side of overlap)
			let overlapSpacing = 30;
			leftConnected.forEach((element, i) => {
				let x = centerX - 25;
				let y = centerY + (i - (leftConnected.length - 1) / 2) * overlapSpacing;
				animateCloneToPosition(element, x, y);
			});
			
			// Position connected right elements (right side of overlap)
			rightConnected.forEach((element, i) => {
				let x = centerX + 25;
				let y = centerY + (i - (rightConnected.length - 1) / 2) * overlapSpacing;
				animateCloneToPosition(element, x, y);
			});
			
		} else {
			// ===== 3+ VIEW TYPES: Multi-circle Venn =====
			let circleRadius = 90;
			let spreadRadius = 70; // Distance from center to each circle center
			let angleStep = (2 * Math.PI) / viewTypes.length;
			
			mapDragState.vennData.set(groupId, {
				originalCenter: { x: centerX, y: centerY },
				circleRadius: circleRadius,
				overlapDistance: spreadRadius,
				viewCount: viewTypes.length
			});
			
			// Calculate circle centers
			let circleCenters = {};
			viewTypes.forEach((viewType, index) => {
				let angle = index * angleStep - Math.PI / 2;
				circleCenters[viewType] = {
					x: centerX + spreadRadius * Math.cos(angle),
					y: centerY + spreadRadius * Math.sin(angle)
				};
			});
			
			// Draw circles and labels for each view type
			viewTypes.forEach((viewType, index) => {
				let angle = index * angleStep - Math.PI / 2;
				let cc = circleCenters[viewType];
				let color = viewColors[viewType] || defaultColor;
				
				canvas.insert('circle', ':first-child')
					.attr('class', `venn-circle venn-circle-${groupId}`)
					.attr('data-group-id', groupId)
					.attr('data-orig-cx', cc.x)
					.attr('data-orig-cy', cc.y)
					.attr('data-view-type', viewType)
					.attr('cx', cc.x)
					.attr('cy', cc.y)
					.attr('r', circleRadius)
					.style('fill', color.fill)
					.style('stroke', color.stroke)
					.style('stroke-width', '3px')
					.style('pointer-events', 'none');
				
				// Label positioned further out from center
				let labelRadius = circleRadius + 20;
				let labelX = cc.x + (labelRadius * 0.5) * Math.cos(angle);
				let labelY = cc.y + (labelRadius * 0.5) * Math.sin(angle) - circleRadius * 0.6;
				
				canvas.append('text')
					.attr('class', `venn-label venn-label-${groupId}`)
					.attr('data-group-id', groupId)
					.attr('data-orig-x', labelX)
					.attr('data-orig-y', labelY)
					.attr('x', labelX)
					.attr('y', labelY)
					.attr('text-anchor', 'middle')
					.style('fill', color.label)
					.style('font-size', '14px')
					.style('font-weight', 'bold')
					.style('pointer-events', 'none')
					.text(viewType.toUpperCase());
			});
			
			// Center overlap label
			canvas.append('text')
				.attr('class', `venn-label venn-label-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-orig-x', centerX)
				.attr('data-orig-y', centerY + circleRadius + spreadRadius + 20)
				.attr('x', centerX)
				.attr('y', centerY + circleRadius + spreadRadius + 20)
				.attr('text-anchor', 'middle')
				.style('fill', 'rgba(155, 89, 182, 1)')
				.style('font-size', '12px')
				.style('font-style', 'italic')
				.style('pointer-events', 'none')
				.text('Connected Elements');
			
			// For each view type, categorize elements as exclusive vs connected
			let exclusiveByView = {};
			let connectedByView = {};
			
			viewTypes.forEach(vt => {
				exclusiveByView[vt] = [];
				connectedByView[vt] = [];
			});
			
			viewGroups.forEach((elements, viewType) => {
				elements.forEach(element => {
					let cloneId = element.getAttribute('clone-id');
					if (connectedElements.has(cloneId)) {
						connectedByView[viewType].push(element);
					} else {
						exclusiveByView[viewType].push(element);
					}
				});
			});
			
			// Position exclusive elements in the outer part of each circle
			viewTypes.forEach((viewType, index) => {
				let cc = circleCenters[viewType];
				let angle = index * angleStep - Math.PI / 2;
				let exclusiveElements = exclusiveByView[viewType];
				
				// Spread exclusive elements in the outer region of their circle
				let outerRadius = circleRadius * 0.55;
				let outerCenterX = cc.x + (spreadRadius * 0.3) * Math.cos(angle);
				let outerCenterY = cc.y + (spreadRadius * 0.3) * Math.sin(angle);
				
				if (exclusiveElements.length === 1) {
					animateCloneToPosition(exclusiveElements[0], outerCenterX, outerCenterY);
				} else {
					let itemAngleStep = Math.PI / Math.max(exclusiveElements.length - 1, 1);
					let startAngle = angle - Math.PI / 2;
					
					exclusiveElements.forEach((element, i) => {
						let itemAngle = startAngle + i * itemAngleStep;
						let itemRadius = Math.min(outerRadius * 0.6, 15 * exclusiveElements.length);
						let x = outerCenterX + itemRadius * Math.cos(itemAngle);
						let y = outerCenterY + itemRadius * Math.sin(itemAngle);
						animateCloneToPosition(element, x, y);
					});
				}
			});
			
			// Position connected elements near the center overlap area
			// Elements connected to other views get placed between their view's circle center and the overall center
			viewTypes.forEach((viewType, index) => {
				let cc = circleCenters[viewType];
				let connectedElems = connectedByView[viewType];
				
				if (connectedElems.length === 0) return;
				
				// Position toward center from this circle's center
				let overlapX = (cc.x + centerX) / 2;
				let overlapY = (cc.y + centerY) / 2;
				let spacing = 25;
				
				connectedElems.forEach((element, i) => {
					let offsetY = (i - (connectedElems.length - 1) / 2) * spacing;
					animateCloneToPosition(element, overlapX, overlapY + offsetY);
				});
			});
		}
		
		// Draw connections after animation
		setTimeout(() => {
			drawVennConnections(groupId);
		}, 400);
	}

	function drawVennConnections(groupId) {
		let canvas = d3.select('#line-canvas');
		canvas.selectAll(`.venn-connection-${groupId}`).remove();
		
		let members = mapDragState.groupMembers.get(groupId);
		if (!members) return;
		
		let connections = getConnectionsBetweenClones(members);
		
		connections.forEach(conn => {
			let sourceElement = document.querySelector(`[clone-id="${conn.source}"]`);
			let targetElement = document.querySelector(`[clone-id="${conn.target}"]`);
			
			if (!sourceElement || !targetElement) return;
			
			let sourceX, sourceY, targetX, targetY;
			
			if (sourceElement.tagName === 'rect') {
				sourceX = parseFloat(d3.select(sourceElement).attr('x')) + 8;
				sourceY = parseFloat(d3.select(sourceElement).attr('y')) + 8;
			} else {
				sourceX = parseFloat(d3.select(sourceElement).attr('cx'));
				sourceY = parseFloat(d3.select(sourceElement).attr('cy'));
			}
			
			if (targetElement.tagName === 'rect') {
				targetX = parseFloat(d3.select(targetElement).attr('x')) + 8;
				targetY = parseFloat(d3.select(targetElement).attr('y')) + 8;
			} else {
				targetX = parseFloat(d3.select(targetElement).attr('cx'));
				targetY = parseFloat(d3.select(targetElement).attr('cy'));
			}
			
			canvas.append('line')
				.attr('class', `venn-connection venn-connection-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-source', conn.source)
				.attr('data-target', conn.target)
				.attr('x1', sourceX)
				.attr('y1', sourceY)
				.attr('x2', targetX)
				.attr('y2', targetY)
				.style('stroke', 'rgba(155, 89, 182, 0.6)')
				.style('stroke-width', '2px')
				.style('stroke-dasharray', '4,3')
				.style('pointer-events', 'none');
		});
	}

	function arrangeTimeline(viewGroups, centerX, centerY, groupId) {
		let allElements = [];
		viewGroups.forEach(elements => allElements.push(...elements));
		
		// Sort by any temporal attribute or preserve drag order
		let spacing = 80;
		let totalWidth = (allElements.length - 1) * spacing;
		let startX = centerX - totalWidth / 2;
		
		let canvas = d3.select('#line-canvas');
		
		// Draw timeline axis
		canvas.selectAll(`.timeline-axis-${groupId}`).remove();
		
		canvas.insert('line', ':first-child')
			.attr('class', `timeline-axis timeline-axis-${groupId}`)
			.attr('data-group-id', groupId)
			.attr('x1', startX - 30)
			.attr('y1', centerY)
			.attr('x2', startX + totalWidth + 30)
			.attr('y2', centerY)
			.style('stroke', 'rgba(100, 149, 237, 0.6)')
			.style('stroke-width', '3px')
			.style('pointer-events', 'none');
		
		// Add arrow head
		canvas.insert('polygon', ':first-child')
			.attr('class', `timeline-axis timeline-axis-${groupId}`)
			.attr('data-group-id', groupId)
			.attr('points', `${startX + totalWidth + 30},${centerY} ${startX + totalWidth + 20},${centerY - 6} ${startX + totalWidth + 20},${centerY + 6}`)
			.style('fill', 'rgba(100, 149, 237, 0.6)');
		
		allElements.forEach((element, index) => {
			let x = startX + index * spacing;
			animateCloneToPosition(element, x, centerY - 25);
			
			// Add sequence number
			canvas.append('text')
				.attr('class', `timeline-number timeline-axis-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('x', x)
				.attr('y', centerY + 20)
				.attr('text-anchor', 'middle')
				.style('fill', 'rgba(100, 149, 237, 0.8)')
				.style('font-size', '10px')
				.style('font-weight', 'bold')
				.text(index + 1);
		});
	}

	function arrangeHierarchy(viewGroups, centerX, centerY, groupId) {
		let allElements = [];
		viewGroups.forEach(elements => allElements.push(...elements));
		
		// Detect hierarchy from mapcondata relationships
		let roots = [];
		let children = new Map();
		
		allElements.forEach(element => {
			let cloneId = element.getAttribute('clone-id');
			let numericId = cloneId.replace('mapclone', '').replace('orgclone', '');
			
			// Check if this element has parents in the group
			let hasParentInGroup = false;
			allElements.forEach(other => {
				let otherId = other.getAttribute('clone-id');
				let otherNumericId = otherId.replace('mapclone', '').replace('orgclone', '');
				if (otherNumericId !== numericId) {
					// Check connection data
					if (typeof mapcondata !== 'undefined' && mapcondata[numericId]) {
						let connections = mapcondata[numericId]['om'] || '';
						if (connections.split(',').includes(otherNumericId)) {
							hasParentInGroup = true;
							if (!children.has(otherNumericId)) {
								children.set(otherNumericId, []);
							}
							children.get(otherNumericId).push(element);
						}
					}
				}
			});
			
			if (!hasParentInGroup) {
				roots.push(element);
			}
		});
		
		// Position using tree layout
		let levelHeight = 60;
		let siblingSpacing = 40;
		
		function positionNode(element, x, y, level) {
			animateCloneToPosition(element, x, y);
			
			let cloneId = element.getAttribute('clone-id');
			let numericId = cloneId.replace('mapclone', '').replace('orgclone', '');
			let nodeChildren = children.get(numericId) || [];
			
			let childStartX = x - ((nodeChildren.length - 1) * siblingSpacing / 2);
			nodeChildren.forEach((child, i) => {
				positionNode(child, childStartX + i * siblingSpacing, y + levelHeight, level + 1);
			});
		}
		
		let rootStartX = centerX - ((roots.length - 1) * siblingSpacing * 2 / 2);
		roots.forEach((root, i) => {
			positionNode(root, rootStartX + i * siblingSpacing * 2, centerY - 80, 0);
		});
		
		// Draw hierarchy lines
		setTimeout(() => drawHierarchyConnections(roots, children, groupId), 350);
	}

	function arrangePreserve(viewGroups, centerX, centerY) {
		let mapElements = [];
		let orgElements = [];
		let perElements = [];
		
		viewGroups.forEach((elements, viewType) => {
			if (viewType === 'map') mapElements = Array.from(elements);
			else if (viewType === 'org') orgElements = Array.from(elements);
			else if (viewType === 'person') perElements = Array.from(elements);
		});

		let allElements = [...mapElements, ...orgElements, ...perElements];
		if (allElements.length === 0) return;

		// Helper: get a clone's current board position
		function getClonePosition(element) {
			if (element.tagName === 'rect') {
				return {
					x: parseFloat(d3.select(element).attr('x')) + 8,
					y: parseFloat(d3.select(element).attr('y')) + 8
				};
			} else {
				return {
					x: parseFloat(d3.select(element).attr('cx')),
					y: parseFloat(d3.select(element).attr('cy'))
				};
			}
		}

		// Helper: get original source position (for initial layout only)
		function getSourcePosition(element) {
			let cloneId = element.getAttribute('clone-id');
			let originalId = element.getAttribute('original-id') || getOriginalIdFromClone(cloneId);
			let originalElement = document.getElementById(originalId);
			if (!originalElement) return null;

			let leftOffset = document.getElementById('leftplace').offsetWidth;
			let origRect = originalElement.getBoundingClientRect();
			return {
				x: origRect.x - leftOffset + (origRect.width / 2),
				y: origRect.y + (origRect.height / 2)
			};
		}

		// Determine if clones are already spread out on the board
		// (not all piled on top of each other from a fresh spawn)
		let clonePositions = allElements.map(el => ({ element: el, pos: getClonePosition(el) }));
		let cloneCenterX = 0, cloneCenterY = 0;
		clonePositions.forEach(cp => { cloneCenterX += cp.pos.x; cloneCenterY += cp.pos.y; });
		cloneCenterX /= clonePositions.length;
		cloneCenterY /= clonePositions.length;

		let maxSpread = 0;
		clonePositions.forEach(cp => {
			let dist = Math.sqrt(Math.pow(cp.pos.x - cloneCenterX, 2) + Math.pow(cp.pos.y - cloneCenterY, 2));
			maxSpread = Math.max(maxSpread, dist);
		});

		// If clones are already spread out (not freshly piled), preserve their CURRENT positions
		// relative to their centroid, and re-center around centerX/centerY
		let useCurrentPositions = maxSpread > 25;

		if (useCurrentPositions) {
			// Clones already have meaningful positions on the board
			// Just re-center them around the target center
			let dx = centerX - cloneCenterX;
			let dy = centerY - cloneCenterY;

			// If the shift is tiny, don't move at all (they're already arranged)
			if (Math.abs(dx) < 5 && Math.abs(dy) < 5) return;

			clonePositions.forEach(cp => {
				let newX = cp.pos.x + dx;
				let newY = cp.pos.y + dy;
				cp.element.setAttribute('offset-x', newX - centerX);
				cp.element.setAttribute('offset-y', newY - centerY);
				animateCloneToPosition(cp.element, newX, newY);
			});
			return;
		}

		// --- Freshly spawned clones: use source positions ---

		let typesPresent = (mapElements.length > 0 ? 1 : 0) + (orgElements.length > 0 ? 1 : 0) + (perElements.length > 0 ? 1 : 0);

		if (typesPresent <= 1) {
			let positions = [];
			allElements.forEach(element => {
				let srcPos = getSourcePosition(element);
				if (srcPos) positions.push({ element: element, x: srcPos.x, y: srcPos.y });
			});

			if (positions.length === 0) return;

			let origCentroidX = 0, origCentroidY = 0;
			positions.forEach(pos => { origCentroidX += pos.x; origCentroidY += pos.y; });
			origCentroidX /= positions.length;
			origCentroidY /= positions.length;

			// Scale down if too spread out
			let srcMinX = Infinity, srcMaxX = -Infinity, srcMinY = Infinity, srcMaxY = -Infinity;
			positions.forEach(pos => {
				srcMinX = Math.min(srcMinX, pos.x); srcMaxX = Math.max(srcMaxX, pos.x);
				srcMinY = Math.min(srcMinY, pos.y); srcMaxY = Math.max(srcMaxY, pos.y);
			});
			let srcWidth = srcMaxX - srcMinX;
			let srcHeight = srcMaxY - srcMinY;
			let scaleFactor = 1.0;
			let maxDim = 300;
			if (srcWidth > maxDim || srcHeight > maxDim) {
				scaleFactor = maxDim / Math.max(srcWidth, srcHeight);
			}

			positions.forEach(pos => {
				let offsetX = (pos.x - origCentroidX) * scaleFactor;
				let offsetY = (pos.y - origCentroidY) * scaleFactor;
				let newX = centerX + offsetX;
				let newY = centerY + offsetY;
				pos.element.setAttribute('offset-x', offsetX);
				pos.element.setAttribute('offset-y', offsetY);
				animateCloneToPosition(pos.element, newX, newY);
			});
			return;
		}

		// --- Multiple view types: side-by-side layout ---

		let leftOffset = document.getElementById('leftplace').offsetWidth;

		function getGroupPositions(elements) {
			let positions = [];
			elements.forEach(element => {
				let srcPos = getSourcePosition(element);
				if (srcPos) positions.push({ element: element, x: srcPos.x, y: srcPos.y });
			});
			return positions;
		}

		function getCentroid(positions) {
			let cx = 0, cy = 0;
			positions.forEach(p => { cx += p.x; cy += p.y; });
			return { x: cx / positions.length, y: cy / positions.length };
		}

		function getSpan(positions) {
			let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
			positions.forEach(p => {
				minX = Math.min(minX, p.x); maxX = Math.max(maxX, p.x);
				minY = Math.min(minY, p.y); maxY = Math.max(maxY, p.y);
			});
			return { width: maxX - minX, height: maxY - minY };
		}

		// Collect groups that have elements
		let groups = [];
		if (mapElements.length > 0) {
			let pos = getGroupPositions(mapElements);
			if (pos.length > 0) groups.push({ type: 'map', positions: pos, centroid: getCentroid(pos), span: getSpan(pos) });
		}
		if (orgElements.length > 0) {
			let pos = getGroupPositions(orgElements);
			if (pos.length > 0) groups.push({ type: 'org', positions: pos, centroid: getCentroid(pos), span: getSpan(pos) });
		}
		if (perElements.length > 0) {
			let pos = getGroupPositions(perElements);
			if (pos.length > 0) groups.push({ type: 'per', positions: pos, centroid: getCentroid(pos), span: getSpan(pos) });
		}

		if (groups.length === 0) return;

		// Sort groups left to right by their source centroid X
		groups.sort((a, b) => a.centroid.x - b.centroid.x);

		let groupSpacing = 80;
		let maxGroupDim = 200;

		// Calculate scaled widths and total width
		let totalWidth = 0;
		groups.forEach(g => {
			g.scaleFactor = 1.0;
			let maxDim = Math.max(g.span.width, g.span.height);
			if (maxDim > maxGroupDim) g.scaleFactor = maxGroupDim / maxDim;
			g.scaledWidth = g.span.width * g.scaleFactor;
			g.scaledHeight = g.span.height * g.scaleFactor;
			totalWidth += Math.max(g.scaledWidth, 20);
		});
		totalWidth += groupSpacing * (groups.length - 1);

		// Position each group
		let currentX = centerX - totalWidth / 2;

		groups.forEach(g => {
			let gWidth = Math.max(g.scaledWidth, 20);
			let gCenterX = currentX + gWidth / 2;

			g.positions.forEach(pos => {
				let offsetX = (pos.x - g.centroid.x) * g.scaleFactor;
				let offsetY = (pos.y - g.centroid.y) * g.scaleFactor;
				let newX = gCenterX + offsetX;
				let newY = centerY + offsetY;
				pos.element.setAttribute('offset-x', newX - centerX);
				pos.element.setAttribute('offset-y', newY - centerY);
				animateCloneToPosition(pos.element, newX, newY);
			});

			currentX += gWidth + groupSpacing;
		});
	}

	function arrangeRadial(viewGroups, centerX, centerY) {
		let angleStep = (2 * Math.PI) / viewGroups.size;
		let radius = Math.min(80, 30 + (viewGroups.size * 10));
		let viewIndex = 0;
		
		viewGroups.forEach((elements, viewType) => {
			let angle = viewIndex * angleStep - Math.PI / 2;
			let groupX = centerX + radius * Math.cos(angle);
			let groupY = centerY + radius * Math.sin(angle);
			
			let elementsArray = Array.from(elements);
			
			if (viewType === 'org') {
				// Sort org elements by their Y position in source view
				elementsArray = sortOrgElementsBySourceOrder(elementsArray);
				
				// Arrange org elements vertically (like a column) to match source view order
				let rowSpacing = 20;
				let startY = groupY - ((elementsArray.length - 1) * rowSpacing / 2);
				
				for (let index = 0; index < elementsArray.length; index++) {
					let element = elementsArray[index];
					let x = groupX;
					let y = startY + (index * rowSpacing);
					animateCloneToPosition(element, x, y);
				}
			} else {
				// Non-org elements use original radial arrangement
				for (let index = 0; index < elementsArray.length; index++) {
					let element = elementsArray[index];
					let offsetRadius = 15 * index;
					let x = groupX + offsetRadius * Math.cos(angle);
					let y = groupY + offsetRadius * Math.sin(angle);
					animateCloneToPosition(element, x, y);
				}
			}
			
			viewIndex++;
		});
	}

	function arrangeColumn(viewGroups, centerX, centerY) {
		let columnSpacing = 30;
		let rowSpacing = 20;
		let startX = centerX - ((viewGroups.size - 1) * columnSpacing / 2);
		let viewIndex = 0;
		
		viewGroups.forEach((elements, viewType) => {
			let x = startX + (viewIndex * columnSpacing);
			
			let elementsArray = Array.from(elements);
			
			// Sort org elements by their Y position in source view
			if (viewType === 'org') {
				elementsArray = sortOrgElementsBySourceOrder(elementsArray);
			}
			
			for (let index = 0; index < elementsArray.length; index++) {
				let element = elementsArray[index];
				let y = centerY + (index * rowSpacing) - ((elementsArray.length - 1) * rowSpacing / 2);
				animateCloneToPosition(element, x, y);
			}
			
			viewIndex++;
		});
	}

	function arrangeRow(viewGroups, centerX, centerY) {
		let columnSpacing = 20;
		let rowSpacing = 30;
		let startY = centerY - ((viewGroups.size - 1) * rowSpacing / 2);
		let viewIndex = 0;
		
		viewGroups.forEach((elements, viewType) => {
			let y = startY + (viewIndex * rowSpacing);
			elements.forEach((element, index) => {
				let x = centerX + (index * columnSpacing) - ((elements.length - 1) * columnSpacing / 2);
				animateCloneToPosition(element, x, y);
			});
			viewIndex++;
		});
	}

	function arrangeGrid(viewGroups, centerX, centerY) {
		let allElements = [];
		viewGroups.forEach(elements => allElements.push(...elements));
		
		let cols = Math.ceil(Math.sqrt(allElements.length));
		let spacing = 25;
		let startX = centerX - ((cols - 1) * spacing / 2);
		let startY = centerY - ((Math.ceil(allElements.length / cols) - 1) * spacing / 2);
		
		allElements.forEach((element, index) => {
			let col = index % cols;
			let row = Math.floor(index / cols);
			let x = startX + (col * spacing);
			let y = startY + (row * spacing);
			animateCloneToPosition(element, x, y);
		});
	}

	function arrangeCircle(viewGroups, centerX, centerY) {
		let allElements = [];
		viewGroups.forEach(elements => allElements.push(...elements));
		
		if (allElements.length === 1) {
			animateCloneToPosition(allElements[0], centerX, centerY);
			return;
		}
		
		let radius = Math.max(30, 10 * allElements.length);
		let angleStep = (2 * Math.PI) / allElements.length;
		
		allElements.forEach((element, index) => {
			let angle = index * angleStep - Math.PI / 2;
			let x = centerX + radius * Math.cos(angle);
			let y = centerY + radius * Math.sin(angle);
			animateCloneToPosition(element, x, y);
		});
	}

	function animateCloneToPosition(element, x, y) {
		let cloneId = element.getAttribute('clone-id');
		if (!cloneId) {
			// Fallback from element ID
			let elId = element.id;
			if (elId.includes('perpermanentclone')) {
				cloneId = 'perclone' + elId.replace('perpermanentclone', '');
			} else if (elId.includes('orgpermanentclone')) {
				cloneId = 'orgclone' + elId.replace('orgpermanentclone', '');
			} else {
				cloneId = 'mapclone' + elId.replace('mappermanentclone', '');
			}
		}

		let isOrgClone = cloneId.startsWith('orgclone');
		let isPerClone = cloneId.startsWith('perclone');

		let numericId = getNumericIdFromClone(cloneId);
		let instanceMatch = cloneId.match(/-(\d+)$/);
		let instanceSuffix = instanceMatch ? instanceMatch[0] : '';
		let textPrefix;
		if (isPerClone) {
			textPrefix = 'perclonetext';
		} else if (isOrgClone) {
			textPrefix = 'orgclonetext';
		} else {
			textPrefix = 'mapclonetext';
		}
		let textId = textPrefix + numericId + instanceSuffix;

		let groupId = mapDragState.cloneGroups.get(cloneId);

		let startX, startY;
		if (element.tagName === 'rect') {
			startX = parseFloat(d3.select(element).attr('x')) + 8;
			startY = parseFloat(d3.select(element).attr('y')) + 8;
		} else {
			startX = parseFloat(d3.select(element).attr('cx'));
			startY = parseFloat(d3.select(element).attr('cy'));
		}

		let interpolateX = d3.interpolate(startX, x);
		let interpolateY = d3.interpolate(startY, y);

		let duration = 300;
		let startTime = Date.now();

		function animate() {
			let elapsed = Date.now() - startTime;
			let t = Math.min(elapsed / duration, 1);

			let easedT = t < 0.5
				? 4 * t * t * t
				: 1 - Math.pow(-2 * t + 2, 3) / 2;

			let currentX = interpolateX(easedT);
			let currentY = interpolateY(easedT);

			if (element.tagName === 'rect') {
				d3.select(element)
					.attr('x', currentX - 8)
					.attr('y', currentY - 8);
			} else {
				d3.select(element)
					.attr('cx', currentX)
					.attr('cy', currentY);
			}

			d3.select('#' + textId)
				.attr('x', currentX)
				.attr('y', currentY - 12);

			updateElasticBandUniversal(element, currentX, currentY);

			if (groupId && mapDragState.bridgeLabelData && mapDragState.bridgeLabelData.has(groupId)) {
				updateBridgeVisualsForGroup(groupId);
			}

			if (t < 1) {
				requestAnimationFrame(animate);
			}
		}

		requestAnimationFrame(animate);
	}

	function updateElasticBandUniversal(element, x, y) {
		let cloneId = element.getAttribute('clone-id');
		if (!cloneId) {
			cloneId = element.id.replace('mappermanentclone', 'mapclone').replace('orgpermanentclone', 'orgclone').replace('perpermanentclone', 'perclone');
		}

		let isOrgClone = cloneId.startsWith('orgclone');
		let isPerClone = cloneId.startsWith('perclone');
		let isGrayedOut = element.getAttribute('grayed-out') === 'true';

		let numericId = getNumericIdFromClone(cloneId);
		let instanceMatch = cloneId.match(/-(\d+)$/);
		let instanceSuffix = instanceMatch ? instanceMatch[0] : '';

		if (isPerClone) {
