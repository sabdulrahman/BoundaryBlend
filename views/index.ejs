	function getAllViewTypesForGroup(groupId, viewGroups) {
		// If we have a stored base order, use that as the source of truth
		if (mapDragState.bipartiteBaseTypes && mapDragState.bipartiteBaseTypes.has(groupId)) {
			return mapDragState.bipartiteBaseTypes.get(groupId);
		}
		let types = Array.from(viewGroups.keys());
		// Store it for consistent permutation generation
		if (!mapDragState.bipartiteBaseTypes) {
			mapDragState.bipartiteBaseTypes = new Map();
		}
		mapDragState.bipartiteBaseTypes.set(groupId, types);
		return types;
	}	

	function cycleBipartiteOrder(groupId) {
		let permutations = mapDragState.bipartitePermutations?.get(groupId);
		if (!permutations) return;

		let currentOrder = mapDragState.bipartiteViewOrder?.get(groupId);
		let currentIndex = permutations.findIndex(perm =>
			perm.length === currentOrder.length &&
			perm.every((vt, i) => vt === currentOrder[i])
		);

		let nextIndex = (currentIndex + 1) % permutations.length;
		applyBipartitePermutation(groupId, nextIndex);
	}

	function rerunBridgeWithOrder(groupId, viewOrder) {
		cleanupArrangementVisuals(groupId);

		// Also clean up bridge connections, arcs, and dots immediately
		d3.selectAll(`.bridge-connection-${groupId}`).remove();

		let members = mapDragState.groupMembers.get(groupId);
		if (!members || members.size === 0) return;

		// Calculate center
		let centerX = 0, centerY = 0, count = 0;
		members.forEach(cloneId => {
			let element = document.querySelector(`[clone-id="${cloneId}"]`);
			if (element) {
				if (element.tagName === 'rect') {
					centerX += parseFloat(d3.select(element).attr('x')) + 8;
					centerY += parseFloat(d3.select(element).attr('y')) + 8;
				} else {
					centerX += parseFloat(d3.select(element).attr('cx'));
					centerY += parseFloat(d3.select(element).attr('cy'));
				}
				count++;
			}
		});
		if (count === 0) return;
		centerX /= count;
		centerY /= count;

		// Build viewGroups in specified order
		let viewGroups = new Map();
		viewOrder.forEach(vt => viewGroups.set(vt, []));

		members.forEach(cloneId => {
			let element = document.querySelector(`[clone-id="${cloneId}"]`);
			if (element) {
				let sv = element.getAttribute('source-view') || 'map';
				if (viewGroups.has(sv)) {
					viewGroups.get(sv).push(element);
				}
			}
		});

		// Remove empty
		viewGroups.forEach((elements, key) => {
			if (elements.length === 0) viewGroups.delete(key);
		});

		arrangeSmartBridgeWithOrder(viewGroups, centerX, centerY, groupId, viewOrder);

		// Redraw connections AFTER animation completes
		// arrangeSmartBridgeWithOrder already has a 400ms timeout,
		// so add a second pass at 450ms to catch final positions
		setTimeout(() => {
			drawBridgeConnectionsFromData(groupId);
			drawGroupBackground(groupId);
			drawProximityBoundary(groupId, false);
			drawGroupNameLabel(groupId);
			d3.selectAll(`.bridge-reorder-btn-${groupId}`).raise();
		}, 450);
	}

	function sortOrgElementsBySourceOrder(orgElements) {
		let elementsWithPositions = [];
		
		for (let i = 0; i < orgElements.length; i++) {
			let element = orgElements[i];
			let cloneId = element.getAttribute('clone-id');
			let numericId = cloneId.replace('orgclone', '');
			let originalElement = document.getElementById('bar' + numericId);
			
			let origY = 0;
			if (originalElement) {
				origY = parseFloat(d3.select(originalElement).attr('y')) || 0;
			}
			
			elementsWithPositions.push({ element: element, origY: origY });
		}
		
		elementsWithPositions.sort(function(a, b) {
			return a.origY - b.origY;
		});
		
		let result = [];
		for (let i = 0; i < elementsWithPositions.length; i++) {
			result.push(elementsWithPositions[i].element);
		}
		
		return result;
	}

	function startBoundaryMonitoring() {
		setInterval(() => {
			// Don't interfere during active drag operations
			if (mapDragState.isDragging || cloneDragState.isDragging || groupBoundaryDragState.isDragging) {
				return;
			}

			let boundaryCount = d3.selectAll('.proximity-boundary').size();
			let groupCount = mapDragState.groupMembers.size;

			if (boundaryCount < groupCount) {
				console.log('Missing boundaries detected, redrawing all');
				showAllProximityBoundaries();
			}

			ensureAllClonesHaveGlow();
		}, 2000);
	}

	function arrangeSunburst(viewGroups, centerX, centerY, groupId) {
		let allElements = [];
		viewGroups.forEach(elements => allElements.push(...elements));
		
		// Build hierarchy based on view types
		let rings = [];
		let viewOrder = ['org', 'map']; // Define the ring order
		
		viewOrder.forEach(viewType => {
			if (viewGroups.has(viewType)) {
				rings.push(viewGroups.get(viewType));
			}
		});
		
		// Add any remaining view types
		viewGroups.forEach((elements, viewType) => {
			if (!viewOrder.includes(viewType)) {
				rings.push(elements);
			}
		});
		
		let ringSpacing = 45;
		let startRadius = 30;
		
		rings.forEach((ringElements, ringIndex) => {
			let radius = startRadius + ringIndex * ringSpacing;
			let angleStep = (2 * Math.PI) / ringElements.length;
			
			ringElements.forEach((element, i) => {
				let angle = i * angleStep - Math.PI / 2;
				let x = centerX + radius * Math.cos(angle);
				let y = centerY + radius * Math.sin(angle);
				animateCloneToPosition(element, x, y);
			});
		});
		
		// Draw ring guides
		let canvas = d3.select('#line-canvas');
		canvas.selectAll(`.sunburst-ring-${groupId}`).remove();
		
		rings.forEach((_, ringIndex) => {
			let radius = startRadius + ringIndex * ringSpacing;
			canvas.insert('circle', ':first-child')
				.attr('class', `sunburst-ring sunburst-ring-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('cx', centerX)
				.attr('cy', centerY)
				.attr('r', radius - 10)
				.style('fill', 'none')
				.style('stroke', `rgba(100, 149, 237, ${0.3 - ringIndex * 0.05})`)
				.style('stroke-width', '1px')
				.style('stroke-dasharray', '3,3')
				.style('pointer-events', 'none');
		});
	}

	function arrangeCluster(viewGroups, centerX, centerY, groupId) {
		let allElements = [];
		viewGroups.forEach(elements => allElements.push(...elements));
		
		let allMembers = new Set(allElements.map(el => el.getAttribute('clone-id')));
		let connections = getConnectionsBetweenClones(allMembers);
		
		// Build adjacency
		let adjacency = new Map();
		allElements.forEach(el => {
			adjacency.set(el.getAttribute('clone-id'), new Set());
		});
		
		connections.forEach(conn => {
			adjacency.get(conn.source).add(conn.target);
			adjacency.get(conn.target).add(conn.source);
		});
		
		// Find connected components
		let visited = new Set();
		let clusters = [];
		
		function dfs(cloneId, cluster) {
			if (visited.has(cloneId)) return;
			visited.add(cloneId);
			cluster.push(cloneId);
			
			adjacency.get(cloneId)?.forEach(neighbor => {
				if (allMembers.has(neighbor)) {
					dfs(neighbor, cluster);
				}
			});
		}
		
		allElements.forEach(el => {
			let cloneId = el.getAttribute('clone-id');
			if (!visited.has(cloneId)) {
				let cluster = [];
				dfs(cloneId, cluster);
				clusters.push(cluster);
			}
		});
		
		// Store cluster data
		if (!mapDragState.clusterData) {
			mapDragState.clusterData = new Map();
		}
		mapDragState.clusterData.set(groupId, {
			originalCenter: { x: centerX, y: centerY },
			clusters: clusters
		});
		
		let canvas = d3.select('#line-canvas');
		canvas.selectAll(`.cluster-bg-${groupId}`).remove();
		canvas.selectAll(`.cluster-connection-${groupId}`).remove();
		canvas.selectAll(`.cluster-label-${groupId}`).remove();
		
		// Position clusters
		let clusterSpacing = clusters.length > 1 ? 120 : 0;
		let clusterAngleStep = (2 * Math.PI) / Math.max(clusters.length, 1);
		
		let clusterCenters = [];
		
		clusters.forEach((cluster, clusterIndex) => {
			let clusterAngle = clusterIndex * clusterAngleStep - Math.PI / 2;
			let clusterCenterX = centerX + clusterSpacing * Math.cos(clusterAngle);
			let clusterCenterY = centerY + clusterSpacing * Math.sin(clusterAngle);
			
			clusterCenters.push({ x: clusterCenterX, y: clusterCenterY });
			
			// Calculate cluster radius based on size
			let clusterRadius = Math.max(40, 20 * Math.sqrt(cluster.length));
			
			// Draw cluster background
			canvas.insert('circle', ':first-child')
				.attr('class', `cluster-bg cluster-bg-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-cluster-index', clusterIndex)
				.attr('cx', clusterCenterX)
				.attr('cy', clusterCenterY)
				.attr('r', clusterRadius + 20)
				.style('fill', `rgba(46, 204, 113, ${0.15 - clusterIndex * 0.03})`)
				.style('stroke', 'rgba(46, 204, 113, 0.6)')
				.style('stroke-width', '2px')
				.style('stroke-dasharray', '5,3')
				.style('pointer-events', 'none');
			
			// Add cluster label
			canvas.append('text')
				.attr('class', `cluster-label cluster-label-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-cluster-index', clusterIndex)
				.attr('x', clusterCenterX)
				.attr('y', clusterCenterY - clusterRadius - 25)
				.attr('text-anchor', 'middle')
				.style('fill', 'rgba(46, 204, 113, 0.9)')
				.style('font-size', '11px')
				.style('font-weight', 'bold')
				.style('pointer-events', 'none')
				.text(`Cluster ${clusterIndex + 1} (${cluster.length})`);
			
			// Position elements within cluster
			let itemAngleStep = (2 * Math.PI) / Math.max(cluster.length, 1);
			let itemRadius = cluster.length > 1 ? Math.min(clusterRadius - 15, 30) : 0;
			
			cluster.forEach((cloneId, i) => {
				let element = document.querySelector(`[clone-id="${cloneId}"]`);
				if (element) {
					let angle = i * itemAngleStep - Math.PI / 2;
					let x = clusterCenterX + itemRadius * Math.cos(angle);
					let y = clusterCenterY + itemRadius * Math.sin(angle);
					animateCloneToPosition(element, x, y);
				}
			});
		});
		
		// Draw connections after animation
		setTimeout(() => {
			drawClusterConnections(groupId);
		}, 400);
	}

	function drawClusterConnections(groupId) {
		let canvas = d3.select('#line-canvas');
		canvas.selectAll(`.cluster-connection-${groupId}`).remove();
		
		let members = mapDragState.groupMembers.get(groupId);
		if (!members) return;
		
		let connections = getConnectionsBetweenClones(members);
		
		connections.forEach(conn => {
			let sourceX, sourceY, targetX, targetY;
			
			if (conn.sourceElement.tagName === 'rect') {
				sourceX = parseFloat(d3.select(conn.sourceElement).attr('x')) + 8;
				sourceY = parseFloat(d3.select(conn.sourceElement).attr('y')) + 8;
			} else {
				sourceX = parseFloat(d3.select(conn.sourceElement).attr('cx'));
				sourceY = parseFloat(d3.select(conn.sourceElement).attr('cy'));
			}
			
			if (conn.targetElement.tagName === 'rect') {
				targetX = parseFloat(d3.select(conn.targetElement).attr('x')) + 8;
				targetY = parseFloat(d3.select(conn.targetElement).attr('y')) + 8;
			} else {
				targetX = parseFloat(d3.select(conn.targetElement).attr('cx'));
				targetY = parseFloat(d3.select(conn.targetElement).attr('cy'));
			}
			
			canvas.append('line')
				.attr('class', `cluster-connection cluster-connection-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-source', conn.source)
				.attr('data-target', conn.target)
				.attr('x1', sourceX)
				.attr('y1', sourceY)
				.attr('x2', targetX)
				.attr('y2', targetY)
				.style('stroke', '#e74c3c')
				.style('stroke-width', '3px')
				.style('stroke-opacity', '0.8')
				.style('pointer-events', 'none');
			
			let midX = (sourceX + targetX) / 2;
			let midY = (sourceY + targetY) / 2;
			
			canvas.append('circle')
				.attr('class', `cluster-connection cluster-connection-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-source', conn.source)
				.attr('data-target', conn.target)
				.attr('cx', midX)
				.attr('cy', midY)
				.attr('r', 5)
				.style('fill', '#e74c3c')
				.style('stroke', 'white')
				.style('stroke-width', '2px')
				.style('pointer-events', 'none');
		});
	}

	function arrangeMatrix(viewGroups, centerX, centerY, groupId) {
		let viewTypes = Array.from(viewGroups.keys());

		if (viewTypes.length < 2) {
			arrangeGrid(viewGroups, centerX, centerY);
			return;
		}

		// === 2 view types: existing behavior, completely unchanged ===
		if (viewTypes.length === 2) {
			let rowType = viewTypes[0];
			let colType = viewTypes[1];
			let rowElements = viewGroups.get(rowType) || [];
			let colElements = viewGroups.get(colType) || [];

			if (rowElements.length === 0 || colElements.length === 0) {
				arrangeGrid(viewGroups, centerX, centerY);
				return;
			}

			let cellSize = 40;
			let headerOffset = 70;

			let matrixWidth = colElements.length * cellSize;
			let matrixHeight = rowElements.length * cellSize;

			let startX = centerX - matrixWidth / 2;
			let startY = centerY - matrixHeight / 2;

			if (!mapDragState.matrixData) {
				mapDragState.matrixData = new Map();
			}
			mapDragState.matrixData.set(groupId, {
				originalCenter: { x: centerX, y: centerY },
				cellSize: cellSize,
				headerOffset: headerOffset
			});

			let canvas = d3.select('#line-canvas');
			canvas.selectAll(`.matrix-cell-${groupId}`).remove();
			canvas.selectAll(`.matrix-label-${groupId}`).remove();
			canvas.selectAll(`.matrix-grid-${groupId}`).remove();

			canvas.insert('rect', ':first-child')
				.attr('class', `matrix-grid matrix-grid-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-orig-x', startX - 5)
				.attr('data-orig-y', startY - 5)
				.attr('x', startX - 5)
				.attr('y', startY - 5)
				.attr('width', matrixWidth + 10)
				.attr('height', matrixHeight + 10)
				.attr('rx', 5)
				.style('fill', 'rgba(52, 73, 94, 0.1)')
				.style('stroke', 'rgba(52, 73, 94, 0.3)')
				.style('stroke-width', '2px')
				.style('pointer-events', 'none');

			canvas.append('text')
				.attr('class', `matrix-label matrix-label-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-orig-x', startX - headerOffset)
				.attr('data-orig-y', centerY)
				.attr('x', startX - headerOffset)
				.attr('y', centerY)
				.attr('text-anchor', 'middle')
				.attr('transform', `rotate(-90, ${startX - headerOffset}, ${centerY})`)
				.style('fill', '#3498db')
				.style('font-size', '14px')
				.style('font-weight', 'bold')
				.style('pointer-events', 'none')
				.text(rowType.toUpperCase());

			canvas.append('text')
				.attr('class', `matrix-label matrix-label-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-orig-x', centerX)
				.attr('data-orig-y', startY - headerOffset + 20)
				.attr('x', centerX)
				.attr('y', startY - headerOffset + 20)
				.attr('text-anchor', 'middle')
				.style('fill', '#e74c3c')
				.style('font-size', '14px')
				.style('font-weight', 'bold')
				.style('pointer-events', 'none')
				.text(colType.toUpperCase());

			rowElements.forEach((element, i) => {
				let x = startX - headerOffset + 30;
				let y = startY + i * cellSize + cellSize / 2;
				animateCloneToPosition(element, x, y);
			});

			colElements.forEach((element, j) => {
				let x = startX + j * cellSize + cellSize / 2;
				let y = startY - headerOffset + 40;
				animateCloneToPosition(element, x, y);
			});

			setTimeout(() => {
				drawMatrixCells2D(groupId, rowElements, colElements, startX, startY, cellSize);
			}, 400);
			return;
		}

		// === 3+ view types ===
		let allViewElements = new Map();
		viewGroups.forEach((elements, viewType) => {
			let arr = Array.from(elements);
			if (viewType === 'org') arr = sortOrgElementsBySourceOrder(arr);
			allViewElements.set(viewType, arr);
		});

		let typeColors = {
			'map':    { stroke: '#3498db', fill: 'rgba(52, 152, 219, 0.15)', label: '#2980b9' },
			'org':    { stroke: '#e74c3c', fill: 'rgba(231, 76, 60, 0.15)',  label: '#c0392b' },
			'person': { stroke: '#2ecc71', fill: 'rgba(46, 204, 113, 0.15)', label: '#27ae60' }
		};
		let defaultColor = { stroke: '#9b59b6', fill: 'rgba(155, 89, 182, 0.15)', label: '#8e44ad' };

		let pairs = [];
		for (let i = 0; i < viewTypes.length; i++) {
			for (let j = i + 1; j < viewTypes.length; j++) {
				pairs.push([viewTypes[i], viewTypes[j]]);
			}
		}

		let cellSize = 38;
		let headerOffset = 65;
		let layerOffsetX = 22;
		let layerOffsetY = -22;

		if (!mapDragState.matrixData) mapDragState.matrixData = new Map();
		if (!mapDragState.matrixLayerState) mapDragState.matrixLayerState = new Map();
		if (!mapDragState.matrixDisplayMode) mapDragState.matrixDisplayMode = new Map();
		if (!mapDragState.matrixViewOrder) mapDragState.matrixViewOrder = new Map();

		// Store/retrieve the current variable ordering for this group
		if (!mapDragState.matrixViewOrder.has(groupId)) {
			mapDragState.matrixViewOrder.set(groupId, [...viewTypes]);
		}

		mapDragState.matrixLayerState.set(groupId, {
			pairs: pairs,
			activeLayerIndex: 0,
			allViewElements: allViewElements,
			centerX: centerX,
			centerY: centerY,
			cellSize: cellSize,
			headerOffset: headerOffset,
			layerOffsetX: layerOffsetX,
			layerOffsetY: layerOffsetY,
			typeColors: typeColors,
			defaultColor: defaultColor,
			viewTypes: viewTypes
		});

		mapDragState.matrixData.set(groupId, {
			originalCenter: { x: centerX, y: centerY },
			cellSize: cellSize,
			headerOffset: headerOffset
		});

		let currentMode = mapDragState.matrixDisplayMode.get(groupId) || 'tabbed';

		if (currentMode === 'all') {
			drawCombinedMatrixView(groupId);
		} else {
			drawStackedMatrixLayers(groupId, 0);
		}
	}

	function drawStackedMatrixLayers(groupId, activeIndex) {
		let layerState = mapDragState.matrixLayerState?.get(groupId);
		if (!layerState) return;

		let { pairs, allViewElements, centerX, centerY, cellSize, headerOffset,
			  layerOffsetX, layerOffsetY, typeColors, defaultColor, viewTypes } = layerState;

		layerState.activeLayerIndex = activeIndex;

		let canvas = d3.select('#line-canvas');

		// Clean up all matrix visuals for this group
		canvas.selectAll(`.matrix-cell-${groupId}`).remove();
		canvas.selectAll(`.matrix-label-${groupId}`).remove();
		canvas.selectAll(`.matrix-grid-${groupId}`).remove();
		canvas.selectAll(`.matrix-layer-${groupId}`).remove();
		canvas.selectAll(`.matrix-ribbon-${groupId}`).remove();


		let activePair = pairs[activeIndex];
		let activeRowType = activePair[0];
		let activeColType = activePair[1];
		let activeRowElements = allViewElements.get(activeRowType) || [];
		let activeColElements = allViewElements.get(activeColType) || [];

		// Calculate active grid dimensions
		let gridWidth = activeColElements.length * cellSize;
		let gridHeight = activeRowElements.length * cellSize;

		// The front matrix grid origin
		let startX = centerX - gridWidth / 2;
		let startY = centerY - gridHeight / 2;

		// Card dimensions for the front layer
		let cardPadding = 18;
		let frontCardX = startX - headerOffset - cardPadding + 20;
		let frontCardY = startY - headerOffset - cardPadding + 20;
		let frontCardWidth = gridWidth + headerOffset + cardPadding * 2;
		let frontCardHeight = gridHeight + headerOffset + cardPadding * 2;

		// Total number of back layers
		let backLayerCount = pairs.length - 1;

		// --- Draw back layer cards (from furthest to nearest) ---
		// Build draw order: furthest back first, active last
		let backIndices = [];
		for (let i = 0; i < pairs.length; i++) {
			if (i !== activeIndex) backIndices.push(i);
		}
		// Reverse so furthest is drawn first
		backIndices.reverse();

		backIndices.forEach((layerIdx, drawOrder) => {
			let pair = pairs[layerIdx];
			let rowType = pair[0];
			let colType = pair[1];

			// Depth: furthest back = backLayerCount, nearest back = 1
			let depth = backLayerCount - drawOrder;

			let cardOffX = depth * layerOffsetX;
			let cardOffY = depth * layerOffsetY;

			let backCardX = frontCardX + cardOffX;
			let backCardY = frontCardY + cardOffY;

			let opacity = Math.max(0.35, 0.85 - depth * 0.2);

			// Back layer card
			canvas.insert('rect', ':first-child')
				.attr('class', `matrix-layer matrix-layer-${groupId} matrix-grid matrix-grid-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-layer-index', layerIdx)
				.attr('data-orig-x', backCardX)
				.attr('data-orig-y', backCardY)
				.attr('x', backCardX)
				.attr('y', backCardY)
				.attr('width', frontCardWidth)
				.attr('height', frontCardHeight)
				.attr('rx', 8)
				.style('fill', `rgba(235, 237, 242, ${opacity})`)
				.style('stroke', `rgba(52, 73, 94, ${opacity * 0.5})`)
				.style('stroke-width', '1.5px')
				.style('cursor', 'pointer')
				.style('pointer-events', 'all')
				.on('click', function() {
					d3.event.stopPropagation();
					switchMatrixLayer(groupId, layerIdx);
				});

			// Tab label on back card
			let tabWidth = 105;
			let tabHeight = 20;
			let tabX = backCardX + frontCardWidth - tabWidth - 8;
			let tabY = backCardY - tabHeight - 4;

			canvas.append('rect')
				.attr('class', `matrix-layer matrix-layer-${groupId} matrix-label matrix-label-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-layer-index', layerIdx)
				.attr('data-orig-x', tabX)
				.attr('data-orig-y', tabY)
				.attr('x', tabX)
				.attr('y', tabY)
				.attr('width', tabWidth)
				.attr('height', tabHeight)
				.attr('rx', 4)
				.style('fill', `rgba(52, 73, 94, ${opacity * 0.7})`)
				.style('cursor', 'pointer')
				.style('pointer-events', 'all')
				.on('click', function() {
					d3.event.stopPropagation();
					switchMatrixLayer(groupId, layerIdx);
				});

			canvas.append('text')
				.attr('class', `matrix-layer matrix-layer-${groupId} matrix-label matrix-label-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-layer-index', layerIdx)
				.attr('data-orig-x', tabX + tabWidth / 2)
				.attr('data-orig-y', tabY + tabHeight / 2 + 4)
				.attr('x', tabX + tabWidth / 2)
				.attr('y', tabY + tabHeight / 2 + 4)
				.attr('text-anchor', 'middle')
				.style('fill', 'white')
				.style('font-size', '10px')
				.style('font-weight', 'bold')
				.style('letter-spacing', '0.5px')
				.style('opacity', opacity)
				.style('cursor', 'pointer')
				.style('pointer-events', 'all')
				.text(`${rowType.toUpperCase()} × ${colType.toUpperCase()}`)
				.on('click', function() {
					d3.event.stopPropagation();
					switchMatrixLayer(groupId, layerIdx);
				});
		});

		// --- Draw front (active) layer card ---
		canvas.append('rect')
			.attr('class', `matrix-layer matrix-layer-${groupId} matrix-grid matrix-grid-${groupId}`)
			.attr('data-group-id', groupId)
			.attr('data-layer-index', activeIndex)
			.attr('data-orig-x', frontCardX)
			.attr('data-orig-y', frontCardY)
			.attr('x', frontCardX)
			.attr('y', frontCardY)
			.attr('width', frontCardWidth)
			.attr('height', frontCardHeight)
			.attr('rx', 8)
			.style('fill', 'rgba(255, 255, 255, 0.95)')
			.style('stroke', 'rgba(52, 73, 94, 0.5)')
			.style('stroke-width', '2px')
			.style('filter', 'drop-shadow(0 2px 8px rgba(0,0,0,0.12))')
			.style('pointer-events', 'none');

		// Active tab
		let activeTabWidth = 105;
		let activeTabHeight = 20;
		let activeTabX = frontCardX + frontCardWidth - activeTabWidth - 8;
		let activeTabY = frontCardY - activeTabHeight - 4;

		canvas.append('rect')
			.attr('class', `matrix-layer matrix-layer-${groupId} matrix-label matrix-label-${groupId}`)
			.attr('data-group-id', groupId)
			.attr('data-layer-index', activeIndex)
			.attr('data-orig-x', activeTabX)
			.attr('data-orig-y', activeTabY)
			.attr('x', activeTabX)
			.attr('y', activeTabY)
			.attr('width', activeTabWidth)
			.attr('height', activeTabHeight)
			.attr('rx', 4)
			.style('fill', 'rgba(52, 73, 94, 0.9)')
			.style('pointer-events', 'none');

		canvas.append('text')
			.attr('class', `matrix-layer matrix-layer-${groupId} matrix-label matrix-label-${groupId}`)
			.attr('data-group-id', groupId)
			.attr('data-layer-index', activeIndex)
			.attr('data-orig-x', activeTabX + activeTabWidth / 2)
			.attr('data-orig-y', activeTabY + activeTabHeight / 2 + 4)
			.attr('x', activeTabX + activeTabWidth / 2)
			.attr('y', activeTabY + activeTabHeight / 2 + 4)
			.attr('text-anchor', 'middle')
			.style('fill', 'white')
			.style('font-size', '10px')
			.style('font-weight', 'bold')
			.style('letter-spacing', '0.5px')
			.style('pointer-events', 'none')
			.text(`${activeRowType.toUpperCase()} × ${activeColType.toUpperCase()}`);

		// --- Grid background inside front card ---
		canvas.append('rect')
			.attr('class', `matrix-grid matrix-grid-${groupId}`)
			.attr('data-group-id', groupId)
			.attr('data-orig-x', startX - 4)
			.attr('data-orig-y', startY - 4)
			.attr('x', startX - 4)
			.attr('y', startY - 4)
			.attr('width', gridWidth + 8)
			.attr('height', gridHeight + 8)
			.attr('rx', 4)
			.style('fill', 'rgba(52, 73, 94, 0.04)')
			.style('stroke', 'rgba(52, 73, 94, 0.15)')
			.style('stroke-width', '1px')
			.style('pointer-events', 'none');

		// --- Row axis label ---
		let rowColor = typeColors[activeRowType] || defaultColor;
		let colColor = typeColors[activeColType] || defaultColor;

		let rowLabelX = startX - headerOffset + 12;
		let rowLabelY = startY + gridHeight / 2;
		canvas.append('text')
			.attr('class', `matrix-label matrix-label-${groupId}`)
			.attr('data-group-id', groupId)
			.attr('data-orig-x', rowLabelX)
			.attr('data-orig-y', rowLabelY)
			.attr('x', rowLabelX)
			.attr('y', rowLabelY)
			.attr('text-anchor', 'middle')
			.attr('transform', `rotate(-90, ${rowLabelX}, ${rowLabelY})`)
			.style('fill', rowColor.label)
			.style('font-size', '13px')
			.style('font-weight', 'bold')
			.style('pointer-events', 'none')
			.text(activeRowType.toUpperCase());

		// --- Column axis label ---
		let colLabelX = startX + gridWidth / 2;
		let colLabelY = startY - headerOffset + 28;
		canvas.append('text')
			.attr('class', `matrix-label matrix-label-${groupId}`)
			.attr('data-group-id', groupId)
			.attr('data-orig-x', colLabelX)
			.attr('data-orig-y', colLabelY)
			.attr('x', colLabelX)
			.attr('y', colLabelY)
			.attr('text-anchor', 'middle')
			.style('fill', colColor.label)
			.style('font-size', '13px')
			.style('font-weight', 'bold')
			.style('pointer-events', 'none')
			.text(activeColType.toUpperCase());

		// --- Position active row elements ---
		activeRowElements.forEach((element, i) => {
			let x = startX - headerOffset + 38;
			let y = startY + i * cellSize + cellSize / 2;
			animateCloneToPosition(element, x, y);
		});

		// --- Position active column elements ---
		activeColElements.forEach((element, j) => {
			let x = startX + j * cellSize + cellSize / 2;
			let y = startY - headerOffset + 44;
			animateCloneToPosition(element, x, y);
		});

		// --- Hide elements NOT in the active pair ---
		// Move them to a tucked position just below the front card, semi-transparent
		let inactiveSets = new Set();
		let activeRowIds = new Set(activeRowElements.map(e => e.getAttribute('clone-id')));
		let activeColIds = new Set(activeColElements.map(e => e.getAttribute('clone-id')));

		viewTypes.forEach(vt => {
			if (vt !== activeRowType && vt !== activeColType) {
				let elements = allViewElements.get(vt) || [];
				elements.forEach(el => inactiveSets.add(el));
			}
		});

		if (inactiveSets.size > 0) {
			let inactiveArr = Array.from(inactiveSets);
			let tuckY = frontCardY + frontCardHeight + 25;
			let tuckSpacing = 24;
			let tuckStartX = frontCardX + frontCardWidth / 2 - ((inactiveArr.length - 1) * tuckSpacing) / 2;

			// Get the inactive type for labeling
			let inactiveTypes = viewTypes.filter(vt => vt !== activeRowType && vt !== activeColType);

			let currentTuckX = tuckStartX;
			inactiveTypes.forEach(vt => {
				let vtColor = typeColors[vt] || defaultColor;
				let vtElements = allViewElements.get(vt) || [];

				// Small type label
				let labelX = currentTuckX + ((vtElements.length - 1) * tuckSpacing) / 2;
				canvas.append('text')
					.attr('class', `matrix-label matrix-label-${groupId}`)
					.attr('data-group-id', groupId)
					.attr('data-orig-x', labelX)
					.attr('data-orig-y', tuckY - 15)
					.attr('x', labelX)
					.attr('y', tuckY - 15)
					.attr('text-anchor', 'middle')
					.style('fill', vtColor.label)
					.style('font-size', '10px')
					.style('font-weight', 'bold')
					.style('opacity', '0.6')
					.style('pointer-events', 'none')
					.text(vt.toUpperCase() + ' (switch layer to view)');

				vtElements.forEach((element, i) => {
					let x = currentTuckX + i * tuckSpacing;
					animateCloneToPosition(element, x, tuckY);
					// Dim the inactive elements
					setTimeout(() => {
						d3.select(element).style('opacity', '0.4');
					}, 350);
					currentTuckX += 0; // Don't add here, add after loop
				});
				currentTuckX += vtElements.length * tuckSpacing + 20;
			});
		}

		// --- Draw matrix cells ---
		setTimeout(() => {
			drawMatrixCells2D(groupId, activeRowElements, activeColElements, startX, startY, cellSize);
		}, 400);

		// Reorder SVG so clones are on top of cards
		reorderSVGElements();

		// Restore full opacity on active elements (in case they were dimmed before)
		setTimeout(() => {
			activeRowElements.forEach(el => d3.select(el).style('opacity', '1'));
			activeColElements.forEach(el => d3.select(el).style('opacity', '1'));
		}, 350);
	
	    drawMatrixToggleControl(groupId, 'tabbed');

	}

	function toggleMatrixDisplayMode(groupId, newMode) {
		if (!mapDragState.matrixDisplayMode) {
			mapDragState.matrixDisplayMode = new Map();
		}

		let currentMode = mapDragState.matrixDisplayMode.get(groupId) || 'tabbed';
		if (currentMode === newMode) return;

		mapDragState.matrixDisplayMode.set(groupId, newMode);

		let layerState = mapDragState.matrixLayerState?.get(groupId);
		if (!layerState) return;

		// Restore opacity on all elements before switching
		layerState.allViewElements.forEach((elements) => {
			elements.forEach(el => d3.select(el).style('opacity', '1'));
		});

		let canvas = d3.select('#line-canvas');

		// Clean up all visuals
		canvas.selectAll(`.matrix-cell-${groupId}`).remove();
		canvas.selectAll(`.matrix-label-${groupId}`).remove();
		canvas.selectAll(`.matrix-grid-${groupId}`).remove();
		canvas.selectAll(`.matrix-layer-${groupId}`).remove();
		canvas.selectAll(`.matrix-toggle-${groupId}`).remove();
		canvas.selectAll(`.matrix-connector-${groupId}`).remove();
		canvas.selectAll(`.matrix-anchor-${groupId}`).remove();
		canvas.selectAll(`.matrix-order-btn-${groupId}`).remove();
		canvas.selectAll(`.matrix-ribbon-${groupId}`).remove();


		if (newMode === 'all') {
			drawCombinedMatrixView(groupId);
		} else {
			let activeIndex = layerState.activeLayerIndex || 0;
			drawStackedMatrixLayers(groupId, activeIndex);
		}

		setTimeout(() => {
			drawGroupBackground(groupId);
			drawProximityBoundary(groupId, false);
			if (typeof drawGroupNameLabel === 'function') {
				drawGroupNameLabel(groupId);
			}
		}, 450);
	}

	function drawCombinedMatrixView(groupId) {
		let layerState = mapDragState.matrixLayerState?.get(groupId);
		if (!layerState) return;

		let { allViewElements, centerX, centerY, cellSize, headerOffset,
			  typeColors, defaultColor } = layerState;

		let viewOrder = mapDragState.matrixViewOrder?.get(groupId);
		if (!viewOrder || viewOrder.length < 3) {
			viewOrder = layerState.viewTypes;
		}

		let A = viewOrder[0];
		let B = viewOrder[1];
		let C = viewOrder[2];

		let aElements = allViewElements.get(A) || [];
		let bElements = allViewElements.get(B) || [];
		let cElements = allViewElements.get(C) || [];

		let aColor = typeColors[A] || defaultColor;
		let bColor = typeColors[B] || defaultColor;
		let cColor = typeColors[C] || defaultColor;

		let canvas = d3.select('#line-canvas');

		canvas.selectAll(`.matrix-cell-${groupId}`).remove();
		canvas.selectAll(`.matrix-label-${groupId}`).remove();
		canvas.selectAll(`.matrix-grid-${groupId}`).remove();
		canvas.selectAll(`.matrix-layer-${groupId}`).remove();
		canvas.selectAll(`.matrix-toggle-${groupId}`).remove();
		canvas.selectAll(`.matrix-connector-${groupId}`).remove();
		canvas.selectAll(`.matrix-anchor-${groupId}`).remove();
		canvas.selectAll(`.matrix-order-btn-${groupId}`).remove();
		canvas.selectAll(`.matrix-ribbon-${groupId}`).remove();

		// ── Geometry ──
		let anchorZone = 44;
		let matrixGap = anchorZone + 16;

		let trCols = aElements.length;
		let trRows = bElements.length;
		let trW = trCols * cellSize;
		let trH = trRows * cellSize;

		let blCols = aElements.length;
		let blRows = cElements.length;
		let blW = blCols * cellSize;
		let blH = blRows * cellSize;

		let brCols = bElements.length;
		let brRows = cElements.length;
		let brW = brCols * cellSize;
		let brH = brRows * cellSize;

		let leftAxisSpace = headerOffset;
		let topAxisSpace = headerOffset;

		let totalW = leftAxisSpace + Math.max(trW, blW) + matrixGap + brW + 20;
		let totalH = topAxisSpace + trH + matrixGap + blH + 20;

		let originX = centerX - totalW / 2;
		let originY = centerY - totalH / 2;

		let trStartX = originX + leftAxisSpace;
		let trStartY = originY + topAxisSpace;

		let blStartX = trStartX;
		let blStartY = trStartY + trH + matrixGap;

		let brStartX = trStartX + Math.max(trW, blW) + matrixGap;
		let brStartY = blStartY;

		// B anchor: vertical strip between top-right and bottom-right
		let bAnchorX = trStartX + Math.max(trW, blW) + matrixGap / 2;

		// A anchor: horizontal strip between top-right and bottom-left
		let aAnchorY = trStartY + trH + matrixGap / 2;

		// C anchor: vertical strip on left
		let cAnchorX = originX + leftAxisSpace / 2 - 5;

		if (!mapDragState.combinedMatrixLayout) {
			mapDragState.combinedMatrixLayout = new Map();
		}
		mapDragState.combinedMatrixLayout.set(groupId, {
			trStartX, trStartY, trW, trH,
			blStartX, blStartY, blW, blH,
			brStartX, brStartY, brW, brH,
			aAnchorY, bAnchorX, cAnchorX,
			cellSize, matrixGap, anchorZone,
			A, B, C, aElements, bElements, cElements
		});

		// ── Background card ──
		let cardPad = 20;
		let cardX = originX - cardPad + leftAxisSpace / 2;
		let cardY = originY - cardPad + topAxisSpace / 2;
		let cardW = totalW + cardPad;
		let cardH = totalH + cardPad;

		canvas.append('rect')
			.attr('class', `matrix-grid matrix-grid-${groupId}`)
			.attr('data-group-id', groupId)
			.attr('data-orig-x', cardX)
			.attr('data-orig-y', cardY)
			.attr('x', cardX)
			.attr('y', cardY)
			.attr('width', cardW)
			.attr('height', cardH)
			.attr('rx', 10)
			.style('fill', 'rgba(255, 255, 255, 0.92)')
			.style('stroke', 'rgba(52, 73, 94, 0.25)')
			.style('stroke-width', '2px')
			.style('filter', 'drop-shadow(0 2px 10px rgba(0,0,0,0.08))')
			.style('pointer-events', 'none');

		// ── Three matrix grids ──
		drawCombinedMatrixGrid(canvas, groupId, trStartX, trStartY, trW, trH, 'tr');
		drawCombinedMatrixGrid(canvas, groupId, blStartX, blStartY, blW, blH, 'bl');
		drawCombinedMatrixGrid(canvas, groupId, brStartX, brStartY, brW, brH, 'br');

		// ── Pair labels ──
		drawCombinedPairLabel(canvas, groupId, trStartX + trW / 2, trStartY + trH + 14,
			`${A} × ${B}`, aColor, bColor);
		drawCombinedPairLabel(canvas, groupId, blStartX + blW / 2, blStartY + blH + 14,
			`${A} × ${C}`, aColor, cColor);
		drawCombinedPairLabel(canvas, groupId, brStartX + brW / 2, brStartY + brH + 14,
			`${B} × ${C}`, bColor, cColor);

		// ── Axis type labels ──
		canvas.append('text')
			.attr('class', `matrix-label matrix-label-${groupId}`)
			.attr('data-group-id', groupId)
			.attr('data-orig-x', trStartX + trW / 2)
			.attr('data-orig-y', trStartY - 16)
			.attr('x', trStartX + trW / 2)
			.attr('y', trStartY - 16)
			.attr('text-anchor', 'middle')
			.style('fill', aColor.label)
			.style('font-size', '13px')
			.style('font-weight', 'bold')
			.style('pointer-events', 'none')
			.text(A.toUpperCase());

		let bLabelX = bAnchorX + 24;
		let bLabelY = trStartY + trH / 2;
		canvas.append('text')
			.attr('class', `matrix-label matrix-label-${groupId}`)
			.attr('data-group-id', groupId)
			.attr('data-orig-x', bLabelX)
			.attr('data-orig-y', bLabelY)
			.attr('x', bLabelX)
			.attr('y', bLabelY)
			.attr('text-anchor', 'middle')
			.attr('transform', `rotate(90, ${bLabelX}, ${bLabelY})`)
			.style('fill', bColor.label)
			.style('font-size', '13px')
			.style('font-weight', 'bold')
			.style('pointer-events', 'none')
			.text(B.toUpperCase());

		let cLabelX = cAnchorX - 18;
		let cLabelY = blStartY + blH / 2;
		canvas.append('text')
			.attr('class', `matrix-label matrix-label-${groupId}`)
			.attr('data-group-id', groupId)
			.attr('data-orig-x', cLabelX)
			.attr('data-orig-y', cLabelY)
			.attr('x', cLabelX)
			.attr('y', cLabelY)
			.attr('text-anchor', 'middle')
			.attr('transform', `rotate(-90, ${cLabelX}, ${cLabelY})`)
			.style('fill', cColor.label)
			.style('font-size', '13px')
			.style('font-weight', 'bold')
			.style('pointer-events', 'none')
			.text(C.toUpperCase());

		// ── A connectors: dashed lines (NOT ribbons) ──
		aElements.forEach((element, j) => {
			let x = trStartX + j * cellSize + cellSize / 2;
			canvas.append('line')
				.attr('class', `matrix-connector matrix-connector-${groupId} matrix-label matrix-label-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-orig-x', x)
				.attr('data-orig-y', trStartY + trH)
				.attr('x1', x).attr('y1', trStartY + trH)
				.attr('x2', x).attr('y2', aAnchorY - 12)
				.style('stroke', aColor.stroke)
				.style('stroke-width', '1px')
				.style('stroke-dasharray', '3,3')
				.style('opacity', '0.35')
				.style('pointer-events', 'none');
			canvas.append('line')
				.attr('class', `matrix-connector matrix-connector-${groupId} matrix-label matrix-label-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-orig-x', x)
				.attr('data-orig-y', aAnchorY + 12)
				.attr('x1', x).attr('y1', aAnchorY + 12)
				.attr('x2', x).attr('y2', blStartY)
				.style('stroke', aColor.stroke)
				.style('stroke-width', '1px')
				.style('stroke-dasharray', '3,3')
				.style('opacity', '0.35')
				.style('pointer-events', 'none');
		});

		// ── B connectors: RIBBONS ──
		// B[i] is row i in top-right matrix (y aligned) — ribbon goes LEFT
		// B[i] is column i in bottom-right matrix — ribbon goes DOWN to brStartX + i*cellSize
		bElements.forEach((element, i) => {
			let elemY = trStartY + i * cellSize + cellSize / 2;

			// Ribbon LEFT: from B anchor into top-right row i
			let ribbonLeftX1 = bAnchorX - 12;
			let ribbonLeftX2 = trStartX + trW;
			drawRibbonPath(canvas, groupId, bColor,
				ribbonLeftX1, elemY, ribbonLeftX2, elemY,
				'horizontal');

			// Ribbon DOWN: from B anchor down to bottom-right column i
			// B[i] maps to column i in bottom-right
			let reversedColIdx = bElements.length - 1 - i;
			let brColX = brStartX + reversedColIdx * cellSize + cellSize / 2;
			// The ribbon starts from the B element position and curves down to the column top
			drawRibbonPath(canvas, groupId, bColor,
				bAnchorX, elemY + 12, brColX, brStartY,
				'curve');
		});

		// ── C connectors: dashed lines (NOT ribbons) ──
		cElements.forEach((element, i) => {
			let y = blStartY + i * cellSize + cellSize / 2;
			canvas.append('line')
				.attr('class', `matrix-connector matrix-connector-${groupId} matrix-label matrix-label-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-orig-x', cAnchorX + 12)
				.attr('data-orig-y', y)
				.attr('x1', cAnchorX + 12).attr('y1', y)
				.attr('x2', blStartX).attr('y2', y)
				.style('stroke', cColor.stroke)
				.style('stroke-width', '1px')
				.style('stroke-dasharray', '3,3')
				.style('opacity', '0.35')
				.style('pointer-events', 'none');
			canvas.append('line')
				.attr('class', `matrix-connector matrix-connector-${groupId} matrix-label matrix-label-${groupId}`)
				.attr('data-group-id', groupId)
				.attr('data-orig-x', blStartX + blW)
				.attr('data-orig-y', y)
				.attr('x1', blStartX + blW).attr('y1', y)
				.attr('x2', brStartX).attr('y2', y)
				.style('stroke', cColor.stroke)
				.style('stroke-width', '1px')
				.style('stroke-dasharray', '3,3')
				.style('opacity', '0.25')
				.style('pointer-events', 'none');
		});

		// ── Position clone elements ──
		aElements.forEach((element, j) => {
			let x = trStartX + j * cellSize + cellSize / 2;
			let y = aAnchorY;
			animateCloneToPosition(element, x, y);
		});

		bElements.forEach((element, i) => {
			let x = bAnchorX;
			let y = trStartY + i * cellSize + cellSize / 2;
			animateCloneToPosition(element, x, y);
		});

		cElements.forEach((element, i) => {
			let x = cAnchorX;
			let y = blStartY + i * cellSize + cellSize / 2;
			animateCloneToPosition(element, x, y);
		});

		// ── Draw matrix cells ──
		setTimeout(() => {
			drawMatrixCells2DForPair(groupId, bElements, aElements,
				trStartX, trStartY, cellSize, 0, bColor, aColor);
			drawMatrixCells2DForPair(groupId, cElements, aElements,
				blStartX, blStartY, cellSize, 1, cColor, aColor);
			let bElementsReversed = [...bElements].reverse();
			drawMatrixCells2DForPair(groupId, cElements, bElementsReversed,
				brStartX, brStartY, cellSize, 2, cColor, bColor);
		}, 400);

		// ── Restore opacity ──
		setTimeout(() => {
			allViewElements.forEach((elements) => {
				elements.forEach(el => d3.select(el).style('opacity', '1'));
			});
		}, 350);

		drawMatrixToggleControl(groupId, 'all');
		drawMatrixOrderButtons(groupId);

		reorderSVGElements();
	}

	function drawRibbonPath(canvas, groupId, color, x1, y1, x2, y2, direction) {
		let ribbonWidth = 7;
		let halfW = ribbonWidth / 2;
		let taperNarrow = halfW * 0.35;
		let fillColor = color.stroke || color.label || '#3498db';
		let d;

		if (direction === 'horizontal') {
			// Straight horizontal ribbon: wide at source (x1), tapers at target (x2)
			let midX = (x1 + x2) / 2;
			d = `M${x1},${y1 - halfW} `
			  + `C${midX},${y1 - halfW} ${midX},${y2 - taperNarrow} ${x2},${y2 - taperNarrow} `
			  + `L${x2},${y2 + taperNarrow} `
			  + `C${midX},${y2 + taperNarrow} ${midX},${y1 + halfW} ${x1},${y1 + halfW} Z`;
		} else if (direction === 'curve') {
			// Curved ribbon from a vertical anchor point down to a horizontal column
			// x1,y1 = start (near B element), x2,y2 = end (top of BR column)
			// Use cubic bezier that goes down then bends toward column
			let cp1x = x1;
			let cp1y = y1 + (y2 - y1) * 0.55;
			let cp2x = x2;
			let cp2y = y1 + (y2 - y1) * 0.45;

			// Left edge of ribbon
			d = `M${x1 - halfW},${y1} `
			  + `C${cp1x - halfW},${cp1y} ${cp2x - taperNarrow},${cp2y} ${x2 - taperNarrow},${y2} `
			  + `L${x2 + taperNarrow},${y2} `
			  + `C${cp2x + taperNarrow},${cp2y} ${cp1x + halfW},${cp1y} ${x1 + halfW},${y1} Z`;
		}

		// Store the endpoints as data attributes for drag reconstruction
		canvas.append('path')
			.attr('class', `matrix-ribbon matrix-ribbon-${groupId} matrix-label matrix-label-${groupId}`)
			.attr('data-group-id', groupId)
			.attr('data-ribbon-x1', x1)
			.attr('data-ribbon-y1', y1)
			.attr('data-ribbon-x2', x2)
			.attr('data-ribbon-y2', y2)
			.attr('data-ribbon-dir', direction)
			.attr('data-orig-x', x1)
			.attr('data-orig-y', y1)
			.attr('d', d)
			.style('fill', fillColor)
			.style('opacity', 0.18)
			.style('pointer-events', 'none');
	}

	function drawRibbonConnector(canvas, groupId, color, x1, y1, x2, y2, width, opacity, direction) {
		let halfW = width / 2;
		let d;

		if (direction === 'vertical') {
			// Ribbon tapers from element (wider) to matrix edge (narrower)
			let topY = Math.min(y1, y2);
			let botY = Math.max(y1, y2);
			let taperNarrow = halfW * 0.4;
			d = `M${x1 - halfW},${y1} `
			  + `C${x1 - halfW},${(y1 + y2) / 2} ${x2 - taperNarrow},${(y1 + y2) / 2} ${x2 - taperNarrow},${y2} `
			  + `L${x2 + taperNarrow},${y2} `
			  + `C${x2 + taperNarrow},${(y1 + y2) / 2} ${x1 + halfW},${(y1 + y2) / 2} ${x1 + halfW},${y1} Z`;
		} else if (direction === 'horizontal') {
			let taperNarrow = halfW * 0.4;
			d = `M${x1},${y1 - halfW} `
			  + `C${(x1 + x2) / 2},${y1 - halfW} ${(x1 + x2) / 2},${y2 - taperNarrow} ${x2},${y2 - taperNarrow} `
			  + `L${x2},${y2 + taperNarrow} `
			  + `C${(x1 + x2) / 2},${y2 + taperNarrow} ${(x1 + x2) / 2},${y1 + halfW} ${x1},${y1 + halfW} Z`;
		} else {
			// Diagonal — use a simple tapered path
			let taperNarrow = halfW * 0.3;
			let midX = (x1 + x2) / 2;
			let midY = (y1 + y2) / 2;
			// Perpendicular offset for width at start
			let dx = x2 - x1, dy = y2 - y1;
			let len = Math.sqrt(dx * dx + dy * dy) || 1;
			let px = -dy / len, py = dx / len;
			d = `M${x1 + px * halfW},${y1 + py * halfW} `
			  + `Q${midX + px * halfW * 0.5},${midY + py * halfW * 0.5} ${x2 + px * taperNarrow},${y2 + py * taperNarrow} `
			  + `L${x2 - px * taperNarrow},${y2 - py * taperNarrow} `
			  + `Q${midX - px * halfW * 0.5},${midY - py * halfW * 0.5} ${x1 - px * halfW},${y1 - py * halfW} Z`;
		}

		canvas.append('path')
			.attr('class', `matrix-connector matrix-connector-${groupId} matrix-label matrix-label-${groupId}`)
			.attr('data-group-id', groupId)
			.attr('data-orig-x', x1)
			.attr('data-orig-y', y1)
			.attr('d', d)
			.style('fill', color.stroke || color.label || '#3498db')
			.style('opacity', opacity)
			.style('pointer-events', 'none');
	}

