	function createAdditionalClone(originalId, x, y, isOrg, targetGroupId = null, isPerson = false) {
		let boardg = d3.select('#line-canvas');
		let leftOffset = document.getElementById('leftplace').offsetWidth;
		
		// Get original element
		let originalElement = document.getElementById(originalId);
		if (!originalElement) {
			console.error('Original element not found:', originalId);
			return;
		}
		
		let name = originalElement.getAttribute('data-name');
		let location = originalElement.getAttribute('data-location');
		let label = originalElement.getAttribute('label');
		let originalColor = d3.select(originalElement).style("fill");
		
		// Generate new clone ID
		let newCloneId = generateCloneId(originalId, isOrg);
		registerClone(originalId, newCloneId);
		
		let numericId = getNumericIdFromClone(newCloneId);
		let instanceMatch = newCloneId.match(/-(\d+)$/);
		let instanceSuffix = instanceMatch ? instanceMatch[0] : '';
		
		// Get original element position for elastic band
		let origRect = originalElement.getBoundingClientRect();
		let origX = origRect.x - leftOffset + (origRect.width / 2);
		let origY = origRect.y + (origRect.height / 2);
		
		if (isPerson) {
            // Create person clone (circle)
            let newClone = boardg.append("circle")
                .attr("cx", x)
                .attr("cy", y)
                .attr("r", 10)
                .attr("id", 'perpermanentclone' + numericId + instanceSuffix)
                .attr("data-name", name)
                .attr("label", label)
