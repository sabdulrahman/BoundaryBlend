				let groupSize = mapDragState.groupMembers.get(currentGroupId)?.size || 0;
				if (groupSize > 1) {
					menuHTML += `<li class="svg-menu-item-leavegroup-${safeCloneId} svg-menu-item">Leave Group</li>`;
