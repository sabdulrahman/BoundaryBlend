			if (vt === 'org') elements = sortOrgElementsBySourceOrder(elements);
			allViewElements.set(vt, elements);
		});

		if (viewTypesList.length < 2) {
			arrangeRadial(viewGroups, centerX, centerY);
			return;
		}

		let columnSpacing = viewTypesList.length === 2 ? 150 : 130;
		let rowSpacing = 35;
		let totalWidth = (viewTypesList.length - 1) * columnSpacing;
		let startColumnX = centerX - totalWidth / 2;

