			drawViewLabel(viewType.toUpperCase(), colX, labelY, groupId);

			let startY = centerY - ((elements.length - 1) * rowSpacing / 2);
			elements.forEach((element, rowIndex) => {
				let y = startY + (rowIndex * rowSpacing);
				animateCloneToPosition(element, colX, y);
			});
		});

		setTimeout(() => {
			drawBridgeConnectionsFromData(groupId);
			d3.selectAll(`.bridge-reorder-btn-${groupId}`).raise();

