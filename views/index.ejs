		// Ensure original has glow
		updateOriginalElementGlow(originalId);
		
		// Add to group
		if (targetGroupId) {
			assignGroupToClones([newCloneId], targetGroupId);
			
			let preferredArrangement = mapDragState.groupArrangements?.get(targetGroupId) || 'preserve';
			arrangeGroupVisually(targetGroupId, preferredArrangement);
			
			setTimeout(() => {
				updateGroupVisual(targetGroupId);
				showAllProximityBoundaries();
			}, 350);
		} else {
			let groupId = getOrCreateGroupId();
			assignGroupToClones([newCloneId], groupId);
			drawProximityBoundary(groupId, false);
		}
		
		console.log('Created additional clone:', newCloneId, 'for original:', originalId);
		
		reorderSVGElements();
