							<li class="svg-menu-item-arrange-grid-${safeCloneId}">Grid</li>
							<li class="svg-menu-item-arrange-circle-${safeCloneId}">Circle</li>
							<li class="svg-menu-item-arrange-bridge-${safeCloneId}">Bipartite</li>
							<li class="svg-menu-item-arrange-matrix-${safeCloneId}">Matrix</li>
							<li class="svg-menu-item-arrange-venn-${safeCloneId}">Venn Overlap</li>
							<li class="svg-menu-item-arrange-force-${safeCloneId}">Force-Directed</li>
