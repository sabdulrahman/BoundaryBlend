		var duprecords = [];
		function createdup(path){
			
				if(duprecords.includes(path.getAttribute('id')))
					return;
				
				duprecords.push(path.getAttribute('id'));
				
				for(var ii=0;ii<path.getTotalLength();ii++)
				{
					
