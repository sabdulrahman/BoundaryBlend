                .attr("x", x - 8)
                .attr("y", y - 8)
                .attr("width", 16)
                .attr("height", 16)
                .attr("id", 'orgpermanentclone' + numericId + instanceSuffix)
                .attr("data-name", name)
                .attr("label", label)
                .attr("clone-id", newCloneId)
                .attr("original-id", originalId)
                .attr("source-view", "org")
                .attr("class", "org-permanent-clone")
                .style("fill", originalColor)
                .style("stroke", "#4169e1")
                .style("stroke-width", "2px")
                .style("opacity", "1")
                .style("cursor", "move")
                .on("click", handleCloneClick)
                .call(d3.drag()
                    .on("start", cloneDragStart)
                    .on("drag", cloneDragMove)
                    .on("end", cloneDragEnd))
                .on("mouseover", cloneMouseOver)
                .on("mousemove", cloneMouseMove)
                .on("mouseout", cloneMouseOut)
                .on("contextmenu", handleCloneRightClick);

            boardg.append("line")
                .attr("id", 'elasticpermanentorg' + numericId + instanceSuffix)
                .attr("class", "elastic-band")
                .attr("data-clone-id", newCloneId)
                .attr("x1", origX)
                .attr("y1", origY)
                .attr("x2", x)
                .attr("y2", y)
                .style("opacity", "0.4");

            boardg.append("text")
                .attr("x", x)
                .attr("y", y - 12)
                .attr("id", 'orgclonetext' + numericId + instanceSuffix)
                .attr("data-clone-id", newCloneId)
                .attr("text-anchor", "middle")
                .style("fill", "white")
                .style("font-size", "10px")
                .style("font-weight", "bold")
                .style("pointer-events", "none")
                .style("text-shadow", "1px 1px 2px black")
                .text(name);
        } else {
            // Create map clone (circle)
            let newClone = boardg.append("circle")
                .attr("cx", x)
                .attr("cy", y)
                .attr("r", 10)
                .attr("id", 'mappermanentclone' + numericId + instanceSuffix)
                .attr("data-name", name)
                .attr("data-location", location)
                .attr("label", label)
                .attr("clone-id", newCloneId)
                .attr("original-id", originalId)
                .attr("source-view", "map")
                .attr("class", "map-permanent-clone")
                .style("fill", originalColor)
                .style("stroke", "#4169e1")
                .style("stroke-width", "2px")
                .style("opacity", "1")
                .style("cursor", "move")
                .on("click", handleCloneClick)
                .call(d3.drag()
                    .on("start", cloneDragStart)
                    .on("drag", cloneDragMove)
                    .on("end", cloneDragEnd))
                .on("mouseover", cloneMouseOver)
                .on("mousemove", cloneMouseMove)
                .on("mouseout", cloneMouseOut)
