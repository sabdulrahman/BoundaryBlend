	function organizeclick() {
    // Check for drag occurred
    if (orgDragState && orgDragState.dragOccurred) {
        orgDragState.dragOccurred = false;
        return;
    }

    if(window.getSelection) {
        let selection = window.getSelection();
      
        let $event = event;
        let ele = $event.target;      
        let orgname = event.target.getAttribute('orgname');
        let orgid = event.target.getAttribute('barid');
        
        // Handle CTRL+CLICK for multi-selection
        if ((event.ctrlKey || event.metaKey) && event.button === 0) {
            event.stopPropagation();
            
            if (!orgDragState) return;
            
            let isCloned = hasClone(orgid, true);
            
            if (orgDragState.selectedElements.has(orgid)) {
                // Deselect
                orgDragState.selectedElements.delete(orgid);
                
                if (isCloned) {
                    // Restore glow for cloned element
                    d3.select(ele)
                        .style('fill', '#6495ed')
                        .style('stroke', 'black')
                        .style('stroke-width', '0.3px')
                        .style("filter", "drop-shadow(0 0 4px orange) drop-shadow(0 0 8px orange)");
                } else {
                    d3.select(ele)
                        .style('fill', '#6495ed')
                        .style('stroke', 'black')
                        .style('stroke-width', '0.3px')
                        .style("filter", "none");
                }
            } else {
                // Select
                orgDragState.selectedElements.add(orgid);
                
                if (isCloned) {
                    // Selected + cloned
                    d3.select(ele)
                        .style('fill', '#ffa500')
                        .style('stroke', 'orange')
                        .style('stroke-width', '3px')
                        .style("filter", "drop-shadow(0 0 4px orange) drop-shadow(0 0 8px orange)");
                } else {
                    d3.select(ele)
                        .style('fill', '#ffa500')
