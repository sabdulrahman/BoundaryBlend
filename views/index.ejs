                        if(orgid == ClusterOMToOrg[jk].target.ele.id.slice(3)){
                            found=1;
                        }
                    }
                }
                
                // Check if this element has a clone in the new system
                let isCloned = hasClone(orgid, true);
                
                if(found==1){
                    d3.select(this).style("fill", "#ff7f50");
                    if(isCloned) {
                        d3.select(this).style("filter", "drop-shadow(0 0 4px orange) drop-shadow(0 0 8px orange)");
                    }
