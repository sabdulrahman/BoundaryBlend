				personDragState.currentTextLabel = boardg.append("text")
					.attr("x", canvasX)
					.attr("y", canvasY - 12)
					.attr("id", 'perclonetexttemp' + personsid)
					.attr("text-anchor", "middle")
					.style("fill", "white")
					.style("font-size", "10px")
					.style("font-weight", "bold")
					.style("pointer-events", "none")
					.style("text-shadow", "1px 1px 2px black")
					.text(name);

				personDragState.currentElasticBand = d3.select('#elasticpertemp' + personsid);
				personDragState.offsetX = canvasX - (d3.event.sourceEvent.clientX - leftOffset);
				personDragState.offsetY = canvasY - d3.event.sourceEvent.clientY;
			}
		}

		// --- Move clones during drag ---
		if (personDragState.isDragging) {
			let leftOffset = document.getElementById('leftplace').offsetWidth;

			if (personDragState.isMultiDrag) {
				personDragState.cloneGroup.forEach(item => {
					let canvasX = d3.event.sourceEvent.clientX - leftOffset + item.offsetX;
					let canvasY = d3.event.sourceEvent.clientY + item.offsetY;

					item.clone.attr("cx", canvasX).attr("cy", canvasY);

					let originalRect = item.originalElement.getBoundingClientRect();
					let origX = originalRect.x - leftOffset + (originalRect.width / 2);
					let origY = originalRect.y + (originalRect.height / 2);

					item.elasticBand
						.attr("x1", origX)
						.attr("y1", origY)
						.attr("x2", canvasX)
						.attr("y2", canvasY);

					item.textLabel
						.attr("x", canvasX)
						.attr("y", canvasY - 12);
				});

				// Check proximity
				if (personDragState.cloneGroup.length > 0) {
					let firstItem = personDragState.cloneGroup[0];
					let checkX = parseFloat(firstItem.clone.attr('cx'));
					let checkY = parseFloat(firstItem.clone.attr('cy'));
					let nearbyGroup = checkProximityToGroups(checkX, checkY, null);

					if (nearbyGroup !== mapDragState.currentProximityGroup) {
						if (mapDragState.currentProximityGroup) {
							drawProximityBoundary(mapDragState.currentProximityGroup, false);
						}
						if (nearbyGroup) {
							drawProximityBoundary(nearbyGroup, true);
						}
						mapDragState.currentProximityGroup = nearbyGroup;
					}
				}

			} else {
				let canvasX = d3.event.sourceEvent.clientX - leftOffset + personDragState.offsetX;
				let canvasY = d3.event.sourceEvent.clientY + personDragState.offsetY;

				personDragState.currentClone.attr("cx", canvasX).attr("cy", canvasY);

				let eleRect = ele.getBoundingClientRect();
				let origX = eleRect.x - leftOffset + (eleRect.width / 2);
				let origY = eleRect.y + (eleRect.height / 2);

				personDragState.currentElasticBand
					.attr("x1", origX)
					.attr("y1", origY)
					.attr("x2", canvasX)
					.attr("y2", canvasY);

				personDragState.currentTextLabel
					.attr("x", canvasX)
